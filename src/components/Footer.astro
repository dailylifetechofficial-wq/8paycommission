---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="footer-content">
    <div>
      <strong>8paycommission.com</strong>
      <span> — Independent compensation research and salary tools</span>
    </div>
    <nav aria-label="Footer navigation" class="footer-links">
      <a href="/">Home</a>
      <a href="/blog">Latest Updates</a>
      <a href="/about-us">About Us</a>
      <a href="/privacy-policy">Privacy Policy</a>
      <a href="/terms-of-use">Terms of Use</a>
      <a href="/contact-us">Contact Us</a>
    </nav>
  </div>
  <p class="disclaimer"><strong>Disclaimer:</strong> This is an independent informational website. Calculator values are estimates and are not official Government of India pay rules.</p>
  <p class="copyright">© {year} 8paycommission.com. All rights reserved.</p>
</footer>
<style>
  .site-footer { width: 100%; margin-top: auto; padding: 2.5rem 1.25rem 1.5rem; border-top: 1px solid #e2e8f0; background: #fff; color: #64748b; font-size: .88rem; }
  .footer-content, .disclaimer, .copyright { max-width: 1160px; margin-left: auto; margin-right: auto; }
  .footer-content { display: flex; align-items: center; justify-content: space-between; gap: 1.25rem; flex-wrap: wrap; }
  .footer-content strong { color: #0f172a; font-size: 1.05rem; }
  .footer-links { display: flex; gap: .9rem 1.25rem; flex-wrap: wrap; }
  .footer-links a { color: #475569; text-decoration: none; }
  .footer-links a:hover { color: #1d4ed8; }
  .disclaimer { margin-top: 1.75rem; margin-bottom: .75rem; padding: 1rem; border-left: 4px solid #94a3b8; border-radius: 6px; background: #f8fafc; font-size: .82rem; }
  .copyright { margin-top: 0; margin-bottom: 0; font-size: .78rem; }
  @media (max-width: 640px) { .footer-content { align-items: flex-start; flex-direction: column; } }
</style>
