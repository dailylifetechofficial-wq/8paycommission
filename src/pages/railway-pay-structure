  <!-- CLIENT-SIDE COMPUTATION JAVASCRIPT -->
  <script is:inline>
    const railPostSelect = document.getElementById('railPostSelect');
    const railBasicInput = document.getElementById('railBasicInput');
    const railFitmentSelect = document.getElementById('railFitmentSelect');
    const railKmRan = document.getElementById('railKmRan');
    const railNightHours = document.getElementById('railNightHours');

    const dispRailBasic = document.getElementById('dispRailBasic');
    const dispKma = document.getElementById('dispKma');
    const dispGrossRail = document.getElementById('dispGrossRail');
    const stickyGrossRail = document.getElementById('stickyGrossRail');

    const slipBasic = document.getElementById('slipBasic');
    const slipPayElement = document.getElementById('slipPayElement');
    const slipTotalBaseForAllow = document.getElementById('slipTotalBaseForAllow');
    const slipKmaVal = document.getElementById('slipKmaVal');
    const slipNdaVal = document.getElementById('slipNdaVal');
    const slipHra = document.getElementById('slipHra');
    const slipNha = document.getElementById('slipNha');
    const slipNetGross = document.getElementById('slipNetGross');
    const slipPostLabel = document.getElementById('slipPostLabel');

    function calculateRailwayPay() {
      const basic = parseFloat(railBasicInput.value) || 0;
      const fitment = parseFloat(railFitmentSelect.value) || 1.0;
      const kmRan = parseFloat(railKmRan.value) || 0;
      const nightHrs = parseFloat(railNightHours.value) || 0;

      const selectedOption = railPostSelect.options[railPostSelect.selectedIndex];
      const isRunning = selectedOption.getAttribute('data-running') === 'yes';

      // Arithmetic Engine
      const revisedBasic = Math.round(basic * fitment);

      // 30% Running Pay Element for Running Staff
      const payElement = isRunning ? Math.round(revisedBasic * 0.30) : 0;
      const totalBaseForAllow = revisedBasic + payElement;

      // KMA Calculation (Base rate ₹5.30 per km)
      const kmaAmount = isRunning ? Math.round(kmRan * 5.30) : 0;

      // Night Duty Allowance (Hourly Rate = [Basic Pay + 0% DA] / 200 under 8th CPC reset)
      const hourlyNda = totalBaseForAllow / 200;
      const ndaAmount = Math.round(hourlyNda * nightHrs);

      // HRA @ 20% (Tier-2 Town standard baseline on augmented base)
      const hraAmount = Math.round(totalBaseForAllow * 0.20);

      // National Holiday Allowance (Standard Level 6 baseline: ₹630)
      const nhaAmount = 630;

      const totalGross = revisedBasic + kmaAmount + ndaAmount + hraAmount + nhaAmount;

      // Update KPI Cards
      dispRailBasic.textContent = '₹' + revisedBasic.toLocaleString('en-IN');
      dispKma.textContent = '₹' + kmaAmount.toLocaleString('en-IN');
      dispGrossRail.textContent = '₹' + totalGross.toLocaleString('en-IN');
      if (stickyGrossRail) stickyGrossRail.textContent = '₹' + totalGross.toLocaleString('en-IN');

      // Update Breakdown Table
      slipBasic.textContent = '₹' + revisedBasic.toLocaleString('en-IN');
      slipPayElement.textContent = isRunning ? '₹' + payElement.toLocaleString('en-IN') : '₹0 (Stationary Staff)';
      slipTotalBaseForAllow.textContent = '₹' + totalBaseForAllow.toLocaleString('en-IN');
      slipKmaVal.textContent = '₹' + kmaAmount.toLocaleString('en-IN');
      slipNdaVal.textContent = '₹' + ndaAmount.toLocaleString('en-IN');
      slipHra.textContent = '₹' + hraAmount.toLocaleString('en-IN');
      slipNha.textContent = '₹' + nhaAmount.toLocaleString('en-IN');
      slipNetGross.textContent = '₹' + totalGross.toLocaleString('en-IN');

      // Update Subtitle Label
      const postName = selectedOption.text.split(' - ')[1].split(' (')[0];
      const levelCode = selectedOption.getAttribute('data-level') || 'Level';
      slipPostLabel.textContent = `${levelCode} • ${postName} • ${isRunning ? 'Running Staff' : 'Stationary Staff'}`;
    }

    // Input Listeners
    railBasicInput.addEventListener('input', calculateRailwayPay);
    railPostSelect.addEventListener('change', (e) => {
      railBasicInput.value = e.target.value;
      calculateRailwayPay();
    });
    railFitmentSelect.addEventListener('change', calculateRailwayPay);
    railKmRan.addEventListener('input', calculateRailwayPay);
    railNightHours.addEventListener('input', calculateRailwayPay);

    // Preset Chip Buttons
    const pills = document.querySelectorAll('#cadrePills .chip-btn');
    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        pills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        railBasicInput.value = pill.getAttribute('data-base');
        railKmRan.value = pill.getAttribute('data-kma');

        // Match dropdown value
        const targetBase = pill.getAttribute('data-base');
        for (let i = 0; i < railPostSelect.options.length; i++) {
          if (railPostSelect.options[i].value === targetBase) {
            railPostSelect.selectedIndex = i;
            break;
          }
        }
        calculateRailwayPay();
      });
    });

    // FAQ Accordion Toggle
    document.querySelectorAll('.faq-quest').forEach(q => {
      q.addEventListener('click', () => {
        q.parentElement.classList.toggle('open');
      });
    });

    // Initial Execution
    calculateRailwayPay();
  </script>

