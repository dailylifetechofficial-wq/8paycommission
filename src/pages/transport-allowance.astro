    </div>

  </main>

  <!-- STICKY MOBILE SUMMARY BAR -->
  <div class="mobile-sticky-bar">
    <div>
      <div class="lbl">Disbursed TA</div>
      <div class="val" id="stickyTotalTa">₹5,508</div>
    </div>
    <a href="#taCadreTier" class="chip-btn active" style="padding: 0.45rem 0.95rem; font-size: 0.82rem;">Recalculate</a>
  </div>

  <!-- CLIENT-SIDE COMPUTATION JAVASCRIPT -->
  <script is:inline>
    const taCadreTier = document.getElementById('taCadreTier');
    const taCityType = document.getElementById('taCityType');
    const taDaRate = document.getElementById('taDaRate');
    const taPhysicallyHandicapped = document.getElementById('taPhysicallyHandicapped');

    const dispBaseTa = document.getElementById('dispBaseTa');
    const dispDaOnTa = document.getElementById('dispDaOnTa');
    const dispTotalTa = document.getElementById('dispTotalTa');
    const stickyTotalTa = document.getElementById('stickyTotalTa');

    const slipBase = document.getElementById('slipBase');
    const slipDaPercent = document.getElementById('slipDaPercent');
    const slipDaVal = document.getElementById('slipDaVal');
    const slipMultiplier = document.getElementById('slipMultiplier');
    const slipNetTotal = document.getElementById('slipNetTotal');
    const slipLevelLabel = document.getElementById('slipLevelLabel');

    // Base TA matrix rates under 7th CPC guidelines
    const ratesMap = {
      high: { higher: 7200, other: 3600 },
      mid: { higher: 3600, other: 1800 },
      low: { higher: 1350, other: 900 }
    };

    function calculateTransportAllowance() {
      const tier = taCadreTier.value;
      const city = taCityType.value;
      const da = parseFloat(taDaRate.value) || 0;
      const isPwd = taPhysicallyHandicapped.value === 'pwd';

      let baseRate = ratesMap[tier][city];
      if (isPwd) {
        baseRate = Math.max(baseRate * 2, 2250 * 2);
      }

      const daComponent = Math.round(baseRate * (da / 100));
      const totalDisbursed = baseRate + daComponent;

      // Update KPI Cards
      dispBaseTa.textContent = '₹' + baseRate.toLocaleString('en-IN');
      dispDaOnTa.textContent = '₹' + daComponent.toLocaleString('en-IN');
      dispTotalTa.textContent = '₹' + totalDisbursed.toLocaleString('en-IN');
      if (stickyTotalTa) stickyTotalTa.textContent = '₹' + totalDisbursed.toLocaleString('en-IN');

      // Update Breakdown Table
      slipBase.textContent = '₹' + baseRate.toLocaleString('en-IN');
      slipDaPercent.textContent = da + '%';
      slipDaVal.textContent = '₹' + daComponent.toLocaleString('en-IN');
      slipMultiplier.textContent = isPwd ? '2.0x (PWD Concession)' : '1.0x (Standard)';
      slipNetTotal.textContent = '₹' + totalDisbursed.toLocaleString('en-IN');

      // Update Label
      const tierLabel = tier === 'high' ? 'Level 9 & Above' : tier === 'mid' ? 'Levels 3–8' : 'Levels 1 & 2';
      const cityLabel = city === 'higher' ? 'Higher TPTA City' : 'Other Location';
      slipLevelLabel.textContent = `${tierLabel} • ${cityLabel}`;
    }

    // Input Listeners
    taCadreTier.addEventListener('change', calculateTransportAllowance);
    taCityType.addEventListener('change', calculateTransportAllowance);
    taDaRate.addEventListener('input', calculateTransportAllowance);
    taPhysicallyHandicapped.addEventListener('change', calculateTransportAllowance);

    // Preset Chip Buttons
    const pills = document.querySelectorAll('#cadrePills .chip-btn');
    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        pills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        taCadreTier.value = pill.getAttribute('data-lvl');
        calculateTransportAllowance();
      });
    });

    // FAQ Accordion Toggle
    document.querySelectorAll('.faq-quest').forEach(q => {
      q.addEventListener('click', () => {
        q.parentElement.classList.toggle('open');
      });
    });

    // Initial Execution
    calculateTransportAllowance();
  </script>

</body>
</html>
