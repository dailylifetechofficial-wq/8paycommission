---
const siteUrl = "https://8paycommission.com";
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const pageTitle = "Transport Allowance (TA) & Travel Rules: 7th & 8th CPC";
const pageDescription = "Calculate Transport Allowance with DA and review Central Government travel entitlements.";
const higherTptaCities = ["Delhi (UA)", "Mumbai (UA)", "Kolkata (UA)", "Chennai (UA)", "Bengaluru (UA)", "Hyderabad (UA)", "Ahmedabad (UA)", "Pune (UA)", "Jaipur (UA)", "Lucknow (UA)", "Kanpur (UA)", "Nagpur (UA)", "Surat (UA)", "Patna (UA)", "Kochi (UA)", "Kozhikode (UA)", "Indore (UA)", "Coimbatore (UA)", "Ghaziabad (UA)"];
const ratesMap = { high: { higher: 7200, other: 3600 }, mid: { higher: 3600, other: 1800 }, low: { higher: 1350, other: 900 } };
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <link rel="canonical" href={canonicalURL} />
  <style>
    :root { font-family: system-ui, sans-serif; color: #0f172a; background: #f8fafc; }
    body { max-width: 960px; margin: 0 auto; padding: 2rem 1rem; }
    h1 { color: #1d4ed8; } main, section { background: white; border: 1px solid #e2e8f0; border-radius: 14px; padding: 1.5rem; margin: 1rem 0; }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 1rem; }
    label { display: grid; gap: .35rem; font-weight: 700; } select, input { padding: .7rem; border: 1px solid #cbd5e1; border-radius: 8px; font: inherit; }
    .result { font-size: 1.25rem; font-weight: 800; color: #15803d; } .tags { display: flex; flex-wrap: wrap; gap: .5rem; } .tag { background: #eff6ff; padding: .35rem .65rem; border-radius: 6px; }
  </style>
</head>
<body>
  <main>
    <h1>Transport Allowance (TA) &amp; Travel Rules</h1>
    <p>Calculate monthly Transport Allowance with Dearness Allowance and review travel entitlements under Central Government service rules.</p>
    <section aria-label="Transport Allowance calculator">
      <div class="grid">
        <label>Pay Matrix Level
          <select id="tier"><option value="high">Level 9 and above</option><option value="mid" selected>Levels 3 to 8</option><option value="low">Levels 1 and 2</option></select>
        </label>
        <label>Station category
          <select id="city"><option value="higher" selected>Higher TPTA city</option><option value="other">Other location</option></select>
        </label>
        <label>DA rate (%) <input id="da" type="number" value="53" min="0" max="150" /></label>
        <label>Disability concession
          <select id="pwd"><option value="no" selected>Standard rate</option><option value="yes">PWD / eligible disability (double rate)</option></select>
        </label>
      </div>
      <p>Base allowance: <strong id="base">₹3,600</strong></p>
      <p>DA on allowance: <strong id="daValue">₹1,908</strong></p>
      <p class="result">Total monthly allowance: <span id="total">₹5,508</span></p>
    </section>
  </main>
  <section>
    <h2>Higher TPTA Urban Agglomerations</h2>
    <div class="tags">{higherTptaCities.map((city) => <span class="tag">{city}</span>)}</div>
  </section>
  <section>
    <h2>Important PWD rule</h2>
    <p>Eligible employees receive double the normal Transport Allowance rate applicable to their level and city category, subject to the applicable statutory minimum.</p>
  </section>
  <script is:inline>
    const tier = document.querySelector('#tier');
    const city = document.querySelector('#city');
    const da = document.querySelector('#da');
    const pwd = document.querySelector('#pwd');
    const base = document.querySelector('#base');
    const daValue = document.querySelector('#daValue');
    const total = document.querySelector('#total');
    const money = (value) => '₹' + value.toLocaleString('en-IN');
    function calculate() {
      let rate = ratesMap[tier.value][city.value];
      if (pwd.value === 'yes') rate = Math.max(rate * 2, 4500);
      const daAmount = Math.round(rate * ((Number(da.value) || 0) / 100));
      base.textContent = money(rate);
      daValue.textContent = money(daAmount);
      total.textContent = money(rate + daAmount);
    }
    [tier, city, da, pwd].forEach((element) => element.addEventListener('input', calculate));
    calculate();
  </script>
</body>
</html>
