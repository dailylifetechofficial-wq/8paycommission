// src/pages/transport-allowance.astro
const siteUrl = "https://8paycommission.com";
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const pageTitle = "Transport Allowance (TA) & Travel Rules: 7th & 8th CPC Slabs & Tour Entitlements";
const pageDescription = "Calculate your monthly Transport Allowance (TA with DA) and tour travel entitlements. Explore Higher TPTA city classifications, train/air travel tiers, daily allowances, and CTG rules.";

// 19 Higher TPTA Urban Agglomerations under Central Service Rules
const higherTptaCities = [
  "Delhi (UA)", "Mumbai (UA)", "Kolkata (UA)", "Chennai (UA)", "Bengaluru (UA)",
  "Hyderabad (UA)", "Ahmedabad (UA)", "Pune (UA)", "Jaipur (UA)", "Lucknow (UA)",
  "Kanpur (UA)", "Nagpur (UA)", "Surat (UA)", "Patna (UA)", "Kochi (UA)",
  "Kozhikode (UA)", "Indore (UA)", "Coimbatore (UA)", "Ghaziabad (UA)"
];

// Travel Class Entitlements across Pay Matrix Levels
const travelEntitlements = [
  { levels: "Level 14 and Above", air: "Economy / Business Class (Discretionary)", train: "Executive Class / 1st AC", road: "AC Taxi / Premium Sedan", hotel: "Up to ₹7,500/day", food: "₹1,200/day" },
  { levels: "Level 12 to 13A", air: "Economy Class", train: "1st AC / Executive Class", road: "AC Taxi / Rideshare", hotel: "Up to ₹4,500/day", food: "₹1,000/day" },
  { levels: "Level 9 to 11", air: "Economy Class (Official sanction)", train: "2nd AC / Chair Car", road: "AC Taxi / Auto", hotel: "Up to ₹2,250/day", food: "₹900/day" },
  { levels: "Level 6 to 8", air: "Not Entitled (Train Primary)", train: "2nd AC / 3rd AC", road: "Prepaid Taxi / Auto Rickshaw", hotel: "Up to ₹750/day", food: "₹800/day" },
  { levels: "Level 5 and Below", air: "Not Entitled", train: "3rd AC / Sleeper Class", road: "Ordinary Bus / Shared Auto", hotel: "Up to ₹450/day", food: "₹500/day" }
];

const faqs = [
  {
    q: "How is monthly Transport Allowance (TA) calculated on the payslip?",
    a: "Transport Allowance is calculated using the formula: Total Disbursed TA = Base Transport Allowance + (Base Transport Allowance × Current DA %). The base rate depends on your Pay Matrix level and whether your station is classified as a Higher TPTA City or Other Location."
  },
  {
    q: "What happens to Transport Allowance when a new Pay Commission is implemented?",
    a: "When a new Pay Commission begins, base TA rates are recalibrated to reflect updated fuel and transit costs, while the DA on TA temporarily resets to 0%. Over time, as fresh semi-annual DA installments are notified, the allowance compounds on top of the revised baseline."
  },
  {
    q: "Are visually impaired or orthopedically handicapped employees entitled to higher TA?",
    a: "Yes. Under Central Civil Services regulations, employees with qualifying physical disabilities (including blindness, locomotor disability, and orthopedic handicaps) receive double the normal Transport Allowance rate, subject to a statutory minimum floor (₹2,250 + DA per month under the 7th CPC)."
  },
  {
    q: "What is the Composite Transfer Grant (CTG) and who is eligible?",
    a: "The Composite Transfer Grant is a lump-sum allowance paid to government servants upon transfer involving a change of station exceeding 20 kilometers. It is calculated at 80% of the last drawn Basic Pay (100% for transfers to/from island territories like Andaman & Nicobar and Lakshadweep)."
  },
  {
    q: "Is Transport Allowance (TA) taxable under Indian income tax laws?",
    a: "For regular central employees, monthly Transport Allowance is fully taxable as salary income. However, employees with qualifying disabilities are eligible for an income tax exemption of up to ₹3,200 per month under Section 10(14) of the Income Tax Act."
  }
];
