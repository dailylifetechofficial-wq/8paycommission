            </tr>
            <tr>
              <td>Applicable Dearness Allowance (DA) Rate</td>
              <td class="num" id="slipDaPercent">53%</td>
            </tr>
            <tr>
              <td>DA Component on Transport Allowance (Base TA × DA %)</td>
              <td class="num" id="slipDaVal">₹1,908</td>
            </tr>
