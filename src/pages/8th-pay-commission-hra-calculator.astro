  <!-- STICKY MOBILE SUMMARY BAR -->
  <div class="mobile-sticky-bar">
    <div>
      <div class="lbl">Projected 8th CPC HRA</div>
      <div class="val" id="stickyHra">₹30,373</div>
    </div>
    <a href="#hraBasicInput" class="chip-btn active" style="padding: 0.45rem 0.95rem; font-size: 0.82rem;">Recalculate</a>
  </div>

  <!-- CLIENT-SIDE COMPUTATION JAVASCRIPT -->
  <script is:inline>
    const hraBasicInput = document.getElementById('hraBasicInput');
    const hraLevelSelect = document.getElementById('hraLevelSelect');
    const hraFitmentSelect = document.getElementById('hraFitmentSelect');
    const hraCityTier = document.getElementById('hraCityTier');

    const dispHra7th = document.getElementById('dispHra7th');
    const dispHra8th = document.getElementById('dispHra8th');
    const dispHraDiff = document.getElementById('dispHraDiff');
    const stickyHra = document.getElementById('stickyHra');

    const slipNewBasic = document.getElementById('slipNewBasic');
    const slipHraRateLabel = document.getElementById('slipHraRateLabel');
    const slipRawHra = document.getElementById('slipRawHra');
    const slipFloorCap = document.getElementById('slipFloorCap');
    const slipFinalHra = document.getElementById('slipFinalHra');
    const slipOldHra = document.getElementById('slipOldHra');
    const slipNetHraGain = document.getElementById('slipNetHraGain');
    const slipLevelLabel = document.getElementById('slipLevelLabel');

    function calculateHRA() {
      const basic = parseFloat(hraBasicInput.value) || 0;
      const factor = parseFloat(hraFitmentSelect.value) || 2.86;
      const rate = parseFloat(hraCityTier.value) || 0.30;

      const selectedOption = hraCityTier.options[hraCityTier.selectedIndex];
      const minFloor = parseFloat(selectedOption.getAttribute('data-minfloor')) || 12150;

      // Arithmetic Engine
      const revisedBasic = Math.round(basic * factor);
      const rawHra8th = Math.round(revisedBasic * rate);
      const finalHra8th = Math.max(rawHra8th, minFloor);

      // 7th CPC baseline HRA at corresponding current restored rate
      const hra7th = Math.round(basic * rate);
      const hraDiff = finalHra8th - hra7th;

      // Update KPI Cards
      dispHra7th.textContent = '₹' + hra7th.toLocaleString('en-IN');
      dispHra8th.textContent = '₹' + finalHra8th.toLocaleString('en-IN');
      dispHraDiff.textContent = '+₹' + hraDiff.toLocaleString('en-IN');
      if (stickyHra) stickyHra.textContent = '₹' + finalHra8th.toLocaleString('en-IN');

      // Update Arithmetic Breakdown Slip
      slipNewBasic.textContent = '₹' + revisedBasic.toLocaleString('en-IN');
      slipHraRateLabel.textContent = `${Math.round(rate * 100)}% (${selectedOption.text.split(' - ')[0]})`;
      slipRawHra.textContent = '₹' + rawHra8th.toLocaleString('en-IN');
      slipFloorCap.textContent = '₹' + minFloor.toLocaleString('en-IN');
      slipFinalHra.textContent = '₹' + finalHra8th.toLocaleString('en-IN');
      slipOldHra.textContent = '₹' + hra7th.toLocaleString('en-IN');
      slipNetHraGain.textContent = '+₹' + hraDiff.toLocaleString('en-IN');

      // Update Subtitle Label
      const selectedLevel = hraLevelSelect.options[hraLevelSelect.selectedIndex];
      if (selectedLevel) {
        const levelName = selectedLevel.text.split(' (')[0];
        const tierName = selectedOption.text.split(' (')[0];
        slipLevelLabel.textContent = `${levelName} • ${tierName}`;
      }
    }

    // Input Listeners
    hraBasicInput.addEventListener('input', calculateHRA);
    hraFitmentSelect.addEventListener('change', calculateHRA);
    hraCityTier.addEventListener('change', calculateHRA);

    // Level Preset Picker
    hraLevelSelect.addEventListener('change', (e) => {
      hraBasicInput.value = e.target.value;
      calculateHRA();
    });

    // Multiplier Button Pills
    const pills = document.querySelectorAll('#factorPills .chip-btn');
    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        pills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        hraFitmentSelect.value = pill.getAttribute('data-f');
        calculateHRA();
      });
    });

    // FAQ Accordion
    document.querySelectorAll('.faq-quest').forEach(q => {
      q.addEventListener('click', () => {
        q.parentElement.classList.toggle('open');
      });
    });

    // Initial Execution
    calculateHRA();
  </script>

</body>
