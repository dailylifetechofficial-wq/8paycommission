  <!-- CLIENT-SIDE COMPUTATION JAVASCRIPT -->
  <script is:inline>
    const compBasicInput = document.getElementById('compBasicInput');
    const compLevelSelect = document.getElementById('compLevelSelect');
    const compFitmentSelect = document.getElementById('compFitmentSelect');
    const compCitySelect = document.getElementById('compCitySelect');

    const disp7thGross = document.getElementById('disp7thGross');
    const disp8thGross = document.getElementById('disp8thGross');
    const dispGrossDiff = document.getElementById('dispGrossDiff');
    const stickyGrossDiff = document.getElementById('stickyGrossDiff');

    const slip7thBasic = document.getElementById('slip7thBasic');
    const slip8thBasic = document.getElementById('slip8thBasic');
    const slip7thDa = document.getElementById('slip7thDa');
    const slip7thHra = document.getElementById('slip7thHra');
    const slip8thHra = document.getElementById('slip8thHra');
    const slip7thTa = document.getElementById('slip7thTa');
    const slip8thTa = document.getElementById('slip8thTa');
    const slip7thGross = document.getElementById('slip7thGross');
    const slip8thGross = document.getElementById('slip8thGross');
    const slip7thNps = document.getElementById('slip7thNps');
    const slip8thNps = document.getElementById('slip8thNps');
    const slip7thNet = document.getElementById('slip7thNet');
    const slip8thNet = document.getElementById('slip8thNet');
    const slipLevelLabel = document.getElementById('slipLevelLabel');

    function calculateComparison() {
      const basic7th = parseFloat(compBasicInput.value) || 0;
      const factor = parseFloat(compFitmentSelect.value) || 2.86;
      const hraRate = parseFloat(compCitySelect.value) || 0.30;

      // 7th CPC Arithmetic (53% DA, HRA, TA with DA loading)
      const da7th = Math.round(basic7th * 0.53);
      const hra7th = Math.round(basic7th * hraRate);
      const baseTa7th = basic7th >= 35400 ? 3600 : 1350;
      const ta7th = Math.round(baseTa7th * 1.53);
      const gross7th = basic7th + da7th + hra7th + ta7th;
      const nps7th = Math.round((basic7th + da7th) * 0.10);
      const net7th = gross7th - nps7th;

      // 8th CPC Arithmetic (0% initial DA, HRA on new basic, base TA)
      const basic8th = Math.round(basic7th * factor);
      const hra8th = Math.round(basic8th * hraRate);
      const ta8th = basic7th >= 35400 ? 3600 : 1350;
      const gross8th = basic8th + hra8th + ta8th;
      const nps8th = Math.round(basic8th * 0.10);
      const net8th = gross8th - nps8th;

      const grossDiff = gross8th - gross7th;

      // Update Formats
      disp7thGross.textContent = '₹' + gross7th.toLocaleString('en-IN');
      disp8thGross.textContent = '₹' + gross8th.toLocaleString('en-IN');
      dispGrossDiff.textContent = '+₹' + grossDiff.toLocaleString('en-IN');
      if (stickyGrossDiff) stickyGrossDiff.textContent = '+₹' + grossDiff.toLocaleString('en-IN');

      slip7thBasic.textContent = '₹' + basic7th.toLocaleString('en-IN');
      slip8thBasic.textContent = '₹' + basic8th.toLocaleString('en-IN');
      slip7thDa.textContent = '₹' + da7th.toLocaleString('en-IN');
      slip7thHra.textContent = '₹' + hra7th.toLocaleString('en-IN');
      slip8thHra.textContent = '₹' + hra8th.toLocaleString('en-IN');
      slip7thTa.textContent = '₹' + ta7th.toLocaleString('en-IN');
      slip8thTa.textContent = '₹' + ta8th.toLocaleString('en-IN');
      slip7thGross.textContent = '₹' + gross7th.toLocaleString('en-IN');
      slip8thGross.textContent = '₹' + gross8th.toLocaleString('en-IN');
      slip7thNps.textContent = '-₹' + nps7th.toLocaleString('en-IN');
      slip8thNps.textContent = '-₹' + nps8th.toLocaleString('en-IN');
      slip7thNet.textContent = '₹' + net7th.toLocaleString('en-IN');
      slip8thNet.textContent = '₹' + net8th.toLocaleString('en-IN');

      // Update Level Subtitle Label
      const selectedOption = compLevelSelect.options[compLevelSelect.selectedIndex];
      if (selectedOption) {
        const lvlName = selectedOption.getAttribute('data-level') || 'Level 6';
        const gpName = selectedOption.getAttribute('data-gp') || 'GP 4200';
        slipLevelLabel.textContent = `${lvlName} (${gpName})`;
      }
    }

    // Input Listeners
    compBasicInput.addEventListener('input', calculateComparison);
    compLevelSelect.addEventListener('change', (e) => {
      compBasicInput.value = e.target.value;
      calculateComparison();
    });
    compFitmentSelect.addEventListener('change', calculateComparison);
    compCitySelect.addEventListener('change', calculateComparison);

    // Multiplier Button Pills
    const pills = document.querySelectorAll('#factorPills .chip-btn');
    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        pills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        compFitmentSelect.value = pill.getAttribute('data-f');
        calculateComparison();
      });
    });

    // Quick Matrix Level Pills
    document.querySelectorAll('.level-pill').forEach(pill => {
      pill.addEventListener('click', () => {
        const val = pill.getAttribute('data-base7th');
        compBasicInput.value = val;
        compLevelSelect.value = val;
        calculateComparison();
        document.querySelector('.calc-box').scrollIntoView({ behavior: 'smooth' });
      });
    });

    // FAQ Accordion Toggle
    document.querySelectorAll('.faq-quest').forEach(q => {
      q.addEventListener('click', () => {
        q.parentElement.classList.toggle('open');
      });
    });

    // Initial Execution
    calculateComparison();
  </script>

