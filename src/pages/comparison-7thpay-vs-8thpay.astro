---
// src/pages/comparison-7thpay-vs-8thpay.astro
const siteUrl = "https://8paycommission.com";
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const pageTitle = "7th vs 8th Pay Commission Comparison: Salary Hike, Matrix & Policy Shifts";
const pageDescription = "Compare the 7th vs 8th Central Pay Commission: detailed side-by-side analysis of fitment factors, Level 1 to 18 pay matrices, in-hand salary increases, and UPS pensions.";

// Complete Level 1 to 18 Comparative Grid Data
const comparisonData = [
  { level: "Level 1", gp: "GP 1800", post: "MTS, Group D, Trackman", base7th: 18000, base8th_225: 40500, base8th_286: 51480 },
  { level: "Level 2", gp: "GP 1900", post: "LDC, Junior Clerk", base7th: 19900, base8th_225: 44775, base8th_286: 56914 },
  { level: "Level 3", gp: "GP 2000", post: "Constable, Senior Clerk, Driver", base7th: 21700, base8th_225: 48825, base8th_286: 62062 },
  { level: "Level 4", gp: "GP 2400", post: "UDC, Head Constable, Tax Asst", base7th: 25500, base8th_225: 57375, base8th_286: 72930 },
  { level: "Level 5", gp: "GP 2800", post: "Auditor, Accountant, ASI", base7th: 29200, base8th_225: 65700, base8th_286: 83512 },
  { level: "Level 6", gp: "GP 4200", post: "Sub-Inspector, Primary Teacher, JE", base7th: 35400, base8th_225: 79650, base8th_286: 101244 },
  { level: "Level 7", gp: "GP 4600", post: "ASO, Section Engineer, Inspector", base7th: 44900, base8th_225: 101025, base8th_286: 128414 },
  { level: "Level 8", gp: "GP 4800", post: "AAO, Section Officer", base7th: 47600, base8th_225: 107100, base8th_286: 136136 },
  { level: "Level 9", gp: "GP 5400", post: "Senior Section Officer", base7th: 53100, base8th_225: 119475, base8th_286: 151866 },
  { level: "Level 10", gp: "GP 5400", post: "Group A Entry, SDM, DSP, Capt", base7th: 56100, base8th_225: 126225, base8th_286: 160446 },
  { level: "Level 11", gp: "GP 6600", post: "Under Secretary, Executive Eng", base7th: 67700, base8th_225: 152325, base8th_286: 193622 },
  { level: "Level 12", gp: "GP 7600", post: "Deputy Secretary, Lt Colonel", base7th: 78800, base8th_225: 177300, base8th_286: 225368 },
  { level: "Level 13", gp: "GP 8700", post: "Director, Chief Engineer, Colonel", base7th: 123100, base8th_225: 276975, base8th_286: 352066 },
  { level: "Level 13A", gp: "GP 8900", post: "Senior Director, DIG Selection", base7th: 139600, base8th_225: 314100, base8th_286: 399256 },
  { level: "Level 14", gp: "GP 10000", post: "Joint Secretary, IG Police, Brigadier", base7th: 144200, base8th_225: 324450, base8th_286: 412412 },
  { level: "Level 15", gp: "HAG", post: "Principal Secretary, Major General", base7th: 182200, base8th_225: 409950, base8th_286: 521092 },
  { level: "Level 16", gp: "HAG+", post: "Special Secretary, Director General", base7th: 205400, base8th_225: 462150, base8th_286: 587444 },
  { level: "Level 17", gp: "Apex Scale", post: "Secretary to Government of India", base7th: 225000, base8th_225: 506250, base8th_286: 643500 },
  { level: "Level 18", gp: "Cabinet Sec", post: "Cabinet Secretary of India", base7th: 250000, base8th_225: 562500, base8th_286: 715000 }
];

const faqs = [
  {
    q: "What is the primary difference between the 7th and 8th Pay Commissions?",
    a: "The 7th CPC replaced the older Grade Pay bands with a structured 18-level Pay Matrix and scaled the minimum basic wage to ₹18,000 using a 2.57x fitment multiplier. The 8th CPC preserves this matrix architecture while absorbing accumulated 50%+ Dearness Allowance into an expanded basic pay floor (projected between ₹40,500 and ₹51,480) and resetting the DA counter to 0%."
  },
  {
    q: "Why does take-home pay not multiply by 2.86x if the fitment factor is 2.86x?",
    a: "The fitment factor applies strictly to Basic Pay, not to gross or net take-home salary. Because accumulated Dearness Allowance (which accounts for over 50% of 7th CPC basic pay) is merged into the base, the new DA rate drops to 0% at rollout. The net salary hike reflects real wage expansion rather than a triple multiplication of the payslip."
  },
  {
    q: "How does the Unified Pension Scheme (UPS) change pension outcomes in the 8th CPC?",
    a: "Under the 7th CPC, employees joining after January 1, 2004, were covered exclusively under the market-linked NPS. Ahead of the 8th CPC, the Unified Pension Scheme (UPS) guarantees an assured lifelong pension equal to 50% of the average basic pay drawn during the last 12 months of qualifying service. A higher 8th CPC basic salary directly boosts assured lifetime pension payouts."
  },
  {
    q: "What is the key policy debate regarding the commuted pension restoration period?",
    a: "Under the 7th CPC, commuted pension is recovered for 15 years. Pensioner confederations have demanded this timeline be reduced to 12 years for the 8th CPC, citing actuarial evidence that the commuted advance along with interest is completely recovered within 11 to 12 years under prevailing interest rates."
  }
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <meta name="keywords" content="7th vs 8th pay commission, 7th vs 8th cpc salary comparison, fitment factor comparison, pay matrix level 1 to 18, ups vs nps pension hike, hra revision x y z" />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:locale" content="en_IN" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="8th Pay Commission Portal" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Schema.org WebPage + FAQPage -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebPage",
        "name": pageTitle,
        "url": canonicalURL.toString(),
        "description": pageDescription,
        "inLanguage": "en-IN"
      },
      {
        "@type": "FAQPage",
        "mainEntity": faqs.map((f) => ({
          "@type": "Question",
          "name": f.q,
          "acceptedAnswer": { "@type": "Answer", "text": f.a }
        }))
      }
    ]
  })} />

  <style>
    :root {
      --bg: #f8fafc;
      --surface: #ffffff;
      --surface-subtle: #f1f5f9;
      --border: #e2e8f0;
      --primary: #1d4ed8;
      --primary-hover: #1e40af;
      --primary-gradient: linear-gradient(135deg, #1d4ed8 0%, #0284c7 100%);
      --text: #0f172a;
      --text-muted: #64748b;
      --accent-green: #15803d;
      --accent-green-bg: #dcfce7;
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.05);
      --shadow-md: 0 4px 12px -2px rgba(15, 23, 42, 0.08);
      --shadow-lg: 0 16px 32px -4px rgba(15, 23, 42, 0.08);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; }
    body { background: var(--bg); color: var(--text); line-height: 1.7; font-size: 15px; -webkit-font-smoothing: antialiased; }
    a { color: var(--primary); text-decoration: none; transition: color 0.2s ease; }
    a:hover { color: var(--primary-hover); }

    .layout-wrap { max-width: 1160px; margin: 0 auto; padding: 0 1.25rem; }

    /* Hero Header */
    .hero-header {
      text-align: center;
      padding: 3rem 1rem 1.75rem;
    }
    .badge-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: #eff6ff;
      border: 1px solid #bfdbfe;
      color: #1d4ed8;
      padding: 0.25rem 0.85rem;
      border-radius: 30px;
      font-size: 0.78rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.85rem;
    }
    .hero-header h1 {
      font-size: clamp(1.85rem, 4vw, 2.75rem);
      font-weight: 800;
      letter-spacing: -0.035em;
      line-height: 1.22;
      margin-bottom: 0.75rem;
      color: var(--text);
    }
    .hero-header p {
      color: var(--text-muted);
      max-width: 780px;
      margin: 0 auto;
      font-size: 1.05rem;
    }

    /* Interactive Comparison Widget */
    .calc-box {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 2rem;
      box-shadow: var(--shadow-lg);
      margin-bottom: 3.5rem;
    }
    .chip-bar {
      display: flex;
      gap: 0.5rem;
      overflow-x: auto;
      padding: 0.5rem 0 1.25rem;
      scrollbar-width: none;
    }
    .chip-bar::-webkit-scrollbar { display: none; }
    .chip-btn {
      background: #f1f5f9;
      border: 1px solid var(--border);
      color: #475569;
      padding: 0.5rem 1.1rem;
      border-radius: 30px;
      font-size: 0.84rem;
      font-weight: 700;
      white-space: nowrap;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .chip-btn:hover { background: #e2e8f0; }
    .chip-btn.active {
      background: var(--primary);
      border-color: var(--primary);
      color: #ffffff;
      box-shadow: 0 2px 8px rgba(29, 78, 216, 0.3);
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1.25rem;
      margin-bottom: 1.5rem;
    }
    .form-item {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
    .form-item label {
      font-size: 0.82rem;
      font-weight: 700;
      color: #334155;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }
    .form-item input, .form-item select {
      background: #ffffff;
      border: 1.5px solid #cbd5e1;
      color: var(--text);
      padding: 0.75rem 0.9rem;
      border-radius: var(--radius-sm);
      font-size: 0.96rem;
      font-weight: 600;
      outline: none;
      transition: all 0.2s;
    }
    .form-item input:focus, .form-item select:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
    }

    /* Live Summary Cards */
    .summary-cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      margin-bottom: 1.5rem;
    }
    .kpi-unit {
      background: #f8fafc;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 1.25rem;
      text-align: center;
      position: relative;
    }
    .kpi-unit.highlight {
      background: #eff6ff;
      border-color: #bfdbfe;
    }
    .kpi-unit.success {
      background: var(--accent-green-bg);
      border-color: #86efac;
    }
    .kpi-unit .kpi-label {
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
      margin-bottom: 0.35rem;
    }
    .kpi-unit .kpi-val {
      font-size: 1.45rem;
      font-weight: 800;
      color: var(--text);
    }
    .kpi-unit.highlight .kpi-val { color: var(--primary); }
    .kpi-unit.success .kpi-val { color: var(--accent-green); }

    /* Breakdown Box */
    .breakdown-box {
      background: #f8fafc;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 1.5rem;
      margin-top: 1.5rem;
    }
    .breakdown-title {
      font-weight: 800;
      font-size: 1rem;
      color: var(--text);
      margin-bottom: 0.85rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .breakdown-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.94rem;
    }
    .breakdown-table td {
      padding: 0.65rem 0.5rem;
      border-bottom: 1px dashed #cbd5e1;
    }
    .breakdown-table tr:last-child td { border-bottom: none; }
    .breakdown-table td.num {
      text-align: right;
      font-weight: 700;
    }

    /* Content Area */
    .article-wrap {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 2.75rem;
      box-shadow: var(--shadow-sm);
      margin-bottom: 3.5rem;
    }
    .article-wrap h2 {
      font-size: 1.6rem;
      font-weight: 800;
      color: var(--text);
      letter-spacing: -0.025em;
      margin: 2.5rem 0 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 2px solid #eff6ff;
    }
    .article-wrap h3 {
      font-size: 1.25rem;
      font-weight: 700;
      color: #1e293b;
      margin: 1.6rem 0 0.65rem;
    }
    .article-wrap p {
      margin-bottom: 1.25rem;
      color: #334155;
      font-size: 1.02rem;
    }
    .article-wrap ul, .article-wrap ol {
      margin-bottom: 1.5rem;
      padding-left: 1.5rem;
      color: #334155;
    }
    .article-wrap li { margin-bottom: 0.45rem; }

    .formula-banner {
      background: #eff6ff;
      border-left: 4px solid var(--primary);
      padding: 1.15rem 1.35rem;
      border-radius: 0 8px 8px 0;
      margin: 1.5rem 0;
      font-family: monospace;
      font-size: 0.96rem;
      color: #1e40af;
    }

    /* Table */
    .table-responsive {
      overflow-x: auto;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      margin: 1.5rem 0;
    }
    table.data-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 0.91rem;
    }
    table.data-table th, table.data-table td {
      padding: 0.8rem 0.95rem;
      border-bottom: 1px solid var(--border);
    }
    table.data-table th {
      background: #f8fafc;
      color: #475569;
      font-weight: 700;
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      white-space: nowrap;
    }
    table.data-table tr:hover td { background: #f8fafc; }

    /* Level Badges Grid */
    .level-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
      gap: 0.65rem;
      margin: 1.25rem 0;
    }
    .level-pill {
      background: #ffffff;
      border: 1px solid var(--border);
      padding: 0.75rem 0.5rem;
      border-radius: var(--radius-sm);
      text-align: center;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .level-pill:hover {
      border-color: var(--primary);
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
      background: #eff6ff;
    }
    .level-pill strong { display: block; font-size: 0.95rem; color: var(--text); }
    .level-pill span { font-size: 0.78rem; color: var(--text-muted); }

    /* FAQ */
    .faq-unit {
      border-bottom: 1px solid var(--border);
      padding: 1.15rem 0;
    }
    .faq-quest {
      font-weight: 700;
      color: var(--text);
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 1.02rem;
    }
    .faq-ans {
      display: none;
      padding-top: 0.65rem;
      color: #475569;
      font-size: 0.96rem;
      line-height: 1.7;
    }
    .faq-unit.open .faq-ans { display: block; }
    .faq-unit.open .faq-arrow { transform: rotate(180deg); }
    .faq-arrow { transition: transform 0.2s ease; font-size: 0.75rem; color: var(--text-muted); }

    /* Mobile Sticky Bar */
    .mobile-sticky-bar {
      display: none;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: rgba(255, 255, 255, 0.96);
      border-top: 1px solid var(--border);
      backdrop-filter: blur(12px);
      padding: 0.75rem 1.25rem;
      z-index: 990;
      justify-content: space-between;
      align-items: center;
      box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.06);
    }
    .mobile-sticky-bar .lbl { font-size: 0.74rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700; }
    .mobile-sticky-bar .val { font-size: 1.2rem; font-weight: 800; color: var(--accent-green); }
    @media (max-width: 768px) {
      .mobile-sticky-bar { display: flex; }
      body { padding-bottom: 4.5rem; }
    }

    /* Disclaimer */
    .disclaimer-strip {
      max-width: 1160px;
      margin: 2rem auto 4rem;
      padding: 1.25rem;
      background: #f8fafc;
      border: 1px solid var(--border);
      border-left: 4px solid #94a3b8;
      border-radius: var(--radius-sm);
      font-size: 0.82rem;
      line-height: 1.6;
      color: #64748b;
    }
  </style>
</head>
<body>

  <main class="layout-wrap">

    <!-- HERO HEADER -->
    <header class="hero-header">
      <div class="badge-pill">Public Remuneration Comparative Analysis</div>
      <h1>7th Pay vs 8th Pay Commission Comparison</h1>
      <p>Detailed structural breakdown of fitment factor variations, Level 1 to 18 salary matrix transitions, in-hand monthly hike modeling, and retirement pension mechanisms.</p>
    </header>

    <!-- INTERACTIVE 7TH VS 8TH COMPARISON SIMULATOR -->
    <section class="calc-box" aria-label="7th vs 8th CPC Interactive Comparison Widget">
      
      <!-- Multiplier Pills -->
      <div style="margin-bottom: 1.25rem;">
        <span style="font-size: 0.8rem; font-weight: 700; color: #64748b; text-transform: uppercase;">Projected 8th CPC Fitment Factor:</span>
        <div class="chip-bar" id="factorPills">
          <button class="chip-btn" data-f="1.92">1.92x (Conservative Baseline)</button>
          <button class="chip-btn" data-f="2.25">2.25x (Consensus Model)</button>
          <button class="chip-btn" data-f="2.57">2.57x (7th CPC Parity)</button>
          <button class="chip-btn active" data-f="2.86">2.86x (Federation Target)</button>
        </div>
      </div>

      <!-- Controls Grid -->
      <div class="form-grid">
        <div class="form-item">
          <label for="compLevelSelect">Pay Matrix Level (Preset)</label>
          <select id="compLevelSelect">
            {comparisonData.map((row) => (
              <option value={row.base7th} data-level={row.level} data-gp={row.gp} selected={row.level === "Level 6"}>
                {row.level} ({row.gp}) - Min 7th: ₹{row.base7th.toLocaleString('en-IN')}
              </option>
            ))}
          </select>
        </div>

        <div class="form-item">
          <label for="compBasicInput">Current 7th CPC Basic (₹)</label>
          <input type="number" id="compBasicInput" value="35400" min="18000" step="100" />
        </div>

        <div class="form-item">
          <label for="compFitmentSelect">Fitment Multiplier</label>
          <select id="compFitmentSelect">
            <option value="1.92">1.92x (Conservative DA Merge)</option>
            <option value="2.10">2.10x (Moderate Growth)</option>
            <option value="2.25">2.25x (Consensus Baseline)</option>
            <option value="2.57">2.57x (Equivalent to 7th CPC)</option>
            <option value="2.86" selected>2.86x (Federation Target)</option>
            <option value="3.00">3.00x (High Wage Benchmark)</option>
          </select>
        </div>

        <div class="form-item">
          <label for="compCitySelect">City Tier (HRA Rate)</label>
          <select id="compCitySelect">
            <option value="0.30" selected>Class X (30% - Metro Cities)</option>
            <option value="0.20">Class Y (20% - Tier-2 Centers)</option>
            <option value="0.10">Class Z (10% - Small Towns/Rural)</option>
          </select>
        </div>
      </div>

      <!-- Live Summary KPI Cards -->
      <div class="summary-cards">
        <div class="kpi-unit">
          <div class="kpi-label">7th CPC Gross Pay (With 53% DA)</div>
          <div class="kpi-val" id="disp7thGross">₹70,290</div>
        </div>
        <div class="kpi-unit highlight">
          <div class="kpi-label">Projected 8th CPC Gross Pay</div>
          <div class="kpi-val" id="disp8thGross">₹1,35,217</div>
        </div>
        <div class="kpi-unit success">
          <div class="kpi-label">Estimated Monthly Gross Hike</div>
          <div class="kpi-val" id="dispGrossDiff">+₹64,927</div>
        </div>
      </div>

      <!-- Live Side-by-Side Payslip Breakdown -->
      <div class="breakdown-box">
        <div class="breakdown-title">
          <span>Side-by-Side Monthly Salary Comparison</span>
          <span style="color: var(--primary); font-size: 0.85rem;" id="slipLevelLabel">Level 6 (GP 4200)</span>
        </div>
        <table class="breakdown-table">
          <thead>
            <tr style="font-weight: 700; color: #475569; font-size: 0.84rem;">
              <td>Component</td>
              <td class="num" style="text-align: right;">7th CPC Status (~53% DA)</td>
              <td class="num" style="text-align: right;">Projected 8th CPC (0% DA)</td>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Basic Pay Baseline</td>
              <td class="num" id="slip7thBasic">₹35,400</td>
              <td class="num" id="slip8thBasic" style="color: var(--primary);">₹1,01,244</td>
            </tr>
            <tr>
              <td>Dearness Allowance (DA)</td>
              <td class="num" id="slip7thDa">₹18,762</td>
              <td class="num" style="color: var(--text-muted);">₹0 (Reset)</td>
            </tr>
            <tr>
              <td>House Rent Allowance (HRA)</td>
              <td class="num" id="slip7thHra">₹10,620</td>
              <td class="num" id="slip8thHra">₹30,373</td>
            </tr>
            <tr>
              <td>Transport Allowance (TA)</td>
              <td class="num" id="slip7thTa">₹5,508</td>
              <td class="num" id="slip8thTa">₹3,600</td>
            </tr>
            <tr style="font-weight: 700; background: #f8fafc;">
              <td>Estimated Monthly Gross</td>
              <td class="num" id="slip7thGross">₹70,290</td>
              <td class="num" id="slip8thGross" style="color: var(--primary);">₹1,35,217</td>
            </tr>
            <tr>
