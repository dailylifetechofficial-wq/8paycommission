  <!-- CLIENT-SIDE COMPUTATION JAVASCRIPT -->
  <script is:inline>
    const defRankSelect = document.getElementById('defRankSelect');
    const defBasicInput = document.getElementById('defBasicInput');
    const defFitmentSelect = document.getElementById('defFitmentSelect');
    const defPostingArea = document.getElementById('defPostingArea');

    const dispDefBasic = document.getElementById('dispDefBasic');
    const dispMsp = document.getElementById('dispMsp');
    const dispGrossTotal = document.getElementById('dispGrossTotal');
    const stickyGrossTotal = document.getElementById('stickyGrossTotal');

    const slipRankBasic = document.getElementById('slipRankBasic');
    const slipMspVal = document.getElementById('slipMspVal');
    const slipCombinedBase = document.getElementById('slipCombinedBase');
    const slipFieldAllow = document.getElementById('slipFieldAllow');
    const slipTa = document.getElementById('slipTa');
    const slipFinalGross = document.getElementById('slipFinalGross');
    const slipRankLabel = document.getElementById('slipRankLabel');

    function calculateDefencePay() {
      const basic = parseFloat(defBasicInput.value) || 0;
      const fitment = parseFloat(defFitmentSelect.value) || 1.0;
      const fieldAllowance = parseFloat(defPostingArea.value) || 0;

      const selectedRank = defRankSelect.options[defRankSelect.selectedIndex];
      const rawMsp = parseFloat(selectedRank.getAttribute('data-msp')) || 0;

      // Arithmetic Engine
      const revisedBasic = Math.round(basic * fitment);
      const revisedMsp = fitment > 1.0 ? Math.round(rawMsp * fitment) : rawMsp;
      const combinedBase = revisedBasic + revisedMsp;

      // Transport Allowance Baseline (Officers: ₹7,200 / JCOs & ORs: ₹3,600)
      const isOfficer = rawMsp >= 15500;
      const baseTa = isOfficer ? 7200 : 3600;

      const grossEarnings = combinedBase + fieldAllowance + baseTa;

      // Update KPI Cards
      dispDefBasic.textContent = '₹' + revisedBasic.toLocaleString('en-IN');
      dispMsp.textContent = '₹' + revisedMsp.toLocaleString('en-IN');
      dispGrossTotal.textContent = '₹' + combinedBase.toLocaleString('en-IN');
      if (stickyGrossTotal) stickyGrossTotal.textContent = '₹' + combinedBase.toLocaleString('en-IN');

      // Update Breakdown Table
      slipRankBasic.textContent = '₹' + revisedBasic.toLocaleString('en-IN');
      slipMspVal.textContent = '₹' + revisedMsp.toLocaleString('en-IN');
      slipCombinedBase.textContent = '₹' + combinedBase.toLocaleString('en-IN');
      slipFieldAllow.textContent = '₹' + fieldAllowance.toLocaleString('en-IN');
      slipTa.textContent = '₹' + baseTa.toLocaleString('en-IN');
      slipFinalGross.textContent = '₹' + grossEarnings.toLocaleString('en-IN');

      // Update Label
      const armyRank = selectedRank.getAttribute('data-army') || 'Rank';
      const levelCode = selectedRank.getAttribute('data-level') || 'Level';
      slipRankLabel.textContent = `${levelCode} • ${armyRank} • ${fitment > 1.0 ? fitment + 'x Scale' : '7th CPC'}`;
    }

    // Input Listeners
    defBasicInput.addEventListener('input', calculateDefencePay);
    defRankSelect.addEventListener('change', (e) => {
      defBasicInput.value = e.target.value;
      calculateDefencePay();
    });
    defFitmentSelect.addEventListener('change', calculateDefencePay);
    defPostingArea.addEventListener('change', calculateDefencePay);

    // Preset Rank Chip Buttons
    const pills = document.querySelectorAll('#rankPills .chip-btn');
    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        pills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        defBasicInput.value = pill.getAttribute('data-base');

        // Match dropdown value
        const targetBase = pill.getAttribute('data-base');
        for (let i = 0; i < defRankSelect.options.length; i++) {
          if (defRankSelect.options[i].value === targetBase) {
            defRankSelect.selectedIndex = i;
            break;
          }
        }
        calculateDefencePay();
      });
    });

    // FAQ Accordion Toggle
    document.querySelectorAll('.faq-quest').forEach(q => {
      q.addEventListener('click', () => {
        q.parentElement.classList.toggle('open');
      });
    });

    // Initial Execution
    calculateDefencePay();
  </script>

