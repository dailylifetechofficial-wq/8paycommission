---
// src/pages/defence-pay-scale.astro
const siteUrl = "https://8paycommission.com";
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const pageTitle = "Defence Pay Scale & Matrix: 7th & 8th CPC Armed Forces Pay, MSP & Ranks";
const pageDescription = "Explore the complete Defence Pay Matrix for Indian Army, Navy, and Air Force. Calculate revised basic pay, Military Service Pay (MSP), field allowances, and pension entitlements across Levels 3 to 18.";

// Tri-Service Defence Pay Matrix Benchmark Data (Levels 3 to 18)
const defenceRanks = [
  { level: "Level 3", army: "Sepoy", navy: "Seaman II / I", af: "Aircraftsman / Leading AC", base7th: 21700, msp: 5200, base8th_225: 48825, base8th_286: 62062 },
  { level: "Level 4", army: "Naik", navy: "Leading Seaman", af: "Corporal", base7th: 25500, msp: 5200, base8th_225: 57375, base8th_286: 72930 },
  { level: "Level 5", army: "Havildar", navy: "Petty Officer", af: "Sergeant", base7th: 29200, msp: 5200, base8th_225: 65700, base8th_286: 83512 },
  { level: "Level 5A", army: "Naib Subedar (TS)", navy: "—", af: "—", base7th: 31000, msp: 5200, base8th_225: 69750, base8th_286: 88660 },
  { level: "Level 6", army: "Naib Subedar", navy: "Sub Lieutenant (SLt Non-Functional)", af: "Junior Warrant Officer (JWO)", base7th: 35400, msp: 5200, base8th_225: 79650, base8th_286: 101244 },
  { level: "Level 7", army: "Subedar", navy: "Master Chief Petty Officer II", af: "Warrant Officer (WO)", base7th: 44900, msp: 5200, base8th_225: 101025, base8th_286: 128414 },
  { level: "Level 8", army: "Subedar Major", navy: "Master Chief Petty Officer I", af: "Master Warrant Officer (MWO)", base7th: 47600, msp: 5200, base8th_225: 107100, base8th_286: 136136 },
  { level: "Level 8A", army: "Subedar Major (Senior Group)", navy: "MCPO I (Special)", af: "MWO (Senior)", base7th: 50700, msp: 5200, base8th_225: 114075, base8th_286: 145002 },
  { level: "Level 10", army: "Lieutenant", navy: "Sub Lieutenant", af: "Flying Officer", base7th: 56100, msp: 15500, base8th_225: 126225, base8th_286: 160446 },
  { level: "Level 10B", army: "Captain", navy: "Lieutenant", af: "Flight Lieutenant", base7th: 61300, msp: 15500, base8th_225: 137925, base8th_286: 175318 },
  { level: "Level 11", army: "Major", navy: "Lt Commander", af: "Squadron Leader", base7th: 69400, msp: 15500, base8th_225: 156150, base8th_286: 198484 },
  { level: "Level 12A", army: "Lieutenant Colonel", navy: "Commander", af: "Wing Commander", base7th: 121200, msp: 15500, base8th_225: 272700, base8th_286: 346632 },
  { level: "Level 13", army: "Colonel", navy: "Captain", af: "Group Captain", base7th: 130600, msp: 15500, base8th_225: 293850, base8th_286: 373516 },
  { level: "Level 13A", army: "Brigadier", navy: "Commodore", af: "Air Commodore", base7th: 139600, msp: 15500, base8th_225: 314100, base8th_286: 399256 },
  { level: "Level 14", army: "Major General", navy: "Rear Admiral", af: "Air Vice Marshal", base7th: 144200, msp: 0, base8th_225: 324450, base8th_286: 412412 },
  { level: "Level 15", army: "Lieutenant General (HAG)", navy: "Vice Admiral (HAG)", af: "Air Marshal (HAG)", base7th: 182200, msp: 0, base8th_225: 409950, base8th_286: 521092 },
  { level: "Level 16", army: "Lt Gen (Army Cdr / VCOAS)", navy: "Vice Admiral (FOC-in-C / VCNS)", af: "Air Marshal (AOC-in-C / VCAS)", base7th: 205400, msp: 0, base8th_225: 462150, base8th_286: 587444 },
  { level: "Level 17", army: "Vice Chief / DGAFMS / Special", navy: "Vice Chief / Special Scale", af: "Vice Chief / Special Scale", base7th: 225000, msp: 0, base8th_225: 506250, base8th_286: 643500 },
  { level: "Level 18", army: "Chief of the Army Staff (COAS)", navy: "Chief of the Naval Staff (CNS)", af: "Chief of the Air Staff (CAS)", base7th: 250000, msp: 0, base8th_225: 562500, base8th_286: 715000 }
];

const mspSlabs = [
  { category: "Officers (Level 10 to 13A)", current7th: "₹15,500 / month", projected8th_225: "₹34,875 / month", target8th_286: "₹44,330 / month", notes: "Counted as basic pay for DA and pension" },
  { category: "Military Nursing Service (MNS)", current7th: "₹10,800 / month", projected8th_225: "₹24,300 / month", target8th_286: "₹30,888 / month", notes: "Commissioned nursing officers" },
  { category: "JCOs / ORs (Levels 3 to 8A)", current7th: "₹5,200 / month", projected8th_225: "₹11,700 / month", target8th_286: "₹14,872 / month", notes: "Primary non-officer military cadre" }
];

const faqs = [
  {
    q: "What is Military Service Pay (MSP) and who receives it?",
    a: "Military Service Pay (MSP) is a special monthly compensatory entitlement paid exclusively to Armed Forces personnel (Army, Navy, and Air Force) to compensate for the unique hardships, physical hazards, regimented lifestyle, early retirement age, and severe disruptions to family life inherent to military service. Civilian defence employees do not receive MSP."
  },
  {
    q: "Is Military Service Pay counted for Dearness Allowance and Pension?",
    a: "Yes. Under Central Armed Forces service regulations, MSP counts as basic pay for the purpose of calculating Dearness Allowance (DA) and pensionary benefits. For superannuated defence veterans, 50% of the last-drawn MSP is integrated directly into the basic pension."
  },
  {
    q: "Why do Flag Officers (Major General and above) not receive MSP?",
    a: "Beginning at Pay Level 14 (Major General / Rear Admiral / Air Vice Marshal), officers transition into senior military-administrative leadership scales (Levels 14 to 18). Following 7th CPC recommendations, MSP ceases beyond Brigadier rank to prevent military leadership salaries from exceeding apex civil service executive pay caps (such as Level 17 Secretary and Level 18 Cabinet Secretary)."
  },
  {
    q: "What is the primary demand regarding MSP in the 8th Pay Commission?",
    a: "The foremost representation submitted by Armed Forces veterans and JCO/OR associations is addressing the steep disparity in MSP rates between Officers (₹15,500) and JCOs/ORs (₹5,200). Defence confederations have argued before the government that physical risk, high-altitude border exposure, and battle hazards are encountered equally (if not more intensely) by frontline soldiers, demanding that JCO/OR MSP be escalated to at least 70%–75% of the officer scale."
  },
  {
    q: "How does One Rank One Pension (OROP) integrate with Pay Commission revisions?",
    a: "OROP periodically resets past veteran pensions to match the average of the minimum and maximum pensions drawn by newly retired service personnel in the same rank with the same length of service. When a new Pay Commission like the 8th CPC escalates active duty defence basic pay, OROP revision rounds translate these higher salary matrix benchmarks into increased pensions for past defence retirees."
  }
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <meta name="keywords" content="defence pay matrix level 3 to 18, military service pay msp 8th pay commission, indian army salary calculator, navy air force pay scale 2026, jco or pay matrix, orop pension revision" />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:locale" content="en_IN" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="8th Pay Commission Portal" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Schema.org WebPage + FAQPage -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebPage",
        "name": pageTitle,
        "url": canonicalURL.toString(),
        "description": pageDescription,
        "inLanguage": "en-IN"
      },
      {
        "@type": "FAQPage",
        "mainEntity": faqs.map((f) => ({
          "@type": "Question",
          "name": f.q,
          "acceptedAnswer": { "@type": "Answer", "text": f.a }
        }))
      }
    ]
  })} />

  <style>
    :root {
      --bg: #f8fafc;
      --surface: #ffffff;
      --surface-subtle: #f1f5f9;
      --border: #e2e8f0;
      --primary: #1d4ed8;
      --primary-hover: #1e40af;
      --primary-gradient: linear-gradient(135deg, #1d4ed8 0%, #0284c7 100%);
      --text: #0f172a;
      --text-muted: #64748b;
      --accent-green: #15803d;
      --accent-green-bg: #dcfce7;
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.05);
      --shadow-md: 0 4px 12px -2px rgba(15, 23, 42, 0.08);
      --shadow-lg: 0 16px 32px -4px rgba(15, 23, 42, 0.08);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; }
    body { background: var(--bg); color: var(--text); line-height: 1.7; font-size: 15px; -webkit-font-smoothing: antialiased; }
    a { color: var(--primary); text-decoration: none; transition: color 0.2s ease; }
    a:hover { color: var(--primary-hover); }

    .layout-wrap { max-width: 1160px; margin: 0 auto; padding: 0 1.25rem; }

    /* Hero Header */
    .hero-header {
      text-align: center;
      padding: 3rem 1rem 1.75rem;
    }
    .badge-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: #eff6ff;
      border: 1px solid #bfdbfe;
      color: #1d4ed8;
      padding: 0.25rem 0.85rem;
      border-radius: 30px;
      font-size: 0.78rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.85rem;
    }
    .hero-header h1 {
      font-size: clamp(1.85rem, 4vw, 2.75rem);
      font-weight: 800;
      letter-spacing: -0.035em;
      line-height: 1.22;
      margin-bottom: 0.75rem;
      color: var(--text);
    }
    .hero-header p {
      color: var(--text-muted);
      max-width: 780px;
      margin: 0 auto;
      font-size: 1.05rem;
    }

    /* Calculator Main Box */
    .calc-box {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 2rem;
      box-shadow: var(--shadow-lg);
      margin-bottom: 3.5rem;
    }
    .chip-bar {
      display: flex;
      gap: 0.5rem;
      overflow-x: auto;
      padding: 0.5rem 0 1.25rem;
      scrollbar-width: none;
    }
    .chip-bar::-webkit-scrollbar { display: none; }
    .chip-btn {
      background: #f1f5f9;
      border: 1px solid var(--border);
      color: #475569;
      padding: 0.5rem 1.1rem;
      border-radius: 30px;
      font-size: 0.84rem;
      font-weight: 700;
      white-space: nowrap;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .chip-btn:hover { background: #e2e8f0; }
    .chip-btn.active {
      background: var(--primary);
      border-color: var(--primary);
      color: #ffffff;
      box-shadow: 0 2px 8px rgba(29, 78, 216, 0.3);
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1.25rem;
      margin-bottom: 1.5rem;
    }
    .form-item {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
    .form-item label {
      font-size: 0.82rem;
      font-weight: 700;
      color: #334155;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }
    .form-item input, .form-item select {
      background: #ffffff;
      border: 1.5px solid #cbd5e1;
      color: var(--text);
      padding: 0.75rem 0.9rem;
      border-radius: var(--radius-sm);
      font-size: 0.96rem;
      font-weight: 600;
      outline: none;
      transition: all 0.2s;
    }
    .form-item input:focus, .form-item select:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
    }

    /* Live Summary Cards */
    .summary-cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      margin-bottom: 1.5rem;
    }
    .kpi-unit {
      background: #f8fafc;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 1.25rem;
      text-align: center;
      position: relative;
    }
    .kpi-unit.highlight {
      background: #eff6ff;
      border-color: #bfdbfe;
    }
    .kpi-unit.success {
      background: var(--accent-green-bg);
      border-color: #86efac;
    }
    .kpi-unit .kpi-label {
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
      margin-bottom: 0.35rem;
    }
    .kpi-unit .kpi-val {
      font-size: 1.45rem;
      font-weight: 800;
      color: var(--text);
    }
    .kpi-unit.highlight .kpi-val { color: var(--primary); }
    .kpi-unit.success .kpi-val { color: var(--accent-green); }

    /* Breakdown Box */
    .breakdown-box {
      background: #f8fafc;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 1.5rem;
      margin-top: 1.5rem;
    }
    .breakdown-title {
      font-weight: 800;
      font-size: 1rem;
      color: var(--text);
      margin-bottom: 0.85rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .breakdown-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.94rem;
    }
    .breakdown-table td {
      padding: 0.65rem 0.5rem;
      border-bottom: 1px dashed #cbd5e1;
    }
    .breakdown-table tr:last-child td { border-bottom: none; }
    .breakdown-table td.num {
      text-align: right;
      font-weight: 700;
    }

    /* Long-Form Content Area */
    .article-wrap {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 2.75rem;
      box-shadow: var(--shadow-sm);
      margin-bottom: 3.5rem;
    }
    .article-wrap h2 {
      font-size: 1.6rem;
      font-weight: 800;
      color: var(--text);
      letter-spacing: -0.025em;
      margin: 2.5rem 0 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 2px solid #eff6ff;
    }
    .article-wrap h3 {
      font-size: 1.25rem;
      font-weight: 700;
      color: #1e293b;
      margin: 1.6rem 0 0.65rem;
    }
    .article-wrap p {
      margin-bottom: 1.25rem;
      color: #334155;
      font-size: 1.02rem;
    }
    .article-wrap ul, .article-wrap ol {
      margin-bottom: 1.5rem;
      padding-left: 1.5rem;
      color: #334155;
    }
    .article-wrap li { margin-bottom: 0.45rem; }

    .formula-banner {
      background: #eff6ff;
      border-left: 4px solid var(--primary);
      padding: 1.15rem 1.35rem;
      border-radius: 0 8px 8px 0;
      margin: 1.5rem 0;
      font-family: monospace;
      font-size: 0.96rem;
      color: #1e40af;
    }

    /* Tables */
    .table-responsive {
      overflow-x: auto;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      margin: 1.5rem 0;
    }
    table.data-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 0.91rem;
    }
    table.data-table th, table.data-table td {
      padding: 0.8rem 0.95rem;
      border-bottom: 1px solid var(--border);
    }
    table.data-table th {
      background: #f8fafc;
      color: #475569;
      font-weight: 700;
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      white-space: nowrap;
    }
    table.data-table tr:hover td { background: #f8fafc; }

    /* FAQ */
    .faq-unit {
      border-bottom: 1px solid var(--border);
      padding: 1.15rem 0;
    }
    .faq-quest {
      font-weight: 700;
      color: var(--text);
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 1.02rem;
    }
    .faq-ans {
      display: none;
      padding-top: 0.65rem;
      color: #475569;
      font-size: 0.96rem;
      line-height: 1.7;
    }
    .faq-unit.open .faq-ans { display: block; }
    .faq-unit.open .faq-arrow { transform: rotate(180deg); }
    .faq-arrow { transition: transform 0.2s ease; font-size: 0.75rem; color: var(--text-muted); }

    /* Mobile Sticky Bar */
    .mobile-sticky-bar {
      display: none;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: rgba(255, 255, 255, 0.96);
      border-top: 1px solid var(--border);
      backdrop-filter: blur(12px);
      padding: 0.75rem 1.25rem;
      z-index: 990;
      justify-content: space-between;
      align-items: center;
      box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.06);
    }
    .mobile-sticky-bar .lbl { font-size: 0.74rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700; }
    .mobile-sticky-bar .val { font-size: 1.2rem; font-weight: 800; color: var(--primary); }
    @media (max-width: 768px) {
      .mobile-sticky-bar { display: flex; }
      body { padding-bottom: 4.5rem; }
    }

    /* Disclaimer */
    .disclaimer-strip {
      max-width: 1160px;
      margin: 2rem auto 4rem;
      padding: 1.25rem;
      background: #f8fafc;
      border: 1px solid var(--border);
      border-left: 4px solid #94a3b8;
      border-radius: var(--radius-sm);
      font-size: 0.82rem;
      line-height: 1.6;
      color: #64748b;
    }
  </style>
</head>
<body>

  <main class="layout-wrap">

    <!-- HERO HEADER -->
    <header class="hero-header">
      <div class="badge-pill">Armed Forces Remuneration & Tri-Service Matrix</div>
      <h1>Defence Pay Scale & Matrix (7th & 8th CPC)</h1>
      <p>Comprehensive guide and calculator for Indian Army, Navy, and Air Force compensation: analyze Level 3 to 18 Defence Matrix cells, Military Service Pay (MSP), field allowances, and pension parity.</p>
    </header>

    <!-- INTERACTIVE DEFENCE SALARY CALCULATOR WIDGET -->
    <section class="calc-box" aria-label="Defence Salary and Military Service Pay Calculator Widget">
      
      <!-- Rank Preset Chips -->
      <div style="margin-bottom: 1.25rem;">
        <span style="font-size: 0.8rem; font-weight: 700; color: #64748b; text-transform: uppercase;">Select Representative Military Rank:</span>
        <div class="chip-bar" id="rankPills">
          <button class="chip-btn" data-base="21700" data-msp="5200" data-lvl="Level 3 (Sepoy)">Sepoy / OR (Level 3)</button>
          <button class="chip-btn" data-base="29200" data-msp="5200" data-lvl="Level 5 (Havildar)">Havildar (Level 5)</button>
          <button class="chip-btn" data-base="35400" data-msp="5200" data-lvl="Level 6 (Naib Subedar)">Naib Subedar (JCO - L6)</button>
          <button class="chip-btn" data-base="47600" data-msp="5200" data-lvl="Level 8 (Subedar Major)">Subedar Major (JCO - L8)</button>
          <button class="chip-btn active" data-base="56100" data-msp="15500" data-lvl="Level 10 (Lieutenant)">Lieutenant (Level 10)</button>
          <button class="chip-btn" data-base="69400" data-msp="15500" data-lvl="Level 11 (Major)">Major (Level 11)</button>
          <button class="chip-btn" data-base="130600" data-msp="15500" data-lvl="Level 13 (Colonel)">Colonel (Level 13)</button>
        </div>
      </div>

      <!-- Controls Grid -->
      <div class="form-grid">
        <div class="form-item">
          <label for="defRankSelect">Armed Forces Rank & Level</label>
          <select id="defRankSelect">
            {defenceRanks.map((r) => (
              <option value={r.base7th} data-msp={r.msp} data-level={r.level} data-army={r.army} selected={r.army === "Lieutenant"}>
                {r.level} - {r.army} / {r.navy} / {r.af} (7th Base: ₹{r.base7th.toLocaleString('en-IN')})
              </option>
            ))}
          </select>
        </div>

        <div class="form-item">
          <label for="defBasicInput">Current 7th CPC Basic Pay (₹)</label>
          <input type="number" id="defBasicInput" value="56100" min="21700" step="100" />
        </div>

        <div class="form-item">
          <label for="defFitmentSelect">Simulated Fitment Multiplier</label>
          <select id="defFitmentSelect">
            <option value="1.00">7th CPC Current Scales (1.00x)</option>
            <option value="2.25">2.25x (Conservative Model)</option>
            <option value="2.57">2.57x (7th CPC Parity)</option>
            <option value="2.86" selected>2.86x (Federation Target)</option>
          </select>
        </div>

        <div class="form-item">
          <label for="defPostingArea">Field / High Altitude Deployment Tier</label>
          <select id="defPostingArea">
            <option value="0" selected>Peace Station Posting (Standard Allowance)</option>
            <option value="10500">Modified Field Area Allowance (₹10,500)</option>
            <option value="16900">Highly Active Field Area Allowance (₹16,900)</option>
            <option value="25000">High Altitude Cat-III / Siachen Tier (₹25,000 to ₹42,500)</option>
          </select>
        </div>
      </div>

      <!-- Live Summary KPI Cards -->
      <div class="summary-cards">
        <div class="kpi-unit">
          <div class="kpi-label">Revised Military Basic Pay</div>
          <div class="kpi-val" id="dispDefBasic">₹1,60,446</div>
        </div>
        <div class="kpi-unit highlight">
          <div class="kpi-label">Applicable MSP (with Fitment)</div>
          <div class="kpi-val" id="dispMsp">₹44,330</div>
        </div>
        <div class="kpi-unit success">
          <div class="kpi-label">Total Military Basic + MSP</div>
          <div class="kpi-val" id="dispGrossTotal">₹2,04,776</div>
        </div>
      </div>

      <!-- Detailed Breakdown Slip -->
      <div class="breakdown-box">
        <div class="breakdown-title">
          <span>Monthly Military Emoluments Calculation Breakdown</span>
          <span style="color: var(--primary); font-size: 0.85rem;" id="slipRankLabel">Level 10 • Lieutenant • Peace Station</span>
        </div>
        <table class="breakdown-table">
          <tbody>
            <tr>
