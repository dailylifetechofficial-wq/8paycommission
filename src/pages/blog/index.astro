---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---
<SiteLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="posts">
    <ul>
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}/`}>
            <img width={720} height={360} src={post.data.heroImage} alt="" />
            <h2 class="title">{post.data.title}</h2>
            <p class="date"><FormattedDate date={post.data.pubDate} /></p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</SiteLayout>
<style>
  .posts { max-width: 960px; margin: 0 auto; }
  ul { display: flex; flex-wrap: wrap; gap: 2rem; list-style: none; margin: 0; padding: 0; }
  li { width: calc(50% - 1rem); }
  li:first-child { width: 100%; margin-bottom: 1rem; text-align: center; }
  li:first-child img { width: 100%; }
  li img { display: block; width: 100%; height: auto; margin-bottom: .5rem; border-radius: 12px; transition: box-shadow .2s ease; }
  li a { display: block; color: inherit; text-decoration: none; }
  li a:hover img { box-shadow: 0 8px 24px rgba(15,23,42,.12); }
  .title { margin: 0; color: #0f172a; line-height: 1.2; font-size: 1.35rem; }
  .date { margin: .35rem 0 0; color: #64748b; }
  @media (max-width: 720px) { ul { gap: .75rem; } li, li:first-child { width: 100%; text-align: center; } }
</style>
