// src/pages/8th-pay-commission-da-calculator.astro
const siteUrl = "https://8paycommission.com";
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const pageTitle = "8th Pay Commission DA Calculator: AICPI-IW Index & Expected DA Hike (2026)";
const pageDescription = "Calculate your projected Dearness Allowance (DA & DR) under the 8th Pay Commission. Forecast DA percentage hikes from 0% baseline using AICPI-IW index numbers.";

// Projected 8th CPC Semi-Annual DA Trajectory Benchmarks (2026 to 2030)
const daProjectionSchedule = [
  { period: "January 2026", event: "8th CPC Implementation Benchmark", expectedDa: "0%", avgAicpi: "Base Index Reset", status: "Statutory Reset" },
  { period: "July 2026", event: "1st Semi-Annual Installment", expectedDa: "3% – 4%", avgAicpi: "144.5 – 146.0", status: "Projected" },
  { period: "January 2027", event: "2nd Semi-Annual Installment", expectedDa: "7% – 8%", avgAicpi: "148.0 – 150.2", status: "Projected" },
  { period: "July 2027", event: "3rd Semi-Annual Installment", expectedDa: "11% – 12%", avgAicpi: "152.5 – 154.8", status: "Projected" },
  { period: "January 2028", event: "4th Semi-Annual Installment", expectedDa: "15% – 16%", avgAicpi: "157.0 – 159.5", status: "Projected" },
  { period: "July 2028", event: "5th Semi-Annual Installment", expectedDa: "19% – 20%", avgAicpi: "162.0 – 164.2", status: "Projected" },
  { period: "January 2029", event: "6th Semi-Annual Installment", expectedDa: "23% – 25%", avgAicpi: "167.0 – 169.5", status: "Projected" },
  { period: "July 2029", event: "7th Semi-Annual Installment (25% Milestone)", expectedDa: "27% – 29%", avgAicpi: "172.0 – 174.8", status: "Allowance Trigger" },
  { period: "January 2030", event: "8th Semi-Annual Installment", expectedDa: "32% – 34%", avgAicpi: "177.5 – 180.2", status: "Projected" }
];

// Entry Pay Matrix Level Benchmarks for DA Impact Simulation
const daLevelBenchmarks = [
  { level: "Level 1 (GP 1800)", post: "MTS / Group D Staff", base8th: 51480 },
  { level: "Level 2 (GP 1900)", post: "Lower Division Clerk (LDC)", base8th: 56914 },
  { level: "Level 3 (GP 2000)", post: "Constable / Driver / Postal Asst", base8th: 62062 },
  { level: "Level 4 (GP 2400)", post: "Upper Division Clerk (UDC)", base8th: 72930 },
  { level: "Level 5 (GP 2800)", post: "Auditor / Accountant", base8th: 83512 },
  { level: "Level 6 (GP 4200)", post: "Inspector / Sub-Inspector / Teacher", base8th: 101244 },
  { level: "Level 7 (GP 4600)", post: "Assistant Section Officer (ASO)", base8th: 128414 },
  { level: "Level 8 (GP 4800)", post: "Assistant Accounts Officer (AAO)", base8th: 136136 },
  { level: "Level 10 (GP 5400)", post: "Group A Entry / SDM / DSP", base8th: 160446 },
  { level: "Level 12 (GP 7600)", post: "Deputy Secretary / Joint Director", base8th: 225368 },
  { level: "Level 14 (GP 10000)", post: "Joint Secretary / IG Police", base8th: 412412 }
];

const faqs = [
  {
    q: "Why does Dearness Allowance (DA) drop to zero when the 8th Pay Commission starts?",
    a: "This follows standard Central Pay Commission protocol. The accumulated inflation compensation (Dearness Allowance) is merged completely into the revised basic pay through the fitment factor multiplier. Because all prior retail inflation is absorbed into the new basic wage floor, the DA rate resets to 0% and starts accumulating anew."
  },
  {
    q: "What is the official mathematical formula used to calculate Dearness Allowance?",
    a: "For Central Government employees, DA is calculated using the 12-month moving average of the All-India Consumer Price Index for Industrial Workers (AICPI-IW, Base 2016=100): DA % = [((Average of AICPI-IW for last 12 months − Base Index) ÷ Base Index) × 100]. Fractions below 1% are discarded."
  },
  {
    q: "How frequently is Dearness Allowance announced and revised?",
    a: "Dearness Allowance is revised twice a year by the Union Cabinet: effective January 1st (notified in March/April with arrears) and effective July 1st (notified in September/October with festive arrears)."
  },
  {
    q: "Does Dearness Allowance also apply to Transport Allowance (TA)?",
    a: "Yes. In addition to basic salary, Central Government employees receive Dearness Allowance on their Transport Allowance: Total TA = [Base Transport Allowance + (Base TA × Current DA %)]. When DA resets to 0% under the 8th CPC, the DA portion on TA will temporarily reset to zero until fresh DA installments accumulate."
  },
  {
    q: "What is the difference between Dearness Allowance (DA) and Dearness Relief (DR)?",
    a: "DA is paid to active Central Government civil servants, railway staff, and defence personnel. Dearness Relief (DR) is the exact financial equivalent granted to central civil and armed forces pensioners to protect pensions against inflation."
  }
];
