---
import SiteLayout from '../layouts/SiteLayout.astro';

const siteUrl = 'https://8paycommission.com';
const pageTitle = '8th Pay Commission Calculator 2026: Expected Pay Matrix & Salary Hike';
const pageDescription = 'Calculate projected 8th Pay Commission basic pay, HRA and gross salary for Pay Matrix Levels 1 to 18.';

const payMatrixData = [
  { level: 'Level 1', gp: 'GP 1800', post: 'MTS / Group D Staff', entry7th: 18000 },
  { level: 'Level 2', gp: 'GP 1900', post: 'Lower Division Clerk (LDC)', entry7th: 19900 },
  { level: 'Level 3', gp: 'GP 2000', post: 'Senior Clerk / Constable', entry7th: 21700 },
  { level: 'Level 4', gp: 'GP 2400', post: 'Upper Division Clerk (UDC)', entry7th: 25500 },
  { level: 'Level 5', gp: 'GP 2800', post: 'Auditor / Accountant', entry7th: 29200 },
  { level: 'Level 6', gp: 'GP 4200', post: 'Inspector / Sub-Inspector / Primary Teacher', entry7th: 35400 },
  { level: 'Level 7', gp: 'GP 4600', post: 'Assistant Section Officer (ASO)', entry7th: 44900 },
  { level: 'Level 8', gp: 'GP 4800', post: 'Assistant Accounts Officer (AAO)', entry7th: 47600 },
  { level: 'Level 9', gp: 'GP 5400 (PB-2)', post: 'Senior Accounts Officer', entry7th: 53100 },
  { level: 'Level 10', gp: 'GP 5400 (PB-3)', post: 'Group-A Entry / DSP / SDM', entry7th: 56100 },
  { level: 'Level 11', gp: 'GP 6600', post: 'Under Secretary / Executive Engineer', entry7th: 67700 },
  { level: 'Level 12', gp: 'GP 7600', post: 'Deputy Secretary', entry7th: 78800 },
  { level: 'Level 13', gp: 'GP 8700', post: 'Director / Selection Grade', entry7th: 123100 },
  { level: 'Level 13A', gp: 'GP 8900', post: 'Senior Director / DIG', entry7th: 139600 },
  { level: 'Level 14', gp: 'GP 10000', post: 'Joint Secretary / IG', entry7th: 144200 },
  { level: 'Level 15', gp: 'HAG', post: 'Principal Secretary / ADG', entry7th: 182200 },
  { level: 'Level 16', gp: 'HAG+', post: 'Special Secretary / DG', entry7th: 205400 },
  { level: 'Level 17', gp: 'Apex Scale', post: 'Secretary to GoI', entry7th: 225000 },
  { level: 'Level 18', gp: 'Cabinet Sec', post: 'Cabinet Secretary of India', entry7th: 250000 },
];

const faqs = [
  ['What is the expected 8th Pay Commission fitment factor?', 'Current projections commonly model factors between 1.92x and 2.86x. The final factor will only be known after an official recommendation.'],
  ['What will happen to Dearness Allowance (DA)?', 'At implementation, accumulated DA is generally considered as part of the revised pay calculation. The government will confirm the treatment and reset mechanism.'],
  ['How is HRA estimated?', 'This calculator applies indicative HRA rates of 30%, 20% and 10% for Class X, Y and Z cities to the projected basic pay.'],
  ['How are arrears calculated?', 'Arrears are the difference between revised eligible pay and salary already drawn during any period covered by a retrospective implementation date.'],
];

const money = (value: number) => `₹${value.toLocaleString('en-IN')}`;
---

<SiteLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      { '@type': 'WebApplication', name: '8th Pay Commission Salary Calculator', url: siteUrl, applicationCategory: 'FinanceApplication', offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' } },
      { '@type': 'FAQPage', mainEntity: faqs.map(([question, answer]) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })) },
    ],
  })} />

  <header class="hero">
    <span class="eyebrow">2026 Salary Projection Model</span>
    <h1>8th Pay Commission Calculator</h1>
    <p>Estimate revised basic pay, HRA and monthly gross salary across all Central Government Pay Matrix levels.</p>
  </header>

  <section class="card calculator" id="calculator" aria-labelledby="calculator-title">
    <h2 id="calculator-title">Calculate your projected salary</h2>
    <p class="muted">Choose your current basic pay, fitment factor and city category.</p>
    <div class="controls">
      <label>Pay Level Preset<select id="levelSelect">{payMatrixData.map((row) => <option value={row.entry7th} selected={row.level === 'Level 6'}>{row.level} — {money(row.entry7th)}</option>)}</select></label>
      <label>Current Basic Pay (₹)<input id="basicPay" type="number" value="35400" min="18000" step="100" /></label>
      <label>Fitment Factor<select id="fitment"><option value="1.92">1.92x Conservative</option><option value="2.25">2.25x Baseline</option><option value="2.57">2.57x Parity</option><option value="2.86" selected>2.86x Target</option></select></label>
      <label>City Category<select id="hra"><option value="0.30" selected>Class X — 30%</option><option value="0.20">Class Y — 20%</option><option value="0.10">Class Z — 10%</option></select></label>
    </div>
    <div class="results" aria-live="polite">
      <div><span>Projected Basic Pay</span><strong id="resultBasic">₹1,01,244</strong></div>
      <div><span>Projected HRA</span><strong id="resultHra">₹30,373</strong></div>
      <div class="highlight"><span>Estimated Monthly Gross</span><strong id="resultGross">₹1,35,217</strong></div>
    </div>
  </section>

  <section class="card" id="pay-matrix">
    <h2>7th vs 8th CPC Pay Matrix Projections</h2>
    <p class="muted">Indicative starting basic pay for Levels 1 to 18. Select a level to load it into the calculator.</p>
    <div class="table-wrap"><table><thead><tr><th>Level</th><th>Grade Pay</th><th>Typical Post</th><th>7th CPC</th><th>8th CPC at 2.25x</th><th>8th CPC at 2.86x</th></tr></thead><tbody>{payMatrixData.map((row) => <tr><td><button class="level-button" data-level={row.entry7th}>{row.level}</button></td><td>{row.gp}</td><td>{row.post}</td><td>{money(row.entry7th)}</td><td>{money(Math.round(row.entry7th * 2.25))}</td><td class="accent">{money(Math.round(row.entry7th * 2.86))}</td></tr>)}</tbody></table></div>
  </section>

  <section class="card" id="faqs">
    <h2>Frequently Asked Questions</h2>
    {faqs.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}
  </section>

  <p class="disclaimer"><strong>Disclaimer:</strong> This is an independent informational calculator. Values are estimates and are not official Government of India pay rules. Always verify the final notification, pay matrix and allowance orders before making financial decisions.</p>
</SiteLayout>

<style>
  :global(body) { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; }
  .hero { padding: 3rem 0 2rem; text-align: center; }
  .eyebrow { display: inline-block; padding: .3rem .8rem; border: 1px solid #bfdbfe; border-radius: 999px; background: #eff6ff; color: #1d4ed8; font-size: .78rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; }
  h1 { margin: .9rem 0 .6rem; font-size: clamp(2rem, 5vw, 3rem); line-height: 1.15; }
  h2 { margin: 0 0 .45rem; font-size: 1.45rem; }
  .hero p { max-width: 680px; margin: 0 auto; color: #64748b; font-size: 1.05rem; }
  .card { margin: 0 0 2rem; padding: 2rem; border: 1px solid #e2e8f0; border-radius: 18px; background: #fff; box-shadow: 0 8px 24px rgba(15,23,42,.06); }
  .muted { margin: 0 0 1.25rem; color: #64748b; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 1rem; }
  label { display: grid; gap: .4rem; color: #334155; font-size: .8rem; font-weight: 700; text-transform: uppercase; }
  input, select { width: 100%; padding: .75rem; border: 1px solid #cbd5e1; border-radius: 8px; background: #fff; color: #0f172a; font: inherit; font-size: .9rem; }
  input:focus, select:focus { outline: 3px solid #dbeafe; border-color: #2563eb; }
  .results { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 1.5rem; }
  .results div { padding: 1.1rem; border: 1px solid #e2e8f0; border-radius: 12px; background: #f8fafc; text-align: center; }
  .results span { display: block; color: #64748b; font-size: .75rem; font-weight: 700; text-transform: uppercase; }
  .results strong { display: block; margin-top: .25rem; font-size: 1.35rem; }
  .results .highlight { border-color: #bfdbfe; background: #eff6ff; color: #1d4ed8; }
  .table-wrap { overflow-x: auto; border: 1px solid #e2e8f0; border-radius: 12px; }
  table { width: 100%; min-width: 760px; border-collapse: collapse; text-align: left; font-size: .88rem; }
  th, td { padding: .8rem; border-bottom: 1px solid #e2e8f0; }
  th { background: #f8fafc; color: #475569; font-size: .75rem; text-transform: uppercase; }
  tr:last-child td { border-bottom: 0; }
  .level-button { border: 0; background: transparent; color: #1d4ed8; cursor: pointer; font: inherit; font-weight: 700; }
  .accent { color: #1d4ed8; font-weight: 700; }
  details { padding: 1rem 0; border-bottom: 1px solid #e2e8f0; }
  details:last-child { border-bottom: 0; }
  summary { cursor: pointer; font-weight: 700; }
  details p { margin: .6rem 0 0; color: #475569; }
  .disclaimer { margin: 0 0 2rem; padding: 1rem; border-left: 4px solid #94a3b8; border-radius: 6px; background: #f8fafc; color: #64748b; font-size: .82rem; }
  @media (max-width: 640px) { .card { padding: 1.25rem; } .results { grid-template-columns: 1fr; } }
</style>

<script>
  const basicPay = document.querySelector('#basicPay') as HTMLInputElement;
  const fitment = document.querySelector('#fitment') as HTMLSelectElement;
  const hra = document.querySelector('#hra') as HTMLSelectElement;
  const levelSelect = document.querySelector('#levelSelect') as HTMLSelectElement;
  const resultBasic = document.querySelector('#resultBasic');
  const resultHra = document.querySelector('#resultHra');
  const resultGross = document.querySelector('#resultGross');
  const formatMoney = (value: number) => `₹${Math.round(value).toLocaleString('en-IN')}`;

  function calculate() {
    const revisedBasic = Number(basicPay.value || 0) * Number(fitment.value);
    const revisedHra = revisedBasic * Number(hra.value);
    const transportAllowance = Number(basicPay.value || 0) >= 35400 ? 3600 : 1350;
    resultBasic!.textContent = formatMoney(revisedBasic);
    resultHra!.textContent = formatMoney(revisedHra);
    resultGross!.textContent = formatMoney(revisedBasic + revisedHra + transportAllowance);
  }

  [basicPay, fitment, hra].forEach((element) => element.addEventListener('input', calculate));
  levelSelect.addEventListener('change', () => { basicPay.value = levelSelect.value; calculate(); });
  document.querySelectorAll<HTMLButtonElement>('.level-button').forEach((button) => button.addEventListener('click', () => {
    basicPay.value = button.dataset.level || '18000';
    levelSelect.value = basicPay.value;
    calculate();
    document.querySelector('#calculator')?.scrollIntoView({ behavior: 'smooth' });
  }));
  calculate();
</script>
