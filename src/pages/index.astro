---
// src/pages/index.astro
const siteUrl = "https://8paycommission.com";
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const pageTitle = "8th Pay Commission Calculator, Pay Matrix Level 1-18 & Fitment Factor (2026)";
const pageDescription = "Calculate your projected 8th Pay Commission revised basic pay, HRA, and pensions. Explore expected fitment factors (1.92x to 2.86x), complete 7th vs 8th CPC comparative pay matrix levels 1 to 18, and arrears estimation.";

// Full Level 1 to 18 Pay Matrix Benchmark Data
const payMatrixData = [
  { level: "Level 1", gp: "GP 1800", post: "MTS, Support Staff, Group D", entry7th: 18000 },
  { level: "Level 2", gp: "GP 1900", post: "Lower Division Clerk (LDC)", entry7th: 19900 },
  { level: "Level 3", gp: "GP 2000", post: "Senior Clerk, Constable, Driver", entry7th: 21700 },
  { level: "Level 4", gp: "GP 2400", post: "Upper Division Clerk (UDC), Head Constable", entry7th: 25500 },
  { level: "Level 5", gp: "GP 2800", post: "Auditor, Accountant, Assistant", entry7th: 29200 },
  { level: "Level 6", gp: "GP 4200", post: "Inspector, Sub-Inspector, Primary Teacher", entry7th: 35400 },
  { level: "Level 7", gp: "GP 4600", post: "Assistant Section Officer (ASO), Section Engineer", entry7th: 44900 },
  { level: "Level 8", gp: "GP 4800", post: "Assistant Accounts Officer (AAO), SO", entry7th: 47600 },
  { level: "Level 9", gp: "GP 5400 (PB-2)", post: "Senior Accounts Officer, Senior Section Officer", entry7th: 53100 },
  { level: "Level 10", gp: "GP 5400 (PB-3)", post: "Group-A Entry, SDM, DSP, Assistant Commissioner", entry7th: 56100 },
  { level: "Level 11", gp: "GP 6600", post: "Under Secretary, Executive Engineer", entry7th: 67700 },
  { level: "Level 12", gp: "GP 7600", post: "Deputy Secretary, Superintendent Engineer", entry7th: 78800 },
  { level: "Level 13", gp: "GP 8700", post: "Director, Selection Grade", entry7th: 123100 },
  { level: "Level 13A", gp: "GP 8900", post: "Senior Director, DIG, Chief Engineer", entry7th: 139600 },
  { level: "Level 14", gp: "GP 10000", post: "Joint Secretary, Inspector General (IG)", entry7th: 144200 },
  { level: "Level 15", gp: "HAG", post: "Principal Secretary, Additional Director General", entry7th: 182200 },
  { level: "Level 16", gp: "HAG+", post: "Special Secretary, Director General of Police (DG)", entry7th: 205400 },
  { level: "Level 17", gp: "Apex Scale", post: "Secretary to Government of India", entry7th: 225000 },
  { level: "Level 18", gp: "Cabinet Sec", post: "Cabinet Secretary of India", entry7th: 250000 }
];

// 22 Detailed SEO FAQ schema items
const faqs = [
  { q: "What is the expected 8th Pay Commission fitment factor?", a: "Economists and employee federations anticipate a fitment factor ranging between 1.92x and 2.86x. A multiplier of 2.25x to 2.57x is considered the primary baseline for balancing federal fiscal reserves with consumer price index (CPI) growth." },
  { q: "What will be the revised Level 1 minimum basic pay under 8th CPC?", a: "Under the 7th CPC, the entry basic salary is ₹18,000. At an expected 2.25x fitment factor, minimum basic pay will adjust to ₹40,500, while at a 2.57x multiplier it reaches ₹46,260, and at 2.86x it exceeds ₹51,480." },
  { q: "When is the 8th Central Pay Commission expected to be effective?", a: "Historically, central pay commissions are appointed once every decade. With the 7th CPC implemented on January 1, 2016, the 10-year transition cycle points toward the 2026 calendar cycle." },
  { q: "How is the 8th Pay Commission revised basic salary calculated?", a: "The formula is: Revised Basic Pay = Current 7th CPC Basic Pay × Approved Fitment Factor. The calculated amount is then fitted into the nearest pay matrix cell index." },
  { q: "What happens to Dearness Allowance (DA) when the 8th CPC starts?", a: "Whenever a new Pay Commission is officially implemented, accumulated Dearness Allowance is merged into the revised basic salary, and the new DA rate resets to 0%." },
  { q: "How does the 8th Pay Commission affect pensioners?", a: "Central government pensioners and family pensioners receive proportional pension revision. The basic pension (50% of last-drawn basic pay) is multiplied by the finalized fitment factor." },
  { q: "Will the Level 1 to 18 matrix format continue under the 8th CPC?", a: "Yes. The 7th CPC removed the older running Grade Pay framework and introduced the unified Pay Matrix spanning Levels 1 to 18, which is expected to remain the standard structure." },
  { q: "How will House Rent Allowance (HRA) be revised under the 8th Pay Commission?", a: "HRA will continue to be classified across X, Y, and Z city categories. While percentages may adjust, they apply directly to the higher revised basic salary, significantly increasing monthly house rent disbursements." },
  { q: "Will state government employees receive 8th Pay Commission benefits?", a: "Pay commissions are formed for Central Government employees and Armed Forces. However, state governments traditionally adopt similar revisions within 6 to 24 months." },
  { q: "What is the primary demand regarding commuted pension restoration?", a: "Pensioner associations have submitted memorandums demanding the recovery timeline for commuted pension be reduced from 15 years down to 12 years." },
  { q: "How is Military Service Pay (MSP) impacted?", a: "Armed forces personnel receive revised Military Service Pay (MSP) across Officers, Military Nursing Service (MNS), and JCO/OR tiers to address unique service conditions." },
  { q: "Are Railway and Postal personnel covered?", a: "Yes. All regular civilian employees of the Union Government, including Indian Railways, Department of Posts, and Defence Civilians, are directly covered." },
  { q: "How are arrears calculated in case of retroactive notification?", a: "Arrears represent the net financial difference between the new revised salary entitlement and the drawn wages across the retroactive rollout duration." },
  { q: "Will Transport Allowance (TA) be increased proportionally?", a: "Yes. Transport Allowance (TA) and its corresponding DA allowances undergo upward calibration based on cost-of-living parameters." },
  { q: "What will be the maximum basic pay ceiling under Level 18?", a: "Level 18 (Cabinet Secretary) is capped at ₹2,50,000 under the 7th CPC. Under a 2.25x to 2.57x fitment multiplier, this ceiling expands between ₹5,62,500 and ₹6,42,500." },
  { q: "What is the role of the National Council of JCM in 8th CPC?", a: "The National Council of Joint Consultative Machinery (JCM) functions as the official negotiating body representing employee confederations before the Ministry of Finance." },
  { q: "Does the 8th Pay Commission impact the Unified Pension Scheme (UPS)?", a: "Yes. Since UPS assures a pension of 50% of the average basic pay drawn in the last 12 months before retirement, the sharp hike in basic pay directly boosts assured retirement payouts." },
  { q: "What will happen to Children Education Allowance (CEA)?", a: "CEA rates automatically adjust upward when allowance restructuring takes place alongside base salary revisions." },
  { q: "What is the minimum pension under the 8th Pay Commission?", a: "Minimum basic pension under the 7th CPC is ₹9,000. Under an expected fitment factor between 2.25x and 2.57x, minimum pension will adjust between ₹20,250 and ₹23,130." },
  { q: "How does the annual increment system work in the pay matrix?", a: "Employees move vertically down the pay matrix by one cell each year, reflecting an annual incremental step of approximately 3% compounding growth." },
  { q: "What is the official procedure for 8th CPC report approval?", a: "Once appointed, the commission holds stakeholder hearings, prepares a recommendations report, submits it to the Finance Ministry, which is then ratified by the Union Cabinet." },
  { q: "Where can verified notifications be cross-checked?", a: "Official gazettes and directives are issued via the Department of Expenditure (doe.gov.in) and the Press Information Bureau (pib.gov.in)." }
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <meta name="keywords" content="8th pay commission, 8th cpc calculator, fitment factor, pay matrix level 1 to 18, central government employees, pension revision 2026, arrears calculation" />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:locale" content="en_IN" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="8th Pay Commission Portal" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDescription} />

  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": `${siteUrl}/#website`,
        "url": siteUrl,
        "name": "8th Pay Commission Information & Calculation Portal",
        "description": pageDescription,
        "inLanguage": "en-IN"
      },
      {
        "@type": "WebPage",
        "@id": `${siteUrl}/#webpage`,
        "url": siteUrl,
        "name": pageTitle,
        "isPartOf": { "@id": `${siteUrl}/#website` },
        "description": pageDescription,
        "inLanguage": "en-IN"
      },
      {
        "@type": "FAQPage",
        "mainEntity": faqs.map((f) => ({
          "@type": "Question",
          "name": f.q,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": f.a
          }
        }))
      }
    ]
  })} />

  <style>
    :root {
      --primary: #0a192f;
      --primary-hover: #112240;
      --primary-accent: #2563eb;
      --accent-cyan: #0ea5e9;
      --accent-gradient: linear-gradient(135deg, #2563eb 0%, #0284c7 100%);
      --text-main: #334155;
      --text-dark: #0f172a;
      --text-muted: #64748b;
      --bg-page: #f8fafc;
      --bg-card: #ffffff;
      --border-subtle: #e2e8f0;
      --border-focus: #3b82f6;
      --shadow-sm: 0 1px 3px rgba(0,0,0,0.05);
      --shadow-md: 0 6px 12px -2px rgba(15,23,42,0.06), 0 3px 6px -3px rgba(15,23,42,0.04);
      --shadow-lg: 0 12px 24px -4px rgba(15,23,42,0.08), 0 4px 8px -4px rgba(15,23,42,0.03);
      --radius-sm: 8px;
      --radius-md: 12px;
      --radius-lg: 16px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif; }
    body { background-color: var(--bg-page); color: var(--text-main); line-height: 1.7; font-size: 16px; -webkit-font-smoothing: antialiased; }
    a { color: var(--primary-accent); text-decoration: none; transition: all 0.2s ease; }
    a:hover { color: #1d4ed8; }

    /* =========================================================
       NAVIGATION BAR & MEGA MENUS
    ========================================================= */
    header.site-header {
      background: rgba(10, 25, 47, 0.98);
      backdrop-filter: blur(14px);
      color: #fff;
      position: sticky;
      top: 0;
      z-index: 1000;
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }
    .nav-wrapper {
      max-width: 1240px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.85rem 1.25rem;
    }
    .logo {
      font-size: 1.22rem;
      font-weight: 800;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 0.6rem;
      text-decoration: none !important;
      letter-spacing: -0.02em;
    }
    .rupee-badge {
      background: var(--accent-gradient);
      width: 34px;
      height: 34px;
      border-radius: 9px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 1.15rem;
      font-weight: 800;
      color: #fff;
      box-shadow: 0 2px 10px rgba(37,99,235,0.45);
    }
    .logo span { color: var(--accent-cyan); }

    /* Desktop Navigation */
    .desktop-nav { display: flex; align-items: center; }
    .nav-menu { display: flex; list-style: none; gap: 0.5rem; align-items: center; }
    .nav-item { position: relative; }
    .nav-link {
      color: #cbd5e1;
      font-weight: 600;
      font-size: 0.92rem;
      padding: 0.6rem 0.85rem;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      border-radius: var(--radius-sm);
      transition: all 0.2s ease;
    }
    .nav-link:hover, .nav-item:hover > .nav-link {
      color: #ffffff;
      background: rgba(255, 255, 255, 0.08);
    }
    .nav-arrow { font-size: 0.65rem; transition: transform 0.2s ease; opacity: 0.8; }
    .nav-item:hover .nav-arrow { transform: rotate(180deg); }

    /* Dropdown Menus */
    .dropdown-menu {
      position: absolute;
      top: 100%;
      left: 0;
      width: 260px;
      background: #0f223d;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-lg);
      padding: 0.5rem;
      list-style: none;
      display: none;
      flex-direction: column;
      gap: 0.2rem;
      z-index: 1010;
      animation: fadeIn 0.15s ease-in-out;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .nav-item:hover .dropdown-menu { display: flex; }
    .dropdown-link {
      color: #94a3b8;
      font-size: 0.88rem;
      font-weight: 500;
      padding: 0.6rem 0.85rem;
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      transition: all 0.15s ease;
    }
    .dropdown-link:hover {
      background: var(--primary-accent);
      color: #ffffff;
      padding-left: 1rem;
    }
    .badge-tag {
      font-size: 0.68rem;
      background: #ef4444;
      color: #fff;
      padding: 0.1rem 0.4rem;
      border-radius: 4px;
      font-weight: 700;
      text-transform: uppercase;
    }

    /* Mobile Hamburger Trigger */
    .mobile-menu-btn {
      display: none;
      background: transparent;
      border: none;
      color: #fff;
      font-size: 1.6rem;
      cursor: pointer;
      padding: 0.25rem;
    }

    /* Mobile Drawer */
    .mobile-drawer {
      position: fixed;
      top: 0;
      right: -100%;
      width: 82%;
      max-width: 340px;
      height: 100%;
      background: #0a192f;
      z-index: 1020;
      padding: 1.5rem;
      box-shadow: -4px 0 20px rgba(0,0,0,0.5);
      overflow-y: auto;
      transition: right 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .mobile-drawer.open { right: 0; }
    .mobile-drawer-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 1.25rem;
      border-bottom: 1px solid rgba(255,255,255,0.1);
      margin-bottom: 1.25rem;
    }
    .drawer-close { background: none; border: none; color: #fff; font-size: 1.5rem; cursor: pointer; }
    .mobile-nav-list { list-style: none; display: flex; flex-direction: column; gap: 0.4rem; }
    .mobile-nav-item { border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 0.35rem; }
    .mobile-nav-toggle {
      width: 100%;
      background: none;
      border: none;
      color: #f1f5f9;
      font-size: 0.96rem;
      font-weight: 600;
      padding: 0.75rem 0.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      cursor: pointer;
    }
    .mobile-sub-list {
      list-style: none;
      display: none;
      padding-left: 1rem;
      flex-direction: column;
      gap: 0.25rem;
      margin-bottom: 0.5rem;
    }
    .mobile-nav-item.expanded .mobile-sub-list { display: flex; }
    .mobile-nav-item.expanded .mobile-arrow { transform: rotate(180deg); }
    .mobile-sub-link {
      display: block;
      color: #94a3b8;
      font-size: 0.88rem;
      padding: 0.45rem 0.5rem;
      border-radius: 4px;
    }
    .mobile-sub-link:hover { color: #fff; background: rgba(255,255,255,0.06); }
    .drawer-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.6);
      backdrop-filter: blur(4px);
      z-index: 1015;
      display: none;
    }
    .drawer-backdrop.active { display: block; }

    @media (max-width: 992px) {
      .desktop-nav { display: none; }
      .mobile-menu-btn { display: block; }
    }

    /* =========================================================
       LAYOUT & STRUCTURAL COMPONENTS
    ========================================================= */
    .container { max-width: 1160px; margin: 0 auto; padding: 0 1.25rem; }
    section { margin-bottom: 3.5rem; scroll-margin-top: 5rem; }
    .card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 2.25rem;
      box-shadow: var(--shadow-sm);
      transition: box-shadow 0.2s ease;
    }
    .card:hover { box-shadow: var(--shadow-md); }
    .section-title {
      font-size: 1.85rem;
      color: var(--text-dark);
      margin-bottom: 0.45rem;
      font-weight: 800;
      letter-spacing: -0.025em;
      line-height: 1.3;
    }
    .section-desc { color: var(--text-muted); margin-bottom: 1.75rem; font-size: 1rem; }

    /* Hero Section */
    .hero {
      background: radial-gradient(circle at 50% 0%, #1e293b 0%, #0a192f 100%);
      color: #fff;
      padding: 4.5rem 1.25rem 3.75rem;
      text-align: center;
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }
    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(37, 99, 235, 0.2);
      border: 1px solid rgba(59, 130, 246, 0.4);
      color: #93c5fd;
      font-size: 0.82rem;
      font-weight: 700;
      padding: 0.35rem 0.9rem;
      border-radius: 30px;
      margin-bottom: 1.25rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .hero h1 {
      font-size: clamp(2rem, 4vw, 2.9rem);
      margin-bottom: 1rem;
      font-weight: 800;
      letter-spacing: -0.035em;
      line-height: 1.18;
    }
    .hero p {
      font-size: 1.12rem;
      color: #94a3b8;
      max-width: 760px;
      margin: 0 auto 2.25rem;
      font-weight: 400;
      line-height: 1.6;
    }
    .hero-actions { display: flex; justify-content: center; gap: 0.9rem; flex-wrap: wrap; }
    .btn {
      padding: 0.85rem 1.75rem;
      border-radius: var(--radius-sm);
      font-weight: 700;
      font-size: 0.95rem;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      border: none;
      text-decoration: none !important;
      transition: all 0.2s ease;
    }
    .btn-primary { background: var(--accent-gradient); color: #fff; box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35); }
    .btn-primary:hover { opacity: 0.95; transform: translateY(-1px); }
    .btn-secondary { background: rgba(255,255,255,0.08); color: #fff; border: 1px solid rgba(255,255,255,0.15); }
    .btn-secondary:hover { background: rgba(255,255,255,0.15); transform: translateY(-1px); }

    /* Trust / E-E-A-T Bar */
    .trust-meta-bar {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      padding: 1rem 1.35rem;
      background: #ffffff;
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      margin-bottom: 2.5rem;
      font-size: 0.88rem;
      color: var(--text-muted);
      flex-wrap: wrap;
      box-shadow: var(--shadow-sm);
    }
    .trust-meta-bar strong { color: var(--text-dark); }
    .meta-item { display: flex; align-items: center; gap: 0.45rem; }

    /* =========================================================
       CALCULATOR STYLING & RESULTS GRIDS
    ========================================================= */
    .calc-inputs-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 1.25rem;
      margin-top: 1.25rem;
    }
    .form-group label { display: block; font-size: 0.86rem; font-weight: 700; margin-bottom: 0.4rem; color: #1e293b; }
    .form-group input, .form-group select {
      width: 100%;
      padding: 0.8rem 0.95rem;
      border: 1.5px solid #cbd5e1;
      border-radius: var(--radius-sm);
      font-size: 0.96rem;
      outline: none;
      background: #fff;
      color: var(--text-dark);
      transition: all 0.2s;
    }
    .form-group input:focus, .form-group select:focus {
      border-color: var(--border-focus);
      box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
    }

    .calc-output {
      background: #f8fafc;
      border: 1px solid #cbd5e1;
      border-radius: var(--radius-md);
      padding: 1.5rem;
      margin-top: 1.75rem;
      display: none;
    }
    .calc-metrics-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
    }
    .calc-metric-card {
      background: #ffffff;
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      padding: 1.1rem;
      text-align: center;
    }
    .calc-metric-card.accent {
      background: #eff6ff;
      border-color: #bfdbfe;
    }
    .metric-label { font-size: 0.76rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 0.25rem; }
    .metric-value { font-size: 1.45rem; font-weight: 800; color: var(--text-dark); }
    .calc-metric-card.accent .metric-value { color: var(--primary-accent); }

    /* Multiplier Pill Bar */
    .factor-buttons-container { display: flex; gap: 0.65rem; flex-wrap: wrap; margin: 1.5rem 0; }
    .factor-pill-btn {
      padding: 0.65rem 1.25rem;
      background: #f1f5f9;
      border-radius: 30px;
      font-weight: 700;
      cursor: pointer;
      border: 1.5px solid transparent;
      font-size: 0.9rem;
      color: #475569;
      transition: all 0.2s ease;
    }
    .factor-pill-btn:hover { background: #e2e8f0; }
    .factor-pill-btn.active { background: #eff6ff; border-color: var(--primary-accent); color: var(--primary-accent); }

    /* Tables */
    .table-responsive { overflow-x: auto; margin-top: 1.25rem; border: 1px solid var(--border-subtle); border-radius: var(--radius-md); box-shadow: var(--shadow-sm); }
    table { width: 100%; border-collapse: collapse; text-align: left; font-size: 0.94rem; }
    th, td { padding: 0.85rem 1.1rem; border-bottom: 1px solid var(--border-subtle); }
    th { background: #f8fafc; font-weight: 700; color: var(--text-dark); font-size: 0.88rem; text-transform: uppercase; letter-spacing: 0.02em; }
    tr:last-child td { border-bottom: none; }
    tr:hover { background: #f8fafc; }

    /* Level Badges Grid */
    .level-badge-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 0.75rem; margin-top: 1.25rem; }
    .level-badge {
      background: #ffffff;
      border: 1px solid var(--border-subtle);
      padding: 0.85rem 0.5rem;
      border-radius: var(--radius-sm);
      text-align: center;
      cursor: pointer;
