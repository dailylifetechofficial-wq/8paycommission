        ))}
      </div>
    </section>

    <!-- LEVEL 1-18 COMPARISON TABLE -->
    <section class="panel">
      <h2>7th vs 8th CPC Pay Matrix Projections</h2>
      <p class="desc">Side-by-side comparative table modeling basic starting scales across Levels 1 through 18.</p>

      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>Pay Level</th>
              <th>Grade Pay</th>
              <th>Cadre Post</th>
              <th>7th CPC Base</th>
              <th>8th CPC (2.25x)</th>
              <th>8th CPC (2.86x Target)</th>
            </tr>
          </thead>
          <tbody>
            {payMatrixData.map((row) => (
              <tr>
                <td><strong>{row.level}</strong></td>
                <td>{row.gp}</td>
                <td>{row.post}</td>
                <td>₹{row.entry7th.toLocaleString('en-IN')}</td>
                <td>₹{Math.round(row.entry7th * 2.25).toLocaleString('en-IN')}</td>
                <td style="color: #38bdf8; font-weight: 700;">₹{Math.round(row.entry7th * 2.86).toLocaleString('en-IN')}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- FAQ ACCORDION -->
    <section class="panel" id="faqs">
      <h2>Frequently Asked Questions</h2>
