  <main class="layout-wrap">

    <!-- HERO INTRO -->
    <div class="hero-panel">
      <div class="badge-pill">2026 Salary Projection Model</div>
      <h1>8th Pay Commission Calculator</h1>
      <p>Estimate revised basic pay, HRA allowances, and total monthly in-hand hikes across all 18 Pay Matrix levels.</p>
    </div>

    <!-- MODERN INTERACTIVE CALCULATOR (ABOVE THE FOLD) -->
    <section class="glass-calculator" id="calculator" aria-label="Interactive 8th CPC Salary Calculator">
      
      <!-- Quick Multiplier Selector -->
      <div style="margin-bottom: 1.25rem;">
        <span style="font-size: 0.8rem; font-weight: 700; color: #9ca3af; text-transform: uppercase;">Expected Fitment Factor:</span>
        <div class="chip-bar" id="chipBar">
          <button class="chip-btn" data-factor="1.92">1.92x (Conservative)</button>
          <button class="chip-btn" data-factor="2.25">2.25x</button>
          <button class="chip-btn" data-factor="2.57">2.57x (7th CPC Parity)</button>
          <button class="chip-btn active" data-factor="2.86">2.86x (Federation Target)</button>
        </div>
      </div>

      <div class="calc-controls-grid">
        <div class="form-ctrl">
          <label for="matrixLevelSelect">Pay Level Preset</label>
          <select id="matrixLevelSelect">
            {payMatrixData.map((row) => (
              <option value={row.entry7th} selected={row.level === "Level 6"}>
                {row.level} ({row.gp}) - Min ₹{row.entry7th.toLocaleString('en-IN')}
              </option>
            ))}
          </select>
        </div>

        <div class="form-ctrl">
          <label for="basicPayInput">Current Basic Pay (₹)</label>
          <input type="number" id="basicPayInput" value="35400" min="18000" step="100" />
        </div>

        <div class="form-ctrl">
          <label for="customFitment">Fitment Factor</label>
          <select id="customFitment">
            <option value="1.92">1.92x (Conservative DA Merge)</option>
            <option value="2.10">2.10x (Balanced)</option>
            <option value="2.25">2.25x (Baseline Model)</option>
            <option value="2.57">2.57x (Equivalent to 7th CPC)</option>
            <option value="2.86" selected>2.86x (Union Demanded Target)</option>
            <option value="3.00">3.00x (High Wage Benchmark)</option>
          </select>
        </div>

        <div class="form-ctrl">
          <label for="cityTierSelect">City Tier (HRA Rate)</label>
          <select id="cityTierSelect">
            <option value="0.30" selected>Class X (30% - Metro Cities)</option>
            <option value="0.20">Class Y (20% - Tier-2 Centers)</option>
            <option value="0.10">Class Z (10% - Small Towns/Rural)</option>
          </select>
        </div>
      </div>

      <!-- Real-Time Metrics Output -->
      <div class="kpi-row">
        <div class="kpi-card">
          <div class="kpi-title">8th CPC Basic Pay</div>
          <div class="kpi-value" id="kpiBasic">₹1,01,244</div>
        </div>
        <div class="kpi-card">
          <div class="kpi-title">Revised HRA</div>
          <div class="kpi-value" id="kpiHra">₹30,373</div>
        </div>
        <div class="kpi-card highlight">
          <div class="kpi-title">Estimated Monthly Gross</div>
          <div class="kpi-value" id="kpiGross">₹1,35,217</div>
        </div>
      </div>
    </section>

    <!-- PAY MATRIX QUICK LOOKUP -->
    <section class="panel" id="pay-matrix">
      <h2>Pay Matrix Level Lookup</h2>
      <p class="desc">Select any level badge to load starting salaries directly into the projection tool.</p>
      
      <div class="level-grid">
        {payMatrixData.map((item) => (
          <div class="level-pill" data-base={item.entry7th}>
            <strong>{item.level}</strong>
            <span>₹{item.entry7th.toLocaleString('en-IN')}</span>
