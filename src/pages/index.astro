              <span>₹{item.entry7th.toLocaleString('en-IN')}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PENSION CALCULATOR -->
    <section id="pension-calculator">
      <div class="card">
        <h2 class="section-title">8th Pay Commission Pension Calculator</h2>
        <p class="section-desc">Estimate post-retirement basic pension and family pension revisions for retired Central Government and Armed Forces veterans.</p>

        <form id="pensionForm">
          <div class="calc-inputs-grid">
            <div class="form-group">
              <label for="pensionCurrent">Current Basic Pension (₹)</label>
              <input type="number" id="pensionCurrent" value="9000" min="9000" step="100" required />
            </div>
            <div class="form-group">
              <label for="pensionFactor">Projected Fitment Factor</label>
              <select id="pensionFactor">
                <option value="1.92">1.92x (Conservative)</option>
                <option value="2.10">2.10x</option>
                <option value="2.25" selected>2.25x (Baseline)</option>
                <option value="2.57">2.57x (7th CPC Baseline)</option>
                <option value="2.86">2.86x (Demanded Factor)</option>
              </select>
            </div>
          </div>
          <button type="submit" class="btn btn-primary" style="margin-top: 1.5rem;">Calculate Revised Pension</button>
        </form>

        <div id="pensionResult" class="calc-output">
          <div class="calc-metrics-grid">
            <div class="calc-metric-card">
              <div class="metric-label">Revised Basic Pension</div>
              <div class="metric-value" id="resPension">₹0</div>
            </div>
            <div class="calc-metric-card accent">
              <div class="metric-label">Family Pension (30% Baseline)</div>
              <div class="metric-value" id="resFamilyPension">₹0</div>
            </div>
          </div>
        </div>

        <div class="editorial-prose" style="margin-top: 2rem;">
          <h3>Pension Formulation and Revision Standards</h3>
          <p>
            In accordance with the recommendations of successive Pay Commissions, full basic pension entitlement is pegged at 50% of the last drawn basic pay (or the average emoluments of the last 10 months of qualifying service, whichever is more beneficial). For past retirees, basic pension is updated by applying the finalized fitment multiplier directly, providing complete parity with active employees.
          </p>
        </div>
      </div>
    </section>

    <!-- ARREARS CALCULATOR -->
    <section id="arrears-calculator">
      <div class="card">
        <h2 class="section-title">8th CPC Arrears Calculator</h2>
        <p class="section-desc">Calculate prospective retrospective earnings if the Pay Commission recommendations are enacted retroactively.</p>

        <form id="arrearsForm">
          <div class="calc-inputs-grid">
            <div class="form-group">
              <label for="arrOldPay">Current Monthly Drawn Pay (₹)</label>
              <input type="number" id="arrOldPay" value="45000" required />
            </div>
            <div class="form-group">
              <label for="arrNewPay">Estimated Revised Monthly Gross (₹)</label>
              <input type="number" id="arrNewPay" value="62000" required />
            </div>
            <div class="form-group">
              <label for="arrMonths">Retrospective Duration (Months)</label>
              <input type="number" id="arrMonths" value="6" min="1" max="36" required />
            </div>
          </div>
          <button type="submit" class="btn btn-primary" style="margin-top: 1.5rem;">Estimate Total Arrears</button>
        </form>

        <div id="arrearsResult" class="calc-output">
          <div class="calc-metrics-grid">
            <div class="calc-metric-card">
              <div class="metric-label">Monthly Gross Difference</div>
              <div class="metric-value" id="resMonthlyDiff">₹0</div>
            </div>
            <div class="calc-metric-card accent">
              <div class="metric-label">Estimated Total Arrears Receivable</div>
              <div class="metric-value" id="resTotalArrears">₹0</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FREQUENTLY ASKED QUESTIONS -->
    <section id="faqs">
      <div class="card">
        <h2 class="section-title">Frequently Asked Questions (FAQ)</h2>
        <p class="section-desc">In-depth answers to essential queries concerning the 8th Central Pay Commission.</p>

        <div class="faq-accordion">
          {faqs.map((faq) => (
            <div class="faq-row">
              <div class="faq-header">
                <span>{faq.q}</span>
                <span class="chevron">▼</span>
              </div>
              <div class="faq-body">{faq.a}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- OFFICIAL GOVERNMENT SOURCES -->
    <section>
      <div class="card">
        <h2 class="section-title">Official Sources & Verification Portals</h2>
        <p class="section-desc">Verify authentic announcements and statutory notices directly through primary government repositories.</p>

        <div class="official-sources-grid">
          <div class="source-box">
            <a href="https://doe.gov.in" target="_blank" rel="noopener noreferrer">Department of Expenditure (doe.gov.in) ↗</a>
            <p>Official repository for central pay rules, allowance gazettes, and service directives.</p>
          </div>
          <div class="source-box">
            <a href="https://pib.gov.in" target="_blank" rel="noopener noreferrer">Press Information Bureau (pib.gov.in) ↗</a>
            <p>Union Cabinet decisions, official press briefings, and government statements.</p>
          </div>
          <div class="source-box">
            <a href="https://finmin.nic.in" target="_blank" rel="noopener noreferrer">Ministry of Finance (finmin.nic.in) ↗</a>
            <p>Union budget documentation and financial expenditure memorandums.</p>
          </div>
        </div>
      </div>
    </section>

  </div>

  <!-- MODERN FOOTER -->
  <footer>
    <div class="footer-content">
      <div>
        <strong style="color: #fff; font-size: 1.15rem; display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.3rem;">
          <span class="rupee-badge" style="width: 24px; height: 24px; font-size: 0.9rem;">₹</span>
          8paycommission.com
        </strong>
        <p style="font-size: 0.85rem; max-width: 500px;">
          An independent research and analytical utility portal providing salary estimates, matrix comparisons, and statutory updates for Indian public servants.
        </p>
      </div>
      <div class="footer-nav">
        <a href="/about-us">About Us</a>
        <a href="/editorial-policy">Editorial Policy</a>
        <a href="/privacy-policy">Privacy Policy</a>
        <a href="/terms-of-use">Terms of Use</a>
        <a href="/contact-us">Contact Us</a>
      </div>
    </div>
    <div class="disclaimer-text">
      <strong>Statutory Disclaimer:</strong> 8paycommission.com is an independent educational and informative portal and is not operated by, affiliated with, or endorsed by the Government of India, the Ministry of Finance, or any Pay Commission authority. Official notifications, gazette copies, and orders must be verified exclusively through the official government portal at <a href="https://doe.gov.in" target="_blank" rel="noopener noreferrer" style="color: #94a3b8; text-decoration: underline;">doe.gov.in</a>. All calculations generated on this website are projected estimates based on past pay commission methodologies and public representations.
    </div>
  </footer>

  <!-- =========================================================
       CLIENT SCRIPTS (VANILLA JS, HIGH PERFORMANCE)
  ========================================================= -->
  <script is:inline>
    // 1. Mobile Drawer Navigation Toggle
    const mobileBtn = document.getElementById('mobileMenuBtn');
    const drawer = document.getElementById('mobileDrawer');
    const backdrop = document.getElementById('drawerBackdrop');
    const drawerClose = document.getElementById('drawerCloseBtn');

    function toggleDrawer(open) {
      if (open) {
        drawer.classList.add('open');
        backdrop.classList.add('active');
        document.body.style.overflow = 'hidden';
      } else {
        drawer.classList.remove('open');
        backdrop.classList.remove('active');
        document.body.style.overflow = '';
      }
    }

    mobileBtn.addEventListener('click', () => toggleDrawer(true));
    drawerClose.addEventListener('click', () => toggleDrawer(false));
    backdrop.addEventListener('click', () => toggleDrawer(false));

    // Mobile Submenu Accordions
    document.querySelectorAll('.mobile-nav-toggle').forEach(btn => {
      btn.addEventListener('click', () => {
        const item = btn.parentElement;
        item.classList.toggle('expanded');
      });
    });

    // 2. Main Salary Calculator Logic
    const salaryForm = document.getElementById('mainSalaryForm');
    const quickLevelSelect = document.getElementById('calcQuickLevel');
    const basicInput = document.getElementById('calc7thBasic');

    // Quick-fill basic salary from level selector
    quickLevelSelect.addEventListener('change', (e) => {
      if (e.target.value) {
        basicInput.value = e.target.value;
      }
    });

    salaryForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const basic = parseFloat(basicInput.value) || 0;
      const factor = parseFloat(document.getElementById('calcFitment').value) || 2.25;
      const hraRate = parseFloat(document.getElementById('calcHra').value) || 0.30;

      const revisedBasic = Math.round(basic * factor);
      const revisedHra = Math.round(revisedBasic * hraRate);
      const gross = revisedBasic + revisedHra;

      document.getElementById('resRevisedBasic').textContent = '₹' + revisedBasic.toLocaleString('en-IN');
      document.getElementById('resRevisedHRA').textContent = '₹' + revisedHra.toLocaleString('en-IN');
      document.getElementById('resGrossTotal').textContent = '₹' + gross.toLocaleString('en-IN');
      document.getElementById('salaryResults').style.display = 'block';
    });

    // 3. Interactive Fitment Factor Pill Switcher
    const pills = document.querySelectorAll('.factor-pill-btn');
    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        pills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        const f = parseFloat(pill.getAttribute('data-factor'));

        document.getElementById('displayFactor').textContent = f.toFixed(2) + 'x Multiplier Selected';
        document.getElementById('factorLvl1').textContent = '₹' + Math.round(18000 * f).toLocaleString('en-IN');
        document.getElementById('factorLvl6').textContent = '₹' + Math.round(35400 * f).toLocaleString('en-IN');
        document.getElementById('factorLvl10').textContent = '₹' + Math.round(56100 * f).toLocaleString('en-IN');
        document.getElementById('factorLvl14').textContent = '₹' + Math.round(144200 * f).toLocaleString('en-IN');
      });
    });

    // 4. Pay Level Badges Quick-Filler for Calculator
    document.querySelectorAll('.level-badge').forEach(badge => {
      badge.addEventListener('click', () => {
        const base = badge.getAttribute('data-base');
        basicInput.value = base;
        document.getElementById('salary-calculator').scrollIntoView({ behavior: 'smooth' });
        salaryForm.dispatchEvent(new Event('submit'));
      });
    });

    // 5. Pension Calculator Logic
    const pensionForm = document.getElementById('pensionForm');
    pensionForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const current = parseFloat(document.getElementById('pensionCurrent').value) || 0;
      const factor = parseFloat(document.getElementById('pensionFactor').value) || 2.25;

      const revised = Math.round(current * factor);
      const family = Math.round(revised * 0.6);

      document.getElementById('resPension').textContent = '₹' + revised.toLocaleString('en-IN');
      document.getElementById('resFamilyPension').textContent = '₹' + family.toLocaleString('en-IN');
      document.getElementById('pensionResult').style.display = 'block';
    });

    // 6. Arrears Calculator Logic
    const arrearsForm = document.getElementById('arrearsForm');
    arrearsForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const oldVal = parseFloat(document.getElementById('arrOldPay').value) || 0;
      const newVal = parseFloat(document.getElementById('arrNewPay').value) || 0;
      const months = parseInt(document.getElementById('arrMonths').value) || 0;

      const monthlyDiff = Math.max(0, newVal - oldVal);
      const totalArrears = monthlyDiff * months;

      document.getElementById('resMonthlyDiff').textContent = '₹' + monthlyDiff.toLocaleString('en-IN');
      document.getElementById('resTotalArrears').textContent = '₹' + totalArrears.toLocaleString('en-IN');
      document.getElementById('arrearsResult').style.display = 'block';
    });

    // 7. FAQ Accordion Interaction
    document.querySelectorAll('.faq-header').forEach(header => {
      header.addEventListener('click', () => {
        const row = header.parentElement;
        row.classList.toggle('open');
      });
    });
  </script>

</body>
</html>
