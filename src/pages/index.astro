// src/pages/index.astro
const siteUrl = "https://8paycommission.com";
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const pageTitle = "8th Pay Commission Calculator 2026: Expected Pay Matrix & Salary Hike";
const pageDescription = "Accurate 8th Pay Commission salary calculator. Instant basic pay, HRA, and gross salary estimates across Level 1-18 with 1.92x–2.86x fitment factors.";

const payMatrixData = [
  { level: "Level 1", gp: "GP 1800", post: "MTS / Group D Staff", entry7th: 18000 },
  { level: "Level 2", gp: "GP 1900", post: "Lower Division Clerk (LDC)", entry7th: 19900 },
  { level: "Level 3", gp: "GP 2000", post: "Senior Clerk / Constable", entry7th: 21700 },
  { level: "Level 4", gp: "GP 2400", post: "Upper Division Clerk (UDC)", entry7th: 25500 },
  { level: "Level 5", gp: "GP 2800", post: "Auditor / Accountant", entry7th: 29200 },
  { level: "Level 6", gp: "GP 4200", post: "Inspector / Sub-Inspector / Primary Teacher", entry7th: 35400 },
  { level: "Level 7", gp: "GP 4600", post: "Assistant Section Officer (ASO)", entry7th: 44900 },
  { level: "Level 8", gp: "GP 4800", post: "Assistant Accounts Officer (AAO)", entry7th: 47600 },
  { level: "Level 9", gp: "GP 5400 (PB-2)", post: "Senior Accounts Officer", entry7th: 53100 },
  { level: "Level 10", gp: "GP 5400 (PB-3)", post: "Group-A Entry / DSP / SDM", entry7th: 56100 },
  { level: "Level 11", gp: "GP 6600", post: "Under Secretary / Exec Engineer", entry7th: 67700 },
  { level: "Level 12", gp: "GP 7600", post: "Deputy Secretary", entry7th: 78800 },
  { level: "Level 13", gp: "GP 8700", post: "Director / Selection Grade", entry7th: 123100 },
  { level: "Level 13A", gp: "GP 8900", post: "Senior Director / DIG", entry7th: 139600 },
  { level: "Level 14", gp: "GP 10000", post: "Joint Secretary / IG", entry7th: 144200 },
  { level: "Level 15", gp: "HAG", post: "Principal Secretary / ADG", entry7th: 182200 },
  { level: "Level 16", gp: "HAG+", post: "Special Secretary / DG", entry7th: 205400 },
  { level: "Level 17", gp: "Apex Scale", post: "Secretary to GoI", entry7th: 225000 },
  { level: "Level 18", gp: "Cabinet Sec", post: "Cabinet Secretary of India", entry7th: 250000 }
];

const faqs = [
  { q: "What is the expected 8th Pay Commission fitment factor?", a: "Staff federations and financial models place the anticipated fitment factor between 2.25x and 2.86x, with conservative baseline projections starting at 1.92x." },
  { q: "What will be the revised Level 1 minimum basic pay?", a: "Current 7th CPC minimum basic is ₹18,000. Under 2.25x fitment it adjusts to ₹40,500; at 2.57x it hits ₹46,260; and at 2.86x it reaches ₹51,480." },
  { q: "What happens to Dearness Allowance (DA) when 8th CPC starts?", a: "Accumulated Dearness Allowance merges directly into the revised basic salary, and the new DA rate officially resets to 0% upon rollout." },
  { q: "How will House Rent Allowance (HRA) be revised?", a: "HRA continues across X (30%), Y (20%), and Z (10%) classifications, applying directly to the higher revised basic salary." },
  { q: "How are 8th CPC arrears calculated?", a: "Arrears represent the cumulative difference between the revised gross salary entitlement and the drawn wages across any retroactive rollout period." }
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <meta name="keywords" content="8th pay commission calculator, 8th cpc salary calculator, fitment factor 2026, 8th pay matrix, level 1 to 18 basic pay, central government employees pay hike" />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph / Social SEO -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:url" content={canonicalURL} />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Schema.org SoftwareApplication + FAQPage for Rich Snippets -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebApplication",
        "name": "8th Pay Commission Salary Calculator",
        "operatingSystem": "All",
        "applicationCategory": "FinanceApplication",
        "offers": { "@type": "Offer", "price": "0", "priceCurrency": "INR" }
      },
      {
        "@type": "FAQPage",
        "mainEntity": faqs.map((f) => ({
          "@type": "Question",
          "name": f.q,
          "acceptedAnswer": { "@type": "Answer", "text": f.a }
        }))
      }
    ]
  })} />

  <style>
    :root {
      --bg: #0b0f19;
      --surface: #111827;
      --surface-glass: rgba(17, 24, 39, 0.85);
      --border: rgba(255, 255, 255, 0.1);
      --border-accent: rgba(59, 130, 246, 0.5);
      --primary: #3b82f6;
      --primary-gradient: linear-gradient(135deg, #2563eb, #06b6d4);
      --text: #f3f4f6;
      --text-muted: #9ca3af;
      --accent-green: #10b981;
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; }
    body { background: var(--bg); color: var(--text); line-height: 1.6; font-size: 15px; -webkit-font-smoothing: antialiased; }
    a { color: var(--primary); text-decoration: none; }

    /* Sticky Navigation */
    header.site-nav {
      background: var(--surface-glass);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 1000;
    }
    .nav-container {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.75rem 1.25rem;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 1.2rem;
      font-weight: 800;
      color: #fff;
      letter-spacing: -0.02em;
    }
    .brand-badge {
      background: var(--primary-gradient);
      width: 32px;
      height: 32px;
      border-radius: 8px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-weight: 800;
      box-shadow: 0 0 12px rgba(37, 99, 235, 0.5);
    }

    /* Desktop Navigation with Dropdowns */
    .desktop-nav { display: flex; align-items: center; }
    .nav-list { display: flex; list-style: none; gap: 0.25rem; align-items: center; }
    .nav-item { position: relative; }
    .nav-link {
      color: #d1d5db;
      font-weight: 600;
      font-size: 0.88rem;
      padding: 0.55rem 0.85rem;
      border-radius: var(--radius-sm);
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      transition: all 0.2s ease;
    }
    .nav-link:hover, .nav-item:hover > .nav-link {
      color: #fff;
      background: rgba(255, 255, 255, 0.06);
    }
    .dropdown {
      position: absolute;
      top: 100%;
      left: 0;
      width: 250px;
      background: #151d30;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      box-shadow: 0 16px 32px rgba(0, 0, 0, 0.4);
      padding: 0.4rem;
      list-style: none;
      display: none;
      flex-direction: column;
      gap: 0.2rem;
      z-index: 1010;
    }
    .nav-item:hover .dropdown { display: flex; }
    .dropdown-link {
      color: #9ca3af;
      font-size: 0.84rem;
      padding: 0.55rem 0.75rem;
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      transition: 0.15s;
    }
    .dropdown-link:hover { background: var(--primary); color: #fff; }

    /* Mobile Hamburger */
    .menu-trigger {
      display: none;
      background: none;
      border: none;
      color: #fff;
      font-size: 1.6rem;
      cursor: pointer;
    }
    @media (max-width: 992px) {
      .desktop-nav { display: none; }
      .menu-trigger { display: block; }
    }

    /* Mobile Drawer */
    .drawer-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.7);
      backdrop-filter: blur(4px);
      z-index: 1020;
      display: none;
    }
    .drawer-backdrop.active { display: block; }
    .mobile-drawer {
      position: fixed;
      top: 0;
      right: -100%;
      width: 82%;
      max-width: 320px;
      height: 100%;
      background: #0f172a;
      z-index: 1030;
      padding: 1.25rem;
      transition: right 0.3s ease;
      overflow-y: auto;
    }
    .mobile-drawer.open { right: 0; }
    .mobile-drawer-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--border);
      margin-bottom: 1rem;
    }
    .drawer-close { background: none; border: none; color: #fff; font-size: 1.4rem; cursor: pointer; }
    .mobile-acc-btn {
      width: 100%;
      text-align: left;
      background: none;
      border: none;
      color: #f3f4f6;
      font-weight: 700;
      padding: 0.7rem 0;
      display: flex;
      justify-content: space-between;
      align-items: center;
      cursor: pointer;
    }
    .mobile-sub-menu { display: none; list-style: none; padding-left: 0.85rem; }
    .mobile-acc-item.expanded .mobile-sub-menu { display: block; }
    .mobile-sub-menu a { display: block; padding: 0.45rem 0; color: #9ca3af; font-size: 0.88rem; }

    /* Layout & Containers */
    .layout-wrap { max-width: 1160px; margin: 0 auto; padding: 0 1.25rem; }
    
    /* Modern Hero Header */
    .hero-panel {
      text-align: center;
      padding: 3rem 1rem 2rem;
    }
    .badge-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: rgba(37, 99, 235, 0.15);
      border: 1px solid rgba(59, 130, 246, 0.35);
      color: #60a5fa;
      padding: 0.25rem 0.8rem;
      border-radius: 30px;
      font-size: 0.78rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 1rem;
    }
    .hero-panel h1 {
      font-size: clamp(1.85rem, 4vw, 2.8rem);
      font-weight: 800;
      letter-spacing: -0.03em;
      line-height: 1.2;
      margin-bottom: 0.75rem;
      background: linear-gradient(180deg, #ffffff 40%, #94a3b8 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .hero-panel p {
      color: var(--text-muted);
      max-width: 680px;
      margin: 0 auto;
      font-size: 1rem;
    }

    /* Calculator Glass Card */
    .glass-calculator {
      background: var(--surface-glass);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 2rem;
      box-shadow: 0 20px 40px -10px rgba(0,0,0,0.5);
      backdrop-filter: blur(12px);
      margin-bottom: 3.5rem;
    }
    .calc-controls-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1.25rem;
    }
    .form-ctrl {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
    .form-ctrl label {
      font-size: 0.82rem;
      font-weight: 700;
      color: #e5e7eb;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }
    .form-ctrl input, .form-ctrl select {
      background: #1f2937;
      border: 1.5px solid #374151;
      color: #fff;
      padding: 0.75rem 0.9rem;
      border-radius: var(--radius-sm);
      font-size: 0.95rem;
      font-weight: 600;
      outline: none;
      transition: all 0.2s;
    }
    .form-ctrl input:focus, .form-ctrl select:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.25);
    }

    /* Instant Real-Time KPI Cards */
    .kpi-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      margin-top: 1.75rem;
    }
    .kpi-card {
      background: rgba(31, 41, 55, 0.6);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 1.25rem;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .kpi-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: var(--border);
    }
    .kpi-card.highlight::before {
      background: var(--primary-gradient);
    }
    .kpi-title {
      font-size: 0.76rem;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
      margin-bottom: 0.35rem;
    }
    .kpi-value {
      font-size: 1.5rem;
      font-weight: 800;
      color: #fff;
    }
    .kpi-card.highlight .kpi-value {
      color: #38bdf8;
    }

    /* Horizontal Multiplier Chips */
    .chip-bar {
      display: flex;
      gap: 0.5rem;
      overflow-x: auto;
      padding: 0.75rem 0 0.5rem;
      scrollbar-width: none;
    }
    .chip-bar::-webkit-scrollbar { display: none; }
    .chip-btn {
      background: #1f2937;
      border: 1px solid #374151;
      color: #d1d5db;
      padding: 0.55rem 1.1rem;
      border-radius: 30px;
      font-size: 0.85rem;
      font-weight: 700;
      white-space: nowrap;
      cursor: pointer;
      transition: all 0.15s;
    }
    .chip-btn.active {
      background: #2563eb;
      border-color: #3b82f6;
      color: #fff;
      box-shadow: 0 0 12px rgba(37, 99, 235, 0.4);
    }

    /* Modern Table Container */
    .panel {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 2rem;
      margin-bottom: 3rem;
    }
    .panel h2 {
      font-size: 1.55rem;
      font-weight: 800;
      margin-bottom: 0.5rem;
      letter-spacing: -0.02em;
    }
    .panel p.desc {
      color: var(--text-muted);
      margin-bottom: 1.5rem;
      font-size: 0.95rem;
    }
    .table-container {
      overflow-x: auto;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
    }
    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 0.9rem;
    }
    th, td {
      padding: 0.85rem 1rem;
      border-bottom: 1px solid var(--border);
    }
    th {
      background: #1a2234;
      color: #9ca3af;
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    tr:last-child td { border-bottom: none; }
    tr:hover td { background: rgba(255,255,255,0.02); }

    /* Level Badges Grid */
    .level-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
      gap: 0.6rem;
      margin-top: 1rem;
    }
    .level-pill {
      background: #1f2937;
      border: 1px solid #374151;
      padding: 0.75rem 0.5rem;
      border-radius: var(--radius-sm);
      text-align: center;
      cursor: pointer;
      transition: all 0.2s;
    }
    .level-pill:hover {
      border-color: var(--primary);
      transform: translateY(-2px);
      background: #273549;
    }
    .level-pill strong { display: block; font-size: 0.95rem; color: #fff; }
    .level-pill span { font-size: 0.76rem; color: var(--text-muted); }

    /* FAQ System */
    .faq-item {
      border-bottom: 1px solid var(--border);
      padding: 1rem 0;
    }
    .faq-q {
      font-weight: 700;
      color: #f3f4f6;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 1rem;
      user-select: none;
    }
    .faq-a {
      display: none;
      padding-top: 0.6rem;
      color: var(--text-muted);
      font-size: 0.92rem;
      line-height: 1.65;
    }
    .faq-item.open .faq-a { display: block; }
    .faq-item.open .faq-toggle { transform: rotate(180deg); }
    .faq-toggle { transition: transform 0.2s; font-size: 0.75rem; }

    /* Sticky Mobile Calculation Bar */
    .mobile-sticky-bar {
      display: none;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: rgba(15, 23, 42, 0.95);
      border-top: 1px solid var(--border);
      backdrop-filter: blur(12px);
      padding: 0.75rem 1.25rem;
      z-index: 990;
      justify-content: space-between;
      align-items: center;
    }
    .mobile-sticky-bar .lbl { font-size: 0.74rem; color: var(--text-muted); text-transform: uppercase; }
    .mobile-sticky-bar .val { font-size: 1.2rem; font-weight: 800; color: #38bdf8; }
    @media (max-width: 768px) {
      .mobile-sticky-bar { display: flex; }
      body { padding-bottom: 4rem; }
    }

    /* Minimalist Footer */
    footer {
      border-top: 1px solid var(--border);
      padding: 3rem 1.25rem 2rem;
      margin-top: 4rem;
      font-size: 0.84rem;
      color: #6b7280;
    }
    .footer-inner {
      max-width: 1160px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }
    .footer-links a { color: #9ca3af; margin-left: 1rem; }
    .footer-links a:hover { color: #fff; }
  </style>
</head>
