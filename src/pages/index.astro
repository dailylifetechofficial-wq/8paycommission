  <!-- LIGHTWEIGHT REAL-TIME JAVASCRIPT -->
  <script is:inline>
    // Mobile Drawer Controls
    const menuBtn = document.getElementById('menuBtn');
    const drawer = document.getElementById('drawer');
    const backdrop = document.getElementById('backdrop');
    const drawerClose = document.getElementById('drawerClose');

    function toggleNav(show) {
      if (show) {
        drawer.classList.add('open');
        backdrop.classList.add('active');
      } else {
        drawer.classList.remove('open');
        backdrop.classList.remove('active');
      }
    }

    menuBtn.addEventListener('click', () => toggleNav(true));
    drawerClose.addEventListener('click', () => toggleNav(false));
    backdrop.addEventListener('click', () => toggleNav(false));

    // Drawer Submenus
    document.querySelectorAll('.mobile-acc-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        btn.parentElement.classList.toggle('expanded');
      });
    });

    // Real-Time Salary Engine
    const basicInput = document.getElementById('basicPayInput');
    const fitmentSelect = document.getElementById('customFitment');
    const citySelect = document.getElementById('cityTierSelect');
    const levelSelect = document.getElementById('matrixLevelSelect');

    const kpiBasic = document.getElementById('kpiBasic');
    const kpiHra = document.getElementById('kpiHra');
    const kpiGross = document.getElementById('kpiGross');
    const stickyGross = document.getElementById('stickyGross');

    function compute() {
      const basic = parseFloat(basicInput.value) || 0;
      const fitment = parseFloat(fitmentSelect.value) || 2.86;
      const hraRate = parseFloat(citySelect.value) || 0.30;

      const revisedBasic = Math.round(basic * fitment);
      const revisedHra = Math.round(revisedBasic * hraRate);
      const ta = basic >= 35400 ? 3600 : 1350;
      const gross = revisedBasic + revisedHra + ta;

      kpiBasic.textContent = '₹' + revisedBasic.toLocaleString('en-IN');
      kpiHra.textContent = '₹' + revisedHra.toLocaleString('en-IN');
      kpiGross.textContent = '₹' + gross.toLocaleString('en-IN');
      stickyGross.textContent = '₹' + gross.toLocaleString('en-IN');
    }

    // Input Event Listeners for Live Calculating
    basicInput.addEventListener('input', compute);
    fitmentSelect.addEventListener('change', compute);
    citySelect.addEventListener('change', compute);

    // Preset Level Picker
    levelSelect.addEventListener('change', (e) => {
      basicInput.value = e.target.value;
      compute();
    });

    // Chip Bar Multiplier
    const chips = document.querySelectorAll('.chip-btn[data-factor]');
    chips.forEach(chip => {
      chip.addEventListener('click', () => {
        chips.forEach(c => c.classList.remove('active'));
        chip.classList.add('active');
        fitmentSelect.value = chip.getAttribute('data-factor');
        compute();
      });
    });

    // Quick Matrix Level Pills
    document.querySelectorAll('.level-pill').forEach(pill => {
      pill.addEventListener('click', () => {
        const val = pill.getAttribute('data-base');
        basicInput.value = val;
        levelSelect.value = val;
        compute();
        document.getElementById('calculator').scrollIntoView({ behavior: 'smooth' });
      });
    });

    // FAQ Accordion
    document.querySelectorAll('.faq-q').forEach(q => {
      q.addEventListener('click', () => {
        q.parentElement.classList.toggle('open');
      });
    });

    // Initial Run
    compute();
  </script>
</body>
</html>
