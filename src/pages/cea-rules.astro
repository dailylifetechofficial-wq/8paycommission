  </main>

  <!-- STICKY MOBILE SUMMARY BAR -->
  <div class="mobile-sticky-bar">
    <div>
      <div class="lbl">Annual CEA Reimbursement</div>
      <div class="val" id="stickyTotalClaim">₹67,500</div>
    </div>
    <a href="#childCountSelect" class="chip-btn active" style="padding: 0.45rem 0.95rem; font-size: 0.82rem;">Recalculate</a>
  </div>

  <!-- CLIENT-SIDE COMPUTATION JAVASCRIPT -->
  <script is:inline>
    const childCountSelect = document.getElementById('childCountSelect');
    const hostelEligibleCount = document.getElementById('hostelEligibleCount');
    const divyangjanStatus = document.getElementById('divyangjanStatus');
    const customCeaMonthly = document.getElementById('customCeaMonthly');

    const dispAnnualCea = document.getElementById('dispAnnualCea');
    const dispAnnualHostel = document.getElementById('dispAnnualHostel');
    const dispTotalClaim = document.getElementById('dispTotalClaim');
    const stickyTotalClaim = document.getElementById('stickyTotalClaim');

    const slipCeaRate = document.getElementById('slipCeaRate');
    const slipDivyangRate = document.getElementById('slipDivyangRate');
    const slipCeaTotal = document.getElementById('slipCeaTotal');
    const slipHostelRate = document.getElementById('slipHostelRate');
    const slipHostelTotal = document.getElementById('slipHostelTotal');
    const slipFinalClaim = document.getElementById('slipFinalClaim');
    const slipScenarioLabel = document.getElementById('slipScenarioLabel');

    function calculateCEA() {
      const totalChildren = parseInt(childCountSelect.value) || 1;
      const hostelChildren = Math.min(parseInt(hostelEligibleCount.value) || 0, totalChildren);
      const divyangChildren = Math.min(parseInt(divyangjanStatus.value) || 0, totalChildren);
      const normalChildren = Math.max(0, totalChildren - divyangChildren);

      const monthlyCeaBase = parseFloat(customCeaMonthly.value) || 2812.5;
      const monthlyHostelBase = monthlyCeaBase * 3; // Statutory 3x multiplier
      const monthlyDivyangCea = monthlyCeaBase * 2; // Statutory 2x multiplier

      // Annual Totals
      const annualNormalCea = normalChildren * (monthlyCeaBase * 12);
      const annualDivyangCea = divyangChildren * (monthlyDivyangCea * 12);
      const annualCea = annualNormalCea + annualDivyangCea;
      const annualHostel = hostelChildren * (monthlyHostelBase * 12);
      const totalClaim = annualCea + annualHostel;

      // Update KPI Cards
      dispAnnualCea.textContent = '₹' + annualCea.toLocaleString('en-IN');
      dispAnnualHostel.textContent = '₹' + annualHostel.toLocaleString('en-IN');
      dispTotalClaim.textContent = '₹' + totalClaim.toLocaleString('en-IN');
      if (stickyTotalClaim) stickyTotalClaim.textContent = '₹' + totalClaim.toLocaleString('en-IN');

      // Update Breakdown Table
      slipCeaRate.textContent = '₹' + monthlyCeaBase.toLocaleString('en-IN') + ' / month';
      slipDivyangRate.textContent = '₹' + monthlyDivyangCea.toLocaleString('en-IN') + ' / month';
      slipCeaTotal.textContent = '₹' + annualCea.toLocaleString('en-IN');
      slipHostelRate.textContent = '₹' + monthlyHostelBase.toLocaleString('en-IN') + ' / month';
      slipHostelTotal.textContent = '₹' + annualHostel.toLocaleString('en-IN');
      slipFinalClaim.textContent = '₹' + totalClaim.toLocaleString('en-IN');

      // Update Subtitle Label
      slipScenarioLabel.textContent = `${totalChildren} Children (${divyangChildren} Divyangjan) • ${hostelChildren} in Hostel`;
    }

    // Input Listeners
    childCountSelect.addEventListener('change', calculateCEA);
    hostelEligibleCount.addEventListener('change', calculateCEA);
    divyangjanStatus.addEventListener('change', calculateCEA);
    customCeaMonthly.addEventListener('input', calculateCEA);

    // Preset Chip Buttons
    const pills = document.querySelectorAll('#ratePills .chip-btn');
    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        pills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        customCeaMonthly.value = pill.getAttribute('data-cea');
        calculateCEA();
      });
    });

    // FAQ Accordion Toggle
    document.querySelectorAll('.faq-quest').forEach(q => {
      q.addEventListener('click', () => {
        q.parentElement.classList.toggle('open');
      });
    });

    // Initial Execution
    calculateCEA();
  </script>

</body>
</html>
