// src/pages/cea-rules.astro
const siteUrl = "https://8paycommission.com";
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const pageTitle = "Children Education Allowance (CEA) Rules: 7th & 8th CPC Rates, Slabs & Claim Process";
const pageDescription = "Complete guide to Children Education Allowance (CEA) and Hostel Subsidy for Central Government employees. Explore revised rates, 25% DA trigger hikes, Divyangjan benefits, and claim procedures.";

// CEA and Hostel Subsidy Rate Progression Table
const allowanceSlabs = [
  { stage: "7th CPC Base Rate (2016)", daStatus: "0% – 49% DA", ceaPerChild: "₹2,250 / mo (₹27,000 / yr)", hostelPerChild: "₹6,750 / mo (₹81,000 / yr)", divyangjanRate: "₹4,500 / mo (₹54,000 / yr)" },
  { stage: "7th CPC Restored Rate (Current)", daStatus: "50%+ DA Trigger", ceaPerChild: "₹2,812.50 / mo (₹33,750 / yr)", hostelPerChild: "₹8,437.50 / mo (₹1,01,250 / yr)", divyangjanRate: "₹5,625 / mo (₹67,500 / yr)" },
  { stage: "8th CPC Projected Baseline (2.25x)", daStatus: "0% DA Reset", ceaPerChild: "₹5,000 / mo (₹60,000 / yr)", hostelPerChild: "₹15,000 / mo (₹1,80,000 / yr)", divyangjanRate: "₹10,000 / mo (₹1,20,000 / yr)" },
  { stage: "8th CPC Federation Target (2.86x)", daStatus: "Target Demand", ceaPerChild: "₹6,500 / mo (₹78,000 / yr)", hostelPerChild: "₹19,500 / mo (₹2,34,000 / yr)", divyangjanRate: "₹13,000 / mo (₹1,56,000 / yr)" }
];

const faqs = [
  {
    q: "How many children are eligible for Children Education Allowance (CEA)?",
    a: "Under Department of Personnel and Training (DoPT) guidelines, CEA and Hostel Subsidy are admissible for up to two eldest surviving children. An exception is made if the second childbirth results in twins or triplets, in which case the allowance is admissible for all children born in that multiple birth."
  },
  {
    q: "What classes or age groups are covered under the CEA scheme?",
    a: "CEA is admissible from nursery (two classes preceding Class 1) up to Class 12. The age limit is 20 years for normally abled children or until passing Class 12, whichever is earlier. For children with disabilities (Divyangjan), the age ceiling is relaxed up to 22 years."
  },
  {
    q: "What documents are required to claim CEA reimbursement annually?",
    a: "Employees need only submit a standardized certificate from the head of the educational institution confirming that the child studied in the school during the preceding academic year. Alternatively, self-attested copies of the report card or fee receipts confirming full fee payment can be submitted."
  },
  {
    q: "What is the condition for claiming Hostel Subsidy alongside CEA?",
    a: "Hostel Subsidy is admissible only if the child studies in a residential school located at least 50 kilometers away from the government servant's official residence and duty station. Submission of a bonafide certificate confirming boarding and lodging expenditures is mandatory."
  },
  {
    q: "Can both husband and wife claim CEA if both are government employees?",
    a: "No. If both spouses are employed in central government, state government, or autonomous bodies, only one parent is legally eligible to draw Children Education Allowance and Hostel Subsidy for their qualifying children."
  }
];
