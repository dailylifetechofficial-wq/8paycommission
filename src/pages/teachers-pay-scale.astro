---
// src/pages/teachers-pay-scale.astro
const siteUrl = "https://8paycommission.com";
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const pageTitle = "Teachers & University Faculty Pay Scale: 7th & 8th CPC UGC Academic Matrix (2026)";
const pageDescription = "Explore the Teachers & Faculty Pay Matrix for School Teachers (PRT/TGT/PGT), Central Universities (UGC AL-10 to AL-15), CAS promotions, Ph.D. advance increments, and 8th CPC projections.";

// Comprehensive School & Higher Education Faculty Cadre Benchmarks
const academicCadres = [
  { level: "Level 6", academicLevel: "School Tier", agp: "GP 4200", sector: "KVS / NVS / State", post: "Primary Teacher (PRT)", base7th: 35400, base8th_225: 79650, base8th_286: 101244, maxStages: 40 },
  { level: "Level 7", academicLevel: "School Tier", agp: "GP 4600", sector: "KVS / NVS / State", post: "Trained Graduate Teacher (TGT)", base7th: 44900, base8th_225: 101025, base8th_286: 128414, maxStages: 40 },
  { level: "Level 8", academicLevel: "School Tier", agp: "GP 4800", sector: "KVS / NVS / State", post: "Post Graduate Teacher (PGT)", base7th: 47600, base8th_225: 107100, base8th_286: 136136, maxStages: 40 },
  { level: "Level 10", academicLevel: "Academic Level 10", agp: "AGP 6000", sector: "UGC / Central Univ", post: "Assistant Professor (Entry / Stage 1)", base7th: 57700, base8th_225: 129825, base8th_286: 165022, maxStages: 40 },
  { level: "Level 11", academicLevel: "Academic Level 11", agp: "AGP 7000", sector: "UGC / Central Univ", post: "Assistant Professor (Senior Scale / Stage 2)", base7th: 68900, base8th_225: 155025, base8th_286: 197054, maxStages: 39 },
  { level: "Level 12", academicLevel: "Academic Level 12", agp: "AGP 8000", sector: "UGC / Central Univ", post: "Assistant Professor (Selection Grade / Stage 3)", base7th: 79800, base8th_225: 179550, base8th_286: 228228, maxStages: 34 },
  { level: "Level 12", academicLevel: "School Admin", agp: "GP 7600", sector: "KVS / NVS / CBSE", post: "School Vice Principal", base7th: 78800, base8th_225: 177300, base8th_286: 225368, maxStages: 34 },
  { level: "Level 13A", academicLevel: "Academic Level 13A", agp: "AGP 9000", sector: "UGC / Central Univ", post: "Associate Professor (Stage 4)", base7th: 131400, base8th_225: 295650, base8th_286: 375804, maxStages: 18 },
  { level: "Level 14", academicLevel: "Academic Level 14", agp: "AGP 10000", sector: "UGC / Central Univ", post: "Professor (Stage 5) / College Principal", base7th: 144200, base8th_225: 324450, base8th_286: 412412, maxStages: 16 },
  { level: "Level 15", academicLevel: "Academic Level 15", agp: "HAG Scale", sector: "UGC / Apex Institute", post: "Senior Professor (Stage 6) / Director", base7th: 182200, base8th_225: 409950, base8th_286: 521092, maxStages: 8 },
  { level: "Level 17", academicLevel: "Apex Executive", agp: "Apex Scale", sector: "Central University", post: "Vice Chancellor (VC) of Central University", base7th: 225000, base8th_225: 506250, base8th_286: 643500, maxStages: 1 }
];

const faqs = [
  {
    q: "How does the UGC Academic Pay Matrix differ from the standard Civil Services Matrix?",
    a: "The UGC Academic Pay Matrix specifically aligns with higher education qualification requirements. For example, while standard civil Group-A entry begins at Level 10 with a starting basic of ₹56,100, the UGC Academic Level 10 for Assistant Professors starts higher at ₹57,700 to reward mandatory post-graduate research and UGC-NET/SLET credentials. Additionally, Academic Level 13A (Associate Professor) starts at ₹1,31,400 rather than civil Level 13's ₹1,23,100."
  },
  {
    q: "How does Career Advancement Scheme (CAS) promotion operate across academic levels?",
    a: "CAS promotions advance teaching faculty through defined stages without needing a vacancy opening: Assistant Professor moves from AL-10 to AL-11, then to AL-12, before competing for Associate Professor (AL-13A) and Professor (AL-14). Progression requires satisfying annual API/PBAS research output benchmarks, student feedback thresholds, and completion of mandatory Orientation/Refresher faculty development programs."
  },
  {
    q: "Are advance increments granted for holding Ph.D. or M.Phil degrees?",
    a: "Yes. Under UGC regulations, direct recruits entering as Assistant Professors holding a Ph.D. degree receive five non-compounded advance increments at entry. Recruits holding M.Phil degrees or M.Tech/LLM qualifications receive two advance increments. Serving faculty who acquire a Ph.D. degree while in service receive three non-compounded advance increments."
  },
  {
    q: "Do school teachers in KVS, NVS, and State boards receive Central Pay Commission scales?",
    a: "Yes. Teachers in Kendriya Vidyalayas (KVS), Navodaya Vidyalayas (NVS), and Central Tibetan Schools receive direct central pay parity: PRT (Level 6: ₹35,400), TGT (Level 7: ₹44,900), and PGT (Level 8: ₹47,600). State government school teachers traditionally adopt identical matrix levels following dedicated State Pay Committee or Cabinet notifications."
  },
  {
    q: "What is the expected 8th Pay Commission starting basic pay for school teachers and professors?",
    a: "Under projected 8th CPC fitment multipliers (2.25x to 2.86x), Primary Teachers (PRT - Level 6) are projected to adjust to ₹79,650 – ₹101,244; PGT teachers (Level 8) to ₹107,100 – ₹136,136; and entry-level Assistant Professors (UGC AL-10) to ₹129,825 – ₹165,022."
  }
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <meta name="keywords" content="teachers pay scale 8th pay commission, ugc 7th cpc pay matrix table, assistant professor salary calculator, kvs nvs prt tgt pgt salary structure, academic level 10 to 15 ugc, cas promotion rules teachers" />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:locale" content="en_IN" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="8th Pay Commission Portal" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Schema.org WebPage + FAQPage -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebPage",
        "name": pageTitle,
        "url": canonicalURL.toString(),
        "description": pageDescription,
        "inLanguage": "en-IN"
      },
      {
        "@type": "FAQPage",
        "mainEntity": faqs.map((f) => ({
          "@type": "Question",
          "name": f.q,
          "acceptedAnswer": { "@type": "Answer", "text": f.a }
        }))
      }
    ]
  })} />

  <style>
    :root {
      --bg: #f8fafc;
      --surface: #ffffff;
      --surface-subtle: #f1f5f9;
      --border: #e2e8f0;
      --primary: #1d4ed8;
      --primary-hover: #1e40af;
      --primary-gradient: linear-gradient(135deg, #1d4ed8 0%, #0284c7 100%);
      --text: #0f172a;
      --text-muted: #64748b;
      --accent-green: #15803d;
      --accent-green-bg: #dcfce7;
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.05);
      --shadow-md: 0 4px 12px -2px rgba(15, 23, 42, 0.08);
      --shadow-lg: 0 16px 32px -4px rgba(15, 23, 42, 0.08);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; }
    body { background: var(--bg); color: var(--text); line-height: 1.7; font-size: 15px; -webkit-font-smoothing: antialiased; }
    a { color: var(--primary); text-decoration: none; transition: color 0.2s ease; }
    a:hover { color: var(--primary-hover); }

    .layout-wrap { max-width: 1160px; margin: 0 auto; padding: 0 1.25rem; }

    /* Hero Header */
    .hero-header {
      text-align: center;
      padding: 3rem 1rem 1.75rem;
    }
    .badge-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: #eff6ff;
      border: 1px solid #bfdbfe;
      color: #1d4ed8;
      padding: 0.25rem 0.85rem;
      border-radius: 30px;
      font-size: 0.78rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.85rem;
    }
    .hero-header h1 {
      font-size: clamp(1.85rem, 4vw, 2.75rem);
      font-weight: 800;
      letter-spacing: -0.035em;
      line-height: 1.22;
      margin-bottom: 0.75rem;
      color: var(--text);
    }
    .hero-header p {
      color: var(--text-muted);
      max-width: 780px;
      margin: 0 auto;
      font-size: 1.05rem;
    }

    /* Calculator Main Box */
    .calc-box {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 2rem;
      box-shadow: var(--shadow-lg);
      margin-bottom: 3.5rem;
    }
    .chip-bar {
      display: flex;
      gap: 0.5rem;
      overflow-x: auto;
      padding: 0.5rem 0 1.25rem;
      scrollbar-width: none;
    }
    .chip-bar::-webkit-scrollbar { display: none; }
    .chip-btn {
      background: #f1f5f9;
      border: 1px solid var(--border);
      color: #475569;
      padding: 0.5rem 1.1rem;
      border-radius: 30px;
      font-size: 0.84rem;
      font-weight: 700;
      white-space: nowrap;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .chip-btn:hover { background: #e2e8f0; }
    .chip-btn.active {
      background: var(--primary);
      border-color: var(--primary);
      color: #ffffff;
      box-shadow: 0 2px 8px rgba(29, 78, 216, 0.3);
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1.25rem;
      margin-bottom: 1.5rem;
    }
    .form-item {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
    .form-item label {
      font-size: 0.82rem;
      font-weight: 700;
      color: #334155;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }
    .form-item input, .form-item select {
      background: #ffffff;
      border: 1.5px solid #cbd5e1;
      color: var(--text);
      padding: 0.75rem 0.9rem;
      border-radius: var(--radius-sm);
      font-size: 0.96rem;
      font-weight: 600;
      outline: none;
      transition: all 0.2s;
    }
    .form-item input:focus, .form-item select:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
    }

    /* Live Summary Cards */
    .summary-cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      margin-bottom: 1.5rem;
    }
    .kpi-unit {
      background: #f8fafc;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 1.25rem;
      text-align: center;
      position: relative;
    }
    .kpi-unit.highlight {
      background: #eff6ff;
      border-color: #bfdbfe;
    }
    .kpi-unit.success {
      background: var(--accent-green-bg);
      border-color: #86efac;
    }
    .kpi-unit .kpi-label {
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
      margin-bottom: 0.35rem;
    }
    .kpi-unit .kpi-val {
      font-size: 1.45rem;
      font-weight: 800;
      color: var(--text);
    }
    .kpi-unit.highlight .kpi-val { color: var(--primary); }
    .kpi-unit.success .kpi-val { color: var(--accent-green); }

    /* Breakdown Box */
    .breakdown-box {
      background: #f8fafc;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 1.5rem;
      margin-top: 1.5rem;
    }
    .breakdown-title {
      font-weight: 800;
      font-size: 1rem;
      color: var(--text);
      margin-bottom: 0.85rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .breakdown-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.94rem;
    }
    .breakdown-table td {
      padding: 0.65rem 0.5rem;
      border-bottom: 1px dashed #cbd5e1;
    }
    .breakdown-table tr:last-child td { border-bottom: none; }
    .breakdown-table td.num {
      text-align: right;
      font-weight: 700;
    }

    /* Long-Form Content Area */
    .article-wrap {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 2.75rem;
      box-shadow: var(--shadow-sm);
      margin-bottom: 3.5rem;
    }
    .article-wrap h2 {
      font-size: 1.6rem;
      font-weight: 800;
      color: var(--text);
      letter-spacing: -0.025em;
      margin: 2.5rem 0 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 2px solid #eff6ff;
    }
    .article-wrap h3 {
      font-size: 1.25rem;
      font-weight: 700;
      color: #1e293b;
      margin: 1.6rem 0 0.65rem;
    }
    .article-wrap p {
      margin-bottom: 1.25rem;
      color: #334155;
      font-size: 1.02rem;
    }
    .article-wrap ul, .article-wrap ol {
      margin-bottom: 1.5rem;
      padding-left: 1.5rem;
      color: #334155;
    }
    .article-wrap li { margin-bottom: 0.45rem; }

    .formula-banner {
      background: #eff6ff;
      border-left: 4px solid var(--primary);
      padding: 1.15rem 1.35rem;
      border-radius: 0 8px 8px 0;
      margin: 1.5rem 0;
      font-family: monospace;
      font-size: 0.96rem;
      color: #1e40af;
    }

    /* Tables */
    .table-responsive {
      overflow-x: auto;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      margin: 1.5rem 0;
    }
    table.data-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 0.91rem;
    }
    table.data-table th, table.data-table td {
      padding: 0.8rem 0.95rem;
      border-bottom: 1px solid var(--border);
    }
    table.data-table th {
      background: #f8fafc;
      color: #475569;
      font-weight: 700;
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      white-space: nowrap;
    }
    table.data-table tr:hover td { background: #f8fafc; }

    /* FAQ */
    .faq-unit {
      border-bottom: 1px solid var(--border);
      padding: 1.15rem 0;
    }
    .faq-quest {
      font-weight: 700;
      color: var(--text);
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 1.02rem;
    }
    .faq-ans {
      display: none;
      padding-top: 0.65rem;
      color: #475569;
      font-size: 0.96rem;
      line-height: 1.7;
    }
    .faq-unit.open .faq-ans { display: block; }
    .faq-unit.open .faq-arrow { transform: rotate(180deg); }
    .faq-arrow { transition: transform 0.2s ease; font-size: 0.75rem; color: var(--text-muted); }

    /* Mobile Sticky Bar */
    .mobile-sticky-bar {
      display: none;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: rgba(255, 255, 255, 0.96);
      border-top: 1px solid var(--border);
      backdrop-filter: blur(12px);
      padding: 0.75rem 1.25rem;
      z-index: 990;
      justify-content: space-between;
      align-items: center;
      box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.06);
    }
    .mobile-sticky-bar .lbl { font-size: 0.74rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700; }
    .mobile-sticky-bar .val { font-size: 1.2rem; font-weight: 800; color: var(--primary); }
    @media (max-width: 768px) {
      .mobile-sticky-bar { display: flex; }
      body { padding-bottom: 4.5rem; }
    }

    /* Disclaimer */
    .disclaimer-strip {
      max-width: 1160px;
      margin: 2rem auto 4rem;
      padding: 1.25rem;
      background: #f8fafc;
      border: 1px solid var(--border);
      border-left: 4px solid #94a3b8;
      border-radius: var(--radius-sm);
      font-size: 0.82rem;
      line-height: 1.6;
      color: #64748b;
    }
  </style>
</head>
<body>

  <main class="layout-wrap">

    <!-- HERO HEADER -->
    <header class="hero-header">
      <div class="badge-pill">UGC, School Education & Academic Matrix Standards</div>
      <h1>Teachers & University Faculty Pay Scale (7th & 8th CPC)</h1>
      <p>Comprehensive guide and salary simulator for school educators (PRT/TGT/PGT in KVS/NVS) and higher education faculty (UGC Academic Levels 10 to 15 in Central Universities and IITs/NITs).</p>
    </header>

    <!-- INTERACTIVE TEACHERS SALARY CALCULATOR WIDGET -->
    <section class="calc-box" aria-label="Teachers and University Faculty Salary Calculation Widget">
      
      <!-- Quick Cadre Preset Chips -->
      <div style="margin-bottom: 1.25rem;">
        <span style="font-size: 0.8rem; font-weight: 700; color: #64748b; text-transform: uppercase;">Select Academic Post Preset:</span>
        <div class="chip-bar" id="cadrePills">
          <button class="chip-btn" data-base="35400" data-post="Primary Teacher (PRT - Level 6)" data-adv="0">PRT School (Level 6)</button>
          <button class="chip-btn" data-base="44900" data-post="Trained Graduate Teacher (TGT - Level 7)" data-adv="0">TGT School (Level 7)</button>
          <button class="chip-btn" data-base="47600" data-post="Post Graduate Teacher (PGT - Level 8)" data-adv="0">PGT School (Level 8)</button>
          <button class="chip-btn active" data-base="57700" data-post="Assistant Professor (UGC AL-10 Entry)" data-adv="5">Assistant Prof (AL-10 + Ph.D.)</button>
          <button class="chip-btn" data-base="131400" data-post="Associate Professor (UGC AL-13A)" data-adv="0">Associate Prof (AL-13A)</button>
          <button class="chip-btn" data-base="144200" data-post="Professor (UGC AL-14)" data-adv="0">Professor (AL-14)</button>
        </div>
      </div>

      <!-- Controls Grid -->
      <div class="form-grid">
        <div class="form-item">
          <label for="acadCadreSelect">Teaching / Academic Cadre Post</label>
          <select id="acadCadreSelect">
            {academicCadres.map((c) => (
              <option value={c.base7th} data-post={c.post} data-level={c.level} data-acad={c.academicLevel} selected={c.post.startsWith("Assistant Professor (Entry")}>
                {c.academicLevel} - {c.post} (7th Base: ₹{c.base7th.toLocaleString('en-IN')})
              </option>
            ))}
          </select>
        </div>

        <div class="form-item">
          <label for="acadBasicInput">7th CPC Matrix Basic Pay (₹)</label>
          <input type="number" id="acadBasicInput" value="57700" min="35400" step="100" />
        </div>

        <div class="form-item">
          <label for="acadFitmentSelect">Simulated Fitment Multiplier</label>
          <select id="acadFitmentSelect">
            <option value="1.00">7th CPC Current Scale (1.00x)</option>
            <option value="2.25">2.25x (Conservative Model)</option>
            <option value="2.57">2.57x (7th CPC Parity)</option>
            <option value="2.86" selected>2.86x (Federation Target)</option>
          </select>
        </div>

        <div class="form-item">
          <label for="phdIncrementSelect">Ph.D. / M.Phil Advance Increments</label>
          <select id="phdIncrementSelect">
            <option value="0">None / Nil Advance Increments</option>
            <option value="2">2 Increments (M.Phil / M.Tech entry)</option>
            <option value="3">3 Increments (Ph.D. acquired in-service)</option>
            <option value="5" selected>5 Increments (Direct Entry with Ph.D.)</option>
          </select>
        </div>

        <div class="form-item">
          <label for="acadCityTier">Duty Station City Tier (HRA Rate)</label>
          <select id="acadCityTier">
            <option value="0.30" selected>Class X (30% - Metro: Delhi, Mumbai, Bengaluru)</option>
            <option value="0.20">Class Y (20% - Tier-2 / University Towns)</option>
            <option value="0.10">Class Z (10% - Small Towns / Rural Campuses)</option>
          </select>
        </div>
      </div>

      <!-- Live Summary KPI Cards -->
      <div class="summary-cards">
        <div class="kpi-unit">
          <div class="kpi-label">Base Academic Starting Pay</div>
          <div class="kpi-val" id="dispEntryBasic">₹1,65,022</div>
        </div>
        <div class="kpi-unit highlight">
          <div class="kpi-label">Pay with Advance Increments</div>
          <div class="kpi-val" id="dispAugmentedBasic">₹1,91,304</div>
        </div>
        <div class="kpi-unit success">
          <div class="kpi-label">Projected Monthly Gross</div>
          <div class="kpi-val" id="dispGrossSalary">₹2,55,895</div>
        </div>
      </div>

      <!-- Detailed Breakdown Slip -->
      <div class="breakdown-box">
        <div class="breakdown-title">
          <span>Monthly Academic Emoluments Calculation Breakdown</span>
          <span style="color: var(--primary); font-size: 0.85rem;" id="slipPostLabel">Academic Level 10 • Assistant Professor</span>
        </div>
        <table class="breakdown-table">
          <tbody>
            <tr>
              <td>Standard Entry Basic Pay in Academic Matrix (Basic × Fitment)</td>
              <td class="num" id="slipEntryBase">₹1,65,022</td>
            </tr>
            <tr>
              <td>Advance Increments Addition (3% compounded per qualification stage)</td>
              <td class="num" id="slipAdvAddition">+₹26,282</td>
            </tr>
            <tr style="font-weight: 700; background: #f8fafc;">
              <td>Total Consolidated Academic Basic Pay</td>
              <td class="num" id="slipConsolidatedBase" style="color: var(--primary);">₹1,91,304</td>
            </tr>
            <tr>
              <td>Dearness Allowance (DA) — <span style="color: var(--text-muted);">Reset to 0% at 8th CPC Launch</span></td>
              <td class="num">₹0</td>
            </tr>
            <tr>
              <td>House Rent Allowance (HRA @ Selected City Tier on Augmented Base)</td>
              <td class="num" id="slipHra">₹57,391</td>
            </tr>
            <tr>
              <td>Transport Allowance (TA based on academic pay tier: ₹7,200)</td>
              <td class="num" id="slipTa">₹7,200</td>
            </tr>
            <tr style="font-weight: 800; background: var(--accent-green-bg);">
