  <!-- CLIENT-SIDE COMPUTATION JAVASCRIPT -->
  <script is:inline>
    const acadCadreSelect = document.getElementById('acadCadreSelect');
    const acadBasicInput = document.getElementById('acadBasicInput');
    const acadFitmentSelect = document.getElementById('acadFitmentSelect');
    const phdIncrementSelect = document.getElementById('phdIncrementSelect');
    const acadCityTier = document.getElementById('acadCityTier');

    const dispEntryBasic = document.getElementById('dispEntryBasic');
    const dispAugmentedBasic = document.getElementById('dispAugmentedBasic');
    const dispGrossSalary = document.getElementById('dispGrossSalary');
    const stickyGross = document.getElementById('stickyGross');

    const slipEntryBase = document.getElementById('slipEntryBase');
    const slipAdvAddition = document.getElementById('slipAdvAddition');
    const slipConsolidatedBase = document.getElementById('slipConsolidatedBase');
    const slipHra = document.getElementById('slipHra');
    const slipTa = document.getElementById('slipTa');
    const slipFinalGross = document.getElementById('slipFinalGross');
    const slipPostLabel = document.getElementById('slipPostLabel');

    function calculateAcademicPay() {
      const basic = parseFloat(acadBasicInput.value) || 0;
      const fitment = parseFloat(acadFitmentSelect.value) || 1.0;
      const advanceIncrements = parseInt(phdIncrementSelect.value) || 0;
      const hraRate = parseFloat(acadCityTier.value) || 0.30;

      // Arithmetic Engine
      const revisedEntryBase = Math.round(basic * fitment);

      // Compounding 3% for advance increments
      let augmentedBase = revisedEntryBase;
      for (let i = 0; i < advanceIncrements; i++) {
        augmentedBase = Math.round((augmentedBase * 1.03) / 100) * 100;
      }

      const advanceAddition = augmentedBase - revisedEntryBase;
      const hraAmount = Math.round(augmentedBase * hraRate);

      // Transport Allowance Baseline (Officers / AL-10+ = ₹7,200; School Levels 6-8 = ₹3,600)
      const isHigherFaculty = basic >= 57700;
      const baseTa = isHigherFaculty ? 7200 : 3600;

      const totalGross = augmentedBase + hraAmount + baseTa;

      // Update KPI Cards
      dispEntryBasic.textContent = '₹' + revisedEntryBase.toLocaleString('en-IN');
      dispAugmentedBasic.textContent = '₹' + augmentedBase.toLocaleString('en-IN');
      dispGrossSalary.textContent = '₹' + totalGross.toLocaleString('en-IN');
      if (stickyGross) stickyGross.textContent = '₹' + totalGross.toLocaleString('en-IN');

      // Update Breakdown Table
      slipEntryBase.textContent = '₹' + revisedEntryBase.toLocaleString('en-IN');
      slipAdvAddition.textContent = advanceIncrements > 0 ? '+₹' + advanceAddition.toLocaleString('en-IN') + ` (${advanceIncrements} Increments)` : '₹0';
      slipConsolidatedBase.textContent = '₹' + augmentedBase.toLocaleString('en-IN');
      slipHra.textContent = '₹' + hraAmount.toLocaleString('en-IN');
      slipTa.textContent = '₹' + baseTa.toLocaleString('en-IN');
      slipFinalGross.textContent = '₹' + totalGross.toLocaleString('en-IN');

      // Update Subtitle Label
      const selectedOption = acadCadreSelect.options[acadCadreSelect.selectedIndex];
      if (selectedOption) {
        const postName = selectedOption.getAttribute('data-post') || 'Academic Post';
        const acadLevel = selectedOption.getAttribute('data-acad') || 'Level';
        slipPostLabel.textContent = `${acadLevel} • ${postName} • ${advanceIncrements > 0 ? advanceIncrements + ' Adv Inc' : 'Regular'}`;
      }
    }

    // Input Listeners
    acadBasicInput.addEventListener('input', calculateAcademicPay);
    acadCadreSelect.addEventListener('change', (e) => {
      acadBasicInput.value = e.target.value;
      calculateAcademicPay();
    });
    acadFitmentSelect.addEventListener('change', calculateAcademicPay);
    phdIncrementSelect.addEventListener('change', calculateAcademicPay);
    acadCityTier.addEventListener('change', calculateAcademicPay);

    // Preset Chip Buttons
    const pills = document.querySelectorAll('#cadrePills .chip-btn');
    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        pills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        acadBasicInput.value = pill.getAttribute('data-base');
        phdIncrementSelect.value = pill.getAttribute('data-adv');

        // Match dropdown value
        const targetBase = pill.getAttribute('data-base');
        for (let i = 0; i < acadCadreSelect.options.length; i++) {
          if (acadCadreSelect.options[i].value === targetBase) {
            acadCadreSelect.selectedIndex = i;
            break;
          }
        }
        calculateAcademicPay();
      });
    });

    // FAQ Accordion Toggle
    document.querySelectorAll('.faq-quest').forEach(q => {
      q.addEventListener('click', () => {
        q.parentElement.classList.toggle('open');
      });
    });

    // Initial Execution
    calculateAcademicPay();
  </script>

