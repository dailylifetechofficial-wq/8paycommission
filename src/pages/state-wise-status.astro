  <!-- CLIENT-SIDE COMPUTATION JAVASCRIPT -->
  <script is:inline>
    const stateSelect = document.getElementById('stateSelect');
    const stateBasicInput = document.getElementById('stateBasicInput');
    const stateFitmentSelect = document.getElementById('stateFitmentSelect');
    const stateHraTier = document.getElementById('stateHraTier');

    const dispStateBasic = document.getElementById('dispStateBasic');
    const dispStateHra = document.getElementById('dispStateHra');
    const dispStateGross = document.getElementById('dispStateGross');
    const stickyStateBasic = document.getElementById('stickyStateBasic');

    const slipBasic = document.getElementById('slipBasic');
    const slipHra = document.getElementById('slipHra');
    const slipAllow = document.getElementById('slipAllow');
    const slipGross = document.getElementById('slipGross');
    const slipNps = document.getElementById('slipNps');
    const slipNet = document.getElementById('slipNet');
    const slipStateLabel = document.getElementById('slipStateLabel');

    function calculateStatePay() {
      const basic = parseFloat(stateBasicInput.value) || 0;
      const fitment = parseFloat(stateFitmentSelect.value) || 2.86;
      const hraRate = parseFloat(stateHraTier.value) || 0.30;

      // Arithmetic Engine
      const revisedBasic = Math.round(basic * fitment);
      const hraAmount = Math.round(revisedBasic * hraRate);
      
      // Standard state medical and conveyance allowance allowance baseline
      const baseAllow = 3600;
      const gross = revisedBasic + hraAmount + baseAllow;

      // 10% NPS / State Pension Deduction
      const npsDeduction = Math.round(revisedBasic * 0.10);
      const netPay = gross - npsDeduction;

      // Update KPI Cards
      dispStateBasic.textContent = '₹' + revisedBasic.toLocaleString('en-IN');
      dispStateHra.textContent = '₹' + hraAmount.toLocaleString('en-IN');
      dispStateGross.textContent = '₹' + gross.toLocaleString('en-IN');
      if (stickyStateBasic) stickyStateBasic.textContent = '₹' + revisedBasic.toLocaleString('en-IN');

      // Update Breakdown Table
      slipBasic.textContent = '₹' + revisedBasic.toLocaleString('en-IN');
      slipHra.textContent = '₹' + hraAmount.toLocaleString('en-IN');
      slipAllow.textContent = '₹' + baseAllow.toLocaleString('en-IN');
      slipGross.textContent = '₹' + gross.toLocaleString('en-IN');
      slipNps.textContent = '-₹' + npsDeduction.toLocaleString('en-IN');
      slipNet.textContent = '₹' + netPay.toLocaleString('en-IN');

      // Update Subtitle Label
      const selectedOption = stateSelect.options[stateSelect.selectedIndex];
      if (selectedOption) {
        const stateName = selectedOption.value;
        const parityType = selectedOption.getAttribute('data-parity') || 'Parity Pattern';
        slipStateLabel.textContent = `${stateName} • ${parityType}`;
      }
    }

    // Input Listeners
    stateSelect.addEventListener('change', calculateStatePay);
    stateBasicInput.addEventListener('input', calculateStatePay);
    stateFitmentSelect.addEventListener('change', calculateStatePay);
    stateHraTier.addEventListener('change', calculateStatePay);

    // Pattern Chip Buttons
    const pills = document.querySelectorAll('#patternPills .chip-btn');
    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        pills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');

        const targetState = pill.getAttribute('data-state');
        const targetFitment = pill.getAttribute('data-fit');

        stateFitmentSelect.value = targetFitment;
        for (let i = 0; i < stateSelect.options.length; i++) {
          if (stateSelect.options[i].value === targetState) {
            stateSelect.selectedIndex = i;
            break;
          }
        }
        calculateStatePay();
      });
    });

    // FAQ Accordion Toggle
    document.querySelectorAll('.faq-quest').forEach(q => {
      q.addEventListener('click', () => {
        q.parentElement.classList.toggle('open');
      });
    });

    // Initial Execution
    calculateStatePay();
  </script>

