---
import SiteLayout from '../layouts/SiteLayout.astro';

const siteUrl = "https://8paycommission.com";
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const pageTitle = "8th Pay Commission Pension Calculator: Expected Pension Hike, Family Pension & Commutation";
const pageDescription = "Calculate your projected 8th Central Pay Commission basic pension, family pension, commuted amount, and net in-hand pension hike with real-time arithmetic.";

const pensionBenchmarks = [
  { level: "Level 1 (GP 1800)", post: "MTS / Group D", base7th: 18000, pension7th: 9000 }, { level: "Level 2 (GP 1900)", post: "LDC / Junior Clerk", base7th: 19900, pension7th: 9950 }, { level: "Level 3 (GP 2000)", post: "Constable / Driver", base7th: 21700, pension7th: 10850 }, { level: "Level 4 (GP 2400)", post: "UDC / Head Constable", base7th: 25500, pension7th: 12750 }, { level: "Level 5 (GP 2800)", post: "Auditor / Accountant", base7th: 29200, pension7th: 14600 }, { level: "Level 6 (GP 4200)", post: "Inspector / Sub-Inspector", base7th: 35400, pension7th: 17700 }, { level: "Level 7 (GP 4600)", post: "ASO / Section Engineer", base7th: 44900, pension7th: 22450 }, { level: "Level 8 (GP 4800)", post: "AAO / Section Officer", base7th: 47600, pension7th: 23800 }, { level: "Level 9 (GP 5400)", post: "Senior Accounts Officer", base7th: 53100, pension7th: 26550 }, { level: "Level 10 (GP 5400)", post: "Group A Entry / SDM / DSP", base7th: 56100, pension7th: 28050 }, { level: "Level 11 (GP 6600)", post: "Under Secretary / Exec Engineer", base7th: 67700, pension7th: 33850 }, { level: "Level 12 (GP 7600)", post: "Deputy Secretary / SE", base7th: 78800, pension7th: 39400 }, { level: "Level 13 (GP 8700)", post: "Director / Selection Grade", base7th: 123100, pension7th: 61550 }, { level: "Level 14 (GP 10000)", post: "Joint Secretary / IG", base7th: 144200, pension7th: 72100 }, { level: "Level 17 (Apex Scale)", post: "Secretary to Govt of India", base7th: 225000, pension7th: 112500 }, { level: "Level 18 (Cabinet Sec)", post: "Cabinet Secretary of India", base7th: 250000, pension7th: 125000 }
];
const faqs = [
  { q: "How does the 8th Pay Commission pension calculator calculate revised pension?", a: "The calculator scales your current 7th CPC basic pension by the selected fitment multiplier and then factors in commutation, age-based quantum, and a fixed medical allowance estimate." },
  { q: "What happens to Dearness Relief (DR) when the 8th Pay Commission is implemented?", a: "Accumulated Dearness Relief is modeled as absorbed into the basic pension through the fitment factor. The final treatment will depend on the official notification." },
  { q: "How is Family Pension calculated under the 8th Central Pay Commission?", a: "This model displays family pension as 60% of revised basic pension, while actual entitlement remains subject to the applicable Central Civil Services Pension Rules." },
  { q: "What is the key demand regarding the commuted pension restoration period?", a: "Pensioner associations have requested reducing the recovery period from 15 years to 12 years; this remains a proposal until officially adopted." },
  { q: "Are defence veterans and civilian pensioners treated equally under the 8th CPC?", a: "The calculator uses the same fitment model for comparison, although defence-specific benefits and official rules may differ." }
];
---

<SiteLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": [{ "@type": "WebApplication", "name": "8th Pay Commission Pension Calculator", "url": canonicalURL.toString(), "applicationCategory": "FinanceApplication", "offers": { "@type": "Offer", "price": "0", "priceCurrency": "INR" } }, { "@type": "FAQPage", "mainEntity": faqs.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })) }] })} />
  <main class="layout-wrap">
    <header class="hero-header"><div class="badge-pill">Pensioner &amp; Family Welfare Model (2026)</div><h1>8th Pay Commission Pension Calculator</h1><p>Estimate revised basic pension, family pension, commuted deductions, and additional age-based quantum for retired Central Government and Armed Forces personnel.</p></header>
    <section class="calc-box" aria-label="8th Pay Commission Pension Calculator Widget">
      <div class="factor-label">Expected Fitment Factor:</div><div class="chip-bar" id="factorPills"><button class="chip-btn" data-f="1.92">1.92x (Conservative)</button><button class="chip-btn" data-f="2.25">2.25x (Baseline Model)</button><button class="chip-btn" data-f="2.57">2.57x (7th CPC Parity)</button><button class="chip-btn active" data-f="2.86">2.86x (Federation Target)</button></div>
      <div class="form-grid"><div class="form-item"><label for="pensionLevelSelect">Pay Level at Retirement</label><select id="pensionLevelSelect">{pensionBenchmarks.map((item) => <option value={item.pension7th} selected={item.level.startsWith("Level 6")}>{item.level} - Current Pension ₹{item.pension7th.toLocaleString('en-IN')}</option>)}</select></div><div class="form-item"><label for="currentPensionInput">Current 7th CPC Basic Pension (₹)</label><input type="number" id="currentPensionInput" value="17700" min="9000" step="50" /></div><div class="form-item"><label for="fitmentSelect">Fitment Multiplier</label><select id="fitmentSelect"><option value="1.92">1.92x (Conservative Baseline)</option><option value="2.10">2.10x (Moderate)</option><option value="2.25">2.25x (Consensus Projection)</option><option value="2.57">2.57x (Equivalent to 7th CPC)</option><option value="2.86" selected>2.86x (Federation Demand)</option><option value="3.00">3.00x (High Demand)</option></select></div><div class="form-item"><label for="commutationSelect">Commutation Status</label><select id="commutationSelect"><option value="0">No Commutation (Full Pension)</option><option value="0.20">20% Commuted</option><option value="0.30">30% Commuted</option><option value="0.40" selected>40% Commuted (Max Allowed)</option></select></div><div class="form-item"><label for="ageQuantumSelect">Pensioner Age Bracket</label><select id="ageQuantumSelect"><option value="0" selected>Under 80 Years (Normal Basic)</option><option value="0.20">80 to 85 Years (+20% Additional)</option><option value="0.30">85 to 90 Years (+30% Additional)</option><option value="0.40">90 to 95 Years (+40% Additional)</option><option value="0.50">95 to 100 Years (+50% Additional)</option><option value="1.00">100 Years or More (+100% Additional)</select></div></div>
      <div class="summary-cards"><div class="kpi-unit"><div class="kpi-label">Revised Basic Pension</div><div class="kpi-val" id="dispBasicPension">₹50,622</div></div><div class="kpi-unit highlight"><div class="kpi-label">Family Pension (30% Slabs)</div><div class="kpi-val" id="dispFamilyPension">₹30,373</div></div><div class="kpi-unit success"><div class="kpi-label">Net Monthly Take-Home</div><div class="kpi-val" id="dispNetPension">₹31,373</div></div></div>
      <div class="breakdown-box"><div class="breakdown-title"><span>Projected Monthly Pension Disbursal Slip</span><span class="breakdown-duration" id="slipTierLabel">Level 6 (GP 4200)</span></div><table class="breakdown-table"><tbody><tr><td>Revised 8th CPC Full Basic Pension</td><td class="num" id="slipFullBasic">₹50,622</td></tr><tr><td>Dearness Relief (DR) — Reset to 0% at rollout</td><td class="num">₹0</td></tr><tr><td>Additional Age Quantum</td><td class="num" id="slipAgeQuantum">₹0</td></tr><tr class="emphasis-row"><td>Total Gross Pension Entitlement</td><td class="num" id="slipGrossPension">₹50,622</td></tr><tr><td>Less: Commuted Pension Monthly Recovery Portion</td><td class="num negative" id="slipCommutedDeduct">-₹20,249</td></tr><tr><td>Fixed Medical Allowance</td><td class="num" id="slipFma">₹1,000</td></tr><tr class="net-row"><td>Net Monthly Pension Disbursed to Bank</td><td class="num" id="slipNetPension">₹31,373</td></tr></tbody></table></div>
    </section>
    <article class="article-wrap"><h2>Understanding Pension Recalibration Under the 8th Central Pay Commission</h2><p>For retired Central Government personnel, defence veterans, railway pensioners, and surviving family dependents, Pay Commission revisions affect basic pension, family pension, and recovery deductions.</p><h2>1. Modified Parity and Fitment Factor</h2><p>The model uses a selected fitment factor to estimate revised pension. Actual values will depend on the approved recommendation and implementation order.</p><div class="formula-banner">Revised 8th CPC Basic Pension = Current 7th CPC Basic Pension × Approved Fitment Factor</div><h2>2. Fitment Multiplier Scenarios</h2><div class="table-responsive"><table class="data-table"><thead><tr><th>Multiplier</th><th>Scenario</th><th>Level 1 Basic Pension</th><th>Assessment</th></tr></thead><tbody><tr><td>1.92x</td><td>Conservative</td><td>₹17,280</td><td>Modest correction</td></tr><tr><td>2.25x</td><td>Moderate consensus</td><td>₹20,250</td><td>Balanced model</td></tr><tr><td>2.57x</td><td>Parity</td><td>₹23,130</td><td>7th CPC-scale uplift</td></tr><tr><td>2.86x</td><td>Federation benchmark</td><td>₹25,740</td><td>Higher projection</td></tr></tbody></table></div><h2>3. Pension Benchmarks Across Pay Levels</h2><div class="level-grid">{pensionBenchmarks.map((item) => <div class="level-pill" data-pension={item.pension7th}><strong>{item.level}</strong><span>7th: ₹{item.pension7th.toLocaleString('en-IN')}</span></div>)}</div><div class="table-responsive"><table class="data-table"><thead><tr><th>Pay Level</th><th>Cadre / Post</th><th>7th CPC Pension</th><th>8th CPC (2.25x)</th><th>8th CPC (2.86x)</th></tr></thead><tbody>{pensionBenchmarks.map((row) => <tr><td><strong>{row.level}</strong></td><td>{row.post}</td><td>₹{row.pension7th.toLocaleString('en-IN')}</td><td>₹{Math.round(row.pension7th * 2.25).toLocaleString('en-IN')}</td><td>₹{Math.round(row.pension7th * 2.86).toLocaleString('en-IN')}</td></tr>)}</tbody></table></div><h2>4. Commutation, Age Quantum &amp; Family Pension</h2><p>Commutation reduces monthly disbursal until the applicable restoration date. Additional age quantum is modeled for pensioners aged 80 and above. Family pension calculations remain subject to official rules.</p><h2>5. Frequently Asked Questions</h2><div class="faq-list">{faqs.map((faq) => <div class="faq-unit"><div class="faq-quest"><span>{faq.q}</span><span class="faq-arrow">▼</span></div><div class="faq-ans">{faq.a}</div></div>)}</div></article>
    <div class="disclaimer-strip"><strong>Statutory Disclaimer:</strong> 8paycommission.com is an independent educational and analytical platform. Calculator values are estimates and are not official Government of India pension rules.</div>
    <div class="mobile-sticky-bar"><div><div class="lbl">Revised In-Hand Pension</div><div class="val" id="stickyNetPension">₹31,373</div></div><a href="#currentPensionInput" class="chip-btn active">Recalculate</a></div>
  </main>
</SiteLayout>

<style>
  :global(body) { background: #f8fafc; color: #0f172a; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; } .layout-wrap { max-width: 1100px; margin: 0 auto; padding: 0 1.25rem; } .hero-header { text-align: center; padding: 3rem 1rem 1.75rem; } .badge-pill { display: inline-flex; background: #eff6ff; border: 1px solid #bfdbfe; color: #1d4ed8; padding: .25rem .85rem; border-radius: 30px; font-size: .78rem; font-weight: 700; text-transform: uppercase; margin-bottom: .85rem; } .hero-header h1 { font-size: clamp(1.85rem, 4vw, 2.75rem); margin-bottom: .75rem; } .hero-header p { color: #64748b; max-width: 740px; margin: 0 auto; font-size: 1.05rem; } .calc-box, .article-wrap { background: #fff; border: 1px solid #e2e8f0; border-radius: 20px; box-shadow: 0 16px 32px -4px rgba(15,23,42,.08); } .calc-box { padding: 2rem; margin-bottom: 3.5rem; } .factor-label { display: inline-block; font-size: .8rem; font-weight: 700; color: #64748b; text-transform: uppercase; margin-bottom: .75rem; } .chip-bar { display: flex; gap: .5rem; overflow-x: auto; padding: .5rem 0 1.25rem; } .chip-btn { background: #f1f5f9; border: 1px solid #e2e8f0; color: #475569; padding: .5rem 1.1rem; border-radius: 30px; font-weight: 700; white-space: nowrap; cursor: pointer; } .chip-btn.active { background: #1d4ed8; border-color: #1d4ed8; color: #fff; } .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem; margin-bottom: 1.5rem; } .form-item { display: flex; flex-direction: column; gap: .4rem; } .form-item label { font-size: .82rem; font-weight: 700; color: #334155; text-transform: uppercase; } .form-item input, .form-item select { background: #fff; border: 1.5px solid #cbd5e1; color: #0f172a; padding: .75rem .9rem; border-radius: 8px; font-size: .96rem; font-weight: 600; } .summary-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; } .kpi-unit { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 14px; padding: 1.25rem; text-align: center; } .kpi-unit.highlight { background: #eff6ff; border-color: #bfdbfe; } .kpi-unit.success { background: #dcfce7; border-color: #86efac; } .kpi-label { font-size: .75rem; font-weight: 700; color: #64748b; text-transform: uppercase; margin-bottom: .35rem; } .kpi-val { font-size: 1.5rem; font-weight: 800; } .breakdown-box { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 14px; padding: 1.5rem; } .breakdown-title { font-weight: 800; margin-bottom: .85rem; display: flex; justify-content: space-between; gap: 1rem; } .breakdown-duration { color: #1d4ed8; font-size: .85rem; } .breakdown-table, .data-table { width: 100%; border-collapse: collapse; } .breakdown-table td, .data-table th, .data-table td { padding: .7rem .5rem; border-bottom: 1px solid #e2e8f0; } .num { text-align: right; font-weight: 700; } .negative { color: #dc2626; } .emphasis-row { font-weight: 700; background: #f8fafc; } .net-row { font-weight: 800; background: #dcfce7; } .article-wrap { padding: 2.75rem; margin-bottom: 3.5rem; } .article-wrap h2 { margin: 2.5rem 0 1rem; padding-bottom: .5rem; border-bottom: 2px solid #eff6ff; } .article-wrap h3 { margin: 1.6rem 0 .65rem; } .article-wrap p, .article-wrap li { color: #334155; line-height: 1.7; } .article-wrap p { margin-bottom: 1.25rem; } .article-wrap ul, .article-wrap ol { margin-bottom: 1.5rem; padding-left: 1.5rem; } .formula-banner { background: #eff6ff; border-left: 4px solid #1d4ed8; padding: 1.15rem 1.35rem; margin: 1.5rem 0; font-family: monospace; color: #1e40af; } .table-responsive { overflow-x: auto; border: 1px solid #e2e8f0; border-radius: 14px; margin: 1.5rem 0; } .data-table { min-width: 700px; text-align: left; } .data-table th { background: #f8fafc; color: #475569; font-size: .8rem; text-transform: uppercase; } .level-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: .65rem; margin: 1.25rem 0; } .level-pill { background: #fff; border: 1px solid #e2e8f0; padding: .75rem .5rem; border-radius: 8px; text-align: center; cursor: pointer; } .level-pill strong, .level-pill span { display: block; } .level-pill span { font-size: .78rem; color: #64748b; } .faq-unit { border-bottom: 1px solid #e2e8f0; padding: 1.15rem 0; } .faq-quest { font-weight: 700; cursor: pointer; display: flex; justify-content: space-between; gap: 1rem; } .faq-ans { display: none; padding-top: .65rem; color: #475569; line-height: 1.7; } .faq-unit.open .faq-ans { display: block; } .faq-unit.open .faq-arrow { transform: rotate(180deg); } .faq-arrow { color: #64748b; } .disclaimer-strip { max-width: 1100px; margin: 2rem auto 4rem; padding: 1.25rem; background: #f8fafc; border: 1px solid #e2e8f0; border-left: 4px solid #94a3b8; border-radius: 8px; font-size: .82rem; color: #64748b; } .mobile-sticky-bar { display: none; position: fixed; bottom: 0; left: 0; right: 0; background: rgba(255,255,255,.96); border-top: 1px solid #e2e8f0; padding: .75rem 1.25rem; z-index: 990; justify-content: space-between; align-items: center; } .mobile-sticky-bar .lbl { font-size: .74rem; color: #64748b; text-transform: uppercase; font-weight: 700; } .mobile-sticky-bar .val { font-size: 1.2rem; font-weight: 800; color: #1d4ed8; } @media (max-width: 768px) { .mobile-sticky-bar { display: flex; } :global(body) { padding-bottom: 4.5rem; } .calc-box, .article-wrap { padding: 1.25rem; } .breakdown-title { display: block; } }
</style>

<script is:inline>
  const currentPensionInput = document.getElementById('currentPensionInput'); const pensionLevelSelect = document.getElementById('pensionLevelSelect'); const fitmentSelect = document.getElementById('fitmentSelect'); const commutationSelect = document.getElementById('commutationSelect'); const ageQuantumSelect = document.getElementById('ageQuantumSelect'); const dispBasicPension = document.getElementById('dispBasicPension'); const dispFamilyPension = document.getElementById('dispFamilyPension'); const dispNetPension = document.getElementById('dispNetPension'); const stickyNetPension = document.getElementById('stickyNetPension'); const slipFullBasic = document.getElementById('slipFullBasic'); const slipAgeQuantum = document.getElementById('slipAgeQuantum'); const slipGrossPension = document.getElementById('slipGrossPension'); const slipCommutedDeduct = document.getElementById('slipCommutedDeduct'); const slipFma = document.getElementById('slipFma'); const slipNetPension = document.getElementById('slipNetPension'); const slipTierLabel = document.getElementById('slipTierLabel');
  const money = (value) => '₹' + Math.round(value).toLocaleString('en-IN');
  function calculatePension() { const currentPension = parseFloat(currentPensionInput.value) || 0; const fitment = parseFloat(fitmentSelect.value) || 2.86; const commRate = parseFloat(commutationSelect.value) || 0.4; const ageRate = parseFloat(ageQuantumSelect.value) || 0; const revisedBasic = Math.round(currentPension * fitment); const familyPension = Math.round(revisedBasic * 0.6); const ageAddition = Math.round(revisedBasic * ageRate); const grossPension = revisedBasic + ageAddition; const commutedAmount = Math.round(revisedBasic * commRate); const fmaAmount = 1000; const netMonthlyPension = Math.max(0, grossPension - commutedAmount + fmaAmount); dispBasicPension.textContent = money(revisedBasic); dispFamilyPension.textContent = money(familyPension); dispNetPension.textContent = money(netMonthlyPension); stickyNetPension.textContent = money(netMonthlyPension); slipFullBasic.textContent = money(revisedBasic); slipAgeQuantum.textContent = ageAddition ? '+' + money(ageAddition) : '₹0'; slipGrossPension.textContent = money(grossPension); slipCommutedDeduct.textContent = commutedAmount ? '-₹' + commutedAmount.toLocaleString('en-IN') : '₹0'; slipFma.textContent = money(fmaAmount); slipNetPension.textContent = money(netMonthlyPension); slipTierLabel.textContent = pensionLevelSelect.options[pensionLevelSelect.selectedIndex]?.text.split(' - ')[0] || ''; }
  [currentPensionInput, fitmentSelect, commutationSelect, ageQuantumSelect].forEach((element) => element.addEventListener('input', calculatePension)); [fitmentSelect, commutationSelect, ageQuantumSelect].forEach((element) => element.addEventListener('change', calculatePension)); pensionLevelSelect.addEventListener('change', () => { currentPensionInput.value = pensionLevelSelect.value; calculatePension(); }); document.querySelectorAll('#factorPills .chip-btn').forEach((pill) => pill.addEventListener('click', () => { document.querySelectorAll('#factorPills .chip-btn').forEach((p) => p.classList.remove('active')); pill.classList.add('active'); fitmentSelect.value = pill.dataset.f; calculatePension(); })); document.querySelectorAll('.level-pill').forEach((pill) => pill.addEventListener('click', () => { currentPensionInput.value = pill.dataset.pension; pensionLevelSelect.value = pill.dataset.pension; calculatePension(); document.querySelector('.calc-box')?.scrollIntoView({ behavior: 'smooth' }); })); document.querySelectorAll('.faq-quest').forEach((question) => question.addEventListener('click', () => question.parentElement.classList.toggle('open'))); calculatePension();
</script>
