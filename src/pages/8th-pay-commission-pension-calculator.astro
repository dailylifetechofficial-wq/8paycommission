  <!-- STICKY MOBILE SUMMARY BAR -->
  <div class="mobile-sticky-bar">
    <div>
      <div class="lbl">Revised In-Hand Pension</div>
      <div class="val" id="stickyNetPension">₹31,373</div>
    </div>
    <a href="#currentPensionInput" class="chip-btn active" style="padding: 0.45rem 0.95rem; font-size: 0.82rem;">Recalculate</a>
  </div>

  <!-- CLIENT-SIDE COMPUTATION JAVASCRIPT -->
  <script is:inline>
    const currentPensionInput = document.getElementById('currentPensionInput');
    const pensionLevelSelect = document.getElementById('pensionLevelSelect');
    const fitmentSelect = document.getElementById('fitmentSelect');
    const commutationSelect = document.getElementById('commutationSelect');
    const ageQuantumSelect = document.getElementById('ageQuantumSelect');

    const dispBasicPension = document.getElementById('dispBasicPension');
    const dispFamilyPension = document.getElementById('dispFamilyPension');
    const dispNetPension = document.getElementById('dispNetPension');
    const stickyNetPension = document.getElementById('stickyNetPension');

    const slipFullBasic = document.getElementById('slipFullBasic');
    const slipAgeQuantum = document.getElementById('slipAgeQuantum');
    const slipGrossPension = document.getElementById('slipGrossPension');
    const slipCommutedDeduct = document.getElementById('slipCommutedDeduct');
    const slipFma = document.getElementById('slipFma');
    const slipNetPension = document.getElementById('slipNetPension');
    const slipTierLabel = document.getElementById('slipTierLabel');

    function calculatePension() {
      const currentPension = parseFloat(currentPensionInput.value) || 0;
      const fitment = parseFloat(fitmentSelect.value) || 2.86;
      const commRate = parseFloat(commutationSelect.value) || 0.40;
      const ageRate = parseFloat(ageQuantumSelect.value) || 0;

      // Core Arithmetic
      const revisedBasic = Math.round(currentPension * fitment);
      
      // Family Pension (30% of equivalent full basic, or 60% of basic pension)
      const familyPension = Math.round(revisedBasic * 0.60);

      // Additional Quantum for 80+ years
      const ageAddition = Math.round(revisedBasic * ageRate);
      const grossPension = revisedBasic + ageAddition;

      // Commutation Deduction (calculated on basic pension without age addition)
      const commutedAmount = Math.round(revisedBasic * commRate);

      // Standard Fixed Medical Allowance (FMA) assumption
      const fmaAmount = 1000;

      // Net Monthly Take-Home Disbursal
      const netMonthlyPension = Math.max(0, grossPension - commutedAmount + fmaAmount);

      // Format to Indian Currency
      const fmtBasic = '₹' + revisedBasic.toLocaleString('en-IN');
      const fmtFamily = '₹' + familyPension.toLocaleString('en-IN');
      const fmtNet = '₹' + netMonthlyPension.toLocaleString('en-IN');

      // Update KPI Cards
      dispBasicPension.textContent = fmtBasic;
      dispFamilyPension.textContent = fmtFamily;
      dispNetPension.textContent = fmtNet;
      if (stickyNetPension) stickyNetPension.textContent = fmtNet;

      // Update Table Slip
      slipFullBasic.textContent = fmtBasic;
      slipAgeQuantum.textContent = ageAddition > 0 ? '+₹' + ageAddition.toLocaleString('en-IN') : '₹0';
      slipGrossPension.textContent = '₹' + grossPension.toLocaleString('en-IN');
      slipCommutedDeduct.textContent = commutedAmount > 0 ? '-₹' + commutedAmount.toLocaleString('en-IN') : '₹0';
      slipFma.textContent = '₹' + fmaAmount.toLocaleString('en-IN');
      slipNetPension.textContent = fmtNet;

      // Update Subtitle Label
      const selectedLevel = pensionLevelSelect.options[pensionLevelSelect.selectedIndex];
      if (selectedLevel) {
        slipTierLabel.textContent = selectedLevel.text.split(' - ')[0];
      }
    }

    // Input Listeners
    currentPensionInput.addEventListener('input', calculatePension);
    fitmentSelect.addEventListener('change', calculatePension);
    commutationSelect.addEventListener('change', calculatePension);
    ageQuantumSelect.addEventListener('change', calculatePension);

    // Preset Level Dropdown Handler
    pensionLevelSelect.addEventListener('change', (e) => {
      currentPensionInput.value = e.target.value;
      calculatePension();
    });

    // Multiplier Button Pills
    const pills = document.querySelectorAll('#factorPills .chip-btn');
    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        pills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        fitmentSelect.value = pill.getAttribute('data-f');
        calculatePension();
      });
    });

    // Quick Level Pills
    document.querySelectorAll('.level-pill').forEach(pill => {
      pill.addEventListener('click', () => {
        const val = pill.getAttribute('data-pension');
        currentPensionInput.value = val;
        pensionLevelSelect.value = val;
        calculatePension();
        document.querySelector('.calc-box').scrollIntoView({ behavior: 'smooth' });
      });
    });

    // FAQ Accordion
    document.querySelectorAll('.faq-quest').forEach(q => {
      q.addEventListener('click', () => {
        q.parentElement.classList.toggle('open');
      });
    });

    // Initial Execution
    calculatePension();
  </script>

</body>
