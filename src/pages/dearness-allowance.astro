  <!-- STICKY MOBILE SUMMARY BAR -->
  <div class="mobile-sticky-bar">
    <div>
      <div class="lbl">Total Monthly DA</div>
      <div class="val" id="stickyTotalDa">₹20,670</div>
    </div>
    <a href="#daBasicInput" class="chip-btn active" style="padding: 0.45rem 0.95rem; font-size: 0.82rem;">Recalculate</a>
  </div>

  <!-- CLIENT-SIDE COMPUTATION JAVASCRIPT -->
  <script is:inline>
    const daBasicInput = document.getElementById('daBasicInput');
    const daPercentInput = document.getElementById('daPercentInput');
    const daLevelPreset = document.getElementById('daLevelPreset');
    const daTransportSelect = document.getElementById('daTransportSelect');

    const dispDaBasic = document.getElementById('dispDaBasic');
    const dispDaTa = document.getElementById('dispDaTa');
    const dispTotalDa = document.getElementById('dispTotalDa');
    const stickyTotalDa = document.getElementById('stickyTotalDa');

    const slipBasic = document.getElementById('slipBasic');
    const slipDaRate = document.getElementById('slipDaRate');
    const slipBasicDa = document.getElementById('slipBasicDa');
    const slipBaseTa = document.getElementById('slipBaseTa');
    const slipTaDa = document.getElementById('slipTaDa');
    const slipTotalTa = document.getElementById('slipTotalTa');
    const slipNetDa = document.getElementById('slipNetDa');
    const slipLevelLabel = document.getElementById('slipLevelLabel');

    function calculateDA() {
      const basic = parseFloat(daBasicInput.value) || 0;
      const daRate = parseFloat(daPercentInput.value) || 0;
      const baseTa = parseFloat(daTransportSelect.value) || 3600;

      // Arithmetic Engine
      const daOnBasic = Math.round(basic * (daRate / 100));
      const daOnTa = Math.round(baseTa * (daRate / 100));
      const totalTa = baseTa + daOnTa;
      const totalDa = daOnBasic + daOnTa;

      // Update KPI Cards
      dispDaBasic.textContent = '₹' + daOnBasic.toLocaleString('en-IN');
      dispDaTa.textContent = '₹' + daOnTa.toLocaleString('en-IN');
      dispTotalDa.textContent = '₹' + totalDa.toLocaleString('en-IN');
      if (stickyTotalDa) stickyTotalDa.textContent = '₹' + totalDa.toLocaleString('en-IN');

      // Update Breakdown Slip
      slipBasic.textContent = '₹' + basic.toLocaleString('en-IN');
      slipDaRate.textContent = daRate + '%';
      slipBasicDa.textContent = '₹' + daOnBasic.toLocaleString('en-IN');
      slipBaseTa.textContent = '₹' + baseTa.toLocaleString('en-IN');
      slipTaDa.textContent = '₹' + daOnTa.toLocaleString('en-IN');
      slipTotalTa.textContent = '₹' + totalTa.toLocaleString('en-IN');
      slipNetDa.textContent = '₹' + totalDa.toLocaleString('en-IN');

      // Update Subtitle Label
      const selectedLevel = daLevelPreset.options[daLevelPreset.selectedIndex];
      if (selectedLevel) {
        const levelName = selectedLevel.text.split(' - ')[0];
        slipLevelLabel.textContent = `${levelName} • ${daRate}% DA Rate`;
      }
    }

    // Input Listeners
    daBasicInput.addEventListener('input', calculateDA);
    daPercentInput.addEventListener('input', calculateDA);
    daTransportSelect.addEventListener('change', calculateDA);

    // Level Preset Picker Handler
    daLevelPreset.addEventListener('change', (e) => {
      daBasicInput.value = e.target.value;
      calculateDA();
    });

    // Preset DA % Chip Buttons
    const pills = document.querySelectorAll('#daRatePills .chip-btn');
    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        pills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        daPercentInput.value = pill.getAttribute('data-da');
        calculateDA();
      });
    });

    // FAQ Accordion Toggle
    document.querySelectorAll('.faq-quest').forEach(q => {
      q.addEventListener('click', () => {
        q.parentElement.classList.toggle('open');
      });
    });

    // Initial Execution
    calculateDA();
  </script>

</body>
