// src/pages/dearness-allowance.astro
const siteUrl = "https://8paycommission.com";
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const pageTitle = "Dearness Allowance (DA) & AICPI-IW Tracker: 7th & 8th CPC Rates & Formula";
const pageDescription = "Comprehensive guide and calculator for Dearness Allowance (DA & DR). Track 12-month AICPI-IW index numbers, the 2016 linking formula, DA on Transport Allowance, and the 8th CPC 0% reset.";

// Historical DA Progression Table (7th CPC Journey to 8th CPC Transition)
const daHistory = [
  { period: "Jan 2016", daRate: "0%", hike: "—", aicpiAvg: "261.4", remarks: "7th CPC Implementation Baseline" },
  { period: "Jul 2016", daRate: "2%", hike: "+2%", aicpiAvg: "267.0", remarks: "1st Installment under 7th CPC" },
  { period: "Jan 2017", daRate: "4%", hike: "+2%", aicpiAvg: "272.5", remarks: "Regular Semi-Annual Revision" },
  { period: "Jul 2017", daRate: "5%", hike: "+1%", aicpiAvg: "276.0", remarks: "Moderate Inflation Index" },
  { period: "Jan 2018", daRate: "7%", hike: "+2%", aicpiAvg: "281.3", remarks: "Regular Semi-Annual Revision" },
  { period: "Jul 2018", daRate: "9%", hike: "+2%", aicpiAvg: "287.0", remarks: "Regular Semi-Annual Revision" },
  { period: "Jan 2019", daRate: "12%", hike: "+3%", aicpiAvg: "294.8", remarks: "Accelerated Price Surge" },
  { period: "Jul 2019", daRate: "17%", hike: "+5%", aicpiAvg: "306.0", remarks: "Highest Single-Installment Hike" },
  { period: "Jan 2020 – Jan 2021", daRate: "17%", hike: "Frozen", aicpiAvg: "—", remarks: "COVID-19 Statutory Freezing Order" },
  { period: "Jul 2021", daRate: "28%", hike: "+11%", aicpiAvg: "338.2", remarks: "Cumulative Restored Payout (No Arrears)" },
  { period: "Jan 2022", daRate: "34%", hike: "+3%", aicpiAvg: "351.3", remarks: "HRA 25% Trigger Crossed (27%/18%/9%)" },
  { period: "Jul 2022", daRate: "38%", hike: "+4%", aicpiAvg: "363.5", remarks: "Regular Semi-Annual Revision" },
  { period: "Jan 2023", daRate: "42%", hike: "+4%", aicpiAvg: "372.0", remarks: "Post-Pandemic Inflation Factor" },
  { period: "Jul 2023", daRate: "46%", hike: "+4%", aicpiAvg: "385.0", remarks: "Pre-Milestone Threshold" },
  { period: "Jan 2024", daRate: "50%", hike: "+4%", aicpiAvg: "399.5", remarks: "50% Milestone: HRA Restored to 30%/20%/10%" },
  { period: "Jul 2024", daRate: "53%", hike: "+3%", aicpiAvg: "411.2", remarks: "Accumulated Baseline ahead of 8th CPC" },
  { period: "Jan 2026 (Projected)", daRate: "0%", hike: "Reset", aicpiAvg: "Reset", remarks: "8th CPC Implementation: 100% DA Merged into Base" }
];

// Level-Wise Starting Basic Pay for DA Impact Demonstration
const daMatrixTiers = [
  { level: "Level 1 (GP 1800)", post: "MTS / Group D Staff", basePay: 18000 },
  { level: "Level 2 (GP 1900)", post: "Lower Division Clerk (LDC)", basePay: 19900 },
  { level: "Level 3 (GP 2000)", post: "Constable / Driver / Postman", basePay: 21700 },
  { level: "Level 4 (GP 2400)", post: "Upper Division Clerk (UDC)", basePay: 25500 },
  { level: "Level 5 (GP 2800)", post: "Auditor / Accountant", basePay: 29200 },
  { level: "Level 6 (GP 4200)", post: "Sub-Inspector / Inspector / Teacher", basePay: 35400 },
  { level: "Level 7 (GP 4600)", post: "Assistant Section Officer (ASO)", basePay: 44900 },
  { level: "Level 8 (GP 4800)", post: "Assistant Accounts Officer (AAO)", basePay: 47600 },
  { level: "Level 10 (GP 5400)", post: "Group A Entry / SDM / DSP", basePay: 56100 },
  { level: "Level 12 (GP 7600)", post: "Deputy Secretary / Joint Director", basePay: 78800 },
  { level: "Level 14 (GP 10000)", post: "Joint Secretary / IG Police", basePay: 144200 }
];

const faqs = [
  {
    q: "What is Dearness Allowance (DA) and who is eligible to receive it?",
    a: "Dearness Allowance is a cost-of-living adjustment paid by the Government of India to active Central Government employees, defence personnel, and railway staff. It compensates for the continuous erosion of real wages caused by retail price inflation. For pensioners, the equivalent payout is disbursed as Dearness Relief (DR)."
  },
  {
    q: "How is Dearness Allowance calculated using the AICPI-IW index?",
    a: "Under the 7th CPC framework, DA is calculated based on the 12-month average of the All-India Consumer Price Index for Industrial Workers (AICPI-IW, Base 2016=100) converted using the official linking factor of 2.88. The formula is: DA % = [((12-Month Average AICPI-IW − 261.42) ÷ 261.42) × 100]. Fractions are strictly truncated (dropped), not rounded off."
  },
  {
    q: "When is Dearness Allowance revised during the calendar year?",
    a: "DA is revised twice a year: effective January 1st (notified in March/April with retroactive arrears for January and February) and effective July 1st (notified in September/October ahead of the festive season with arrears for July, August, and September)."
  },
  {
    q: "What happens to Dearness Allowance when a new Pay Commission is implemented?",
    a: "Whenever a Central Pay Commission takes effect, all accumulated DA is merged into basic pay through the fitment factor multiplier. Because all preceding inflation is absorbed into the higher basic salary, the DA rate resets to 0% on the implementation date and starts accruing anew from zero."
  },
  {
    q: "Is Dearness Allowance taxable under Indian income tax laws?",
    a: "Yes. Dearness Allowance is classified as compensatory wage income under the Income Tax Act, 1961. It is 100% taxable as salary income for both active personnel and pensioners under both the Old and New Tax Regimes."
  }
];
