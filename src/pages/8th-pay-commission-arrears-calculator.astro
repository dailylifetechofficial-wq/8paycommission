  <!-- STICKY MOBILE SUMMARY BAR -->
  <div class="mobile-sticky-bar">
    <div>
      <div class="lbl">Estimated Cash Arrears</div>
      <div class="val" id="stickyArrears">₹5,08,488</div>
    </div>
    <a href="#oldDrawnBasic" class="chip-btn active" style="padding: 0.45rem 0.95rem; font-size: 0.82rem;">Recalculate</a>
  </div>

  <!-- CLIENT-SIDE COMPUTATION JAVASCRIPT -->
  <script is:inline>
    const oldDrawnBasic = document.getElementById('oldDrawnBasic');
    const arrearsFitment = document.getElementById('arrearsFitment');
    const arrearsMonthsInput = document.getElementById('arrearsMonthsInput');
    const drawnDaRate = document.getElementById('drawnDaRate');

    const dispMonthlyDiff = document.getElementById('dispMonthlyDiff');
    const dispNpsOffset = document.getElementById('dispNpsOffset');
    const dispTotalArrears = document.getElementById('dispTotalArrears');
    const stickyArrears = document.getElementById('stickyArrears');

    const slipNewBasic = document.getElementById('slipNewBasic');
    const slipOldBasic = document.getElementById('slipOldBasic');
    const slipOldDaDrawn = document.getElementById('slipOldDaDrawn');
    const slipNetMonthlyDiff = document.getElementById('slipNetMonthlyDiff');
    const slipGrossArrears = document.getElementById('slipGrossArrears');
    const slipNpsDeduct = document.getElementById('slipNpsDeduct');
    const slipNetCashArrears = document.getElementById('slipNetCashArrears');
    const slipDurationLabel = document.getElementById('slipDurationLabel');

    function calculateArrears() {
      const basic = parseFloat(oldDrawnBasic.value) || 0;
      const fitment = parseFloat(arrearsFitment.value) || 2.86;
      const months = parseInt(arrearsMonthsInput.value) || 12;
      const daRate = parseFloat(drawnDaRate.value) || 0.53;

      // Arithmetic Engine
      const revisedBasic = Math.round(basic * fitment);
      const oldDaDrawnMonthly = Math.round(basic * daRate);
      const totalOldDrawnMonthly = basic + oldDaDrawnMonthly;

      // Net Monthly Difference (Due Basic - Total Old Drawn)
      const monthlyDiff = Math.max(0, revisedBasic - totalOldDrawnMonthly);
      const grossArrears = monthlyDiff * months;

      // 10% NPS Deduction on the incremental Basic Pay portion
      const incrementalBasicMonthly = Math.max(0, revisedBasic - basic);
      const npsDeductionTotal = Math.round(incrementalBasicMonthly * 0.10 * months);

      // Net Cash Arrears Credited
      const netCashArrears = Math.max(0, grossArrears - npsDeductionTotal);

      // DOM Updates
      dispMonthlyDiff.textContent = '₹' + monthlyDiff.toLocaleString('en-IN');
      dispNpsOffset.textContent = '₹' + npsDeductionTotal.toLocaleString('en-IN');
      dispTotalArrears.textContent = '₹' + grossArrears.toLocaleString('en-IN');
      if (stickyArrears) stickyArrears.textContent = '₹' + netCashArrears.toLocaleString('en-IN');

      slipNewBasic.textContent = '₹' + revisedBasic.toLocaleString('en-IN');
      slipOldBasic.textContent = '-₹' + basic.toLocaleString('en-IN');
      slipOldDaDrawn.textContent = '-₹' + oldDaDrawnMonthly.toLocaleString('en-IN');
      slipNetMonthlyDiff.textContent = '₹' + monthlyDiff.toLocaleString('en-IN');
      slipGrossArrears.textContent = '₹' + grossArrears.toLocaleString('en-IN');
      slipNpsDeduct.textContent = '-₹' + npsDeductionTotal.toLocaleString('en-IN');
      slipNetCashArrears.textContent = '₹' + netCashArrears.toLocaleString('en-IN');

      slipDurationLabel.textContent = months + ' Months Retroactive Period';
    }

    // Input Listeners
    oldDrawnBasic.addEventListener('input', calculateArrears);
    arrearsFitment.addEventListener('change', calculateArrears);
    arrearsMonthsInput.addEventListener('input', calculateArrears);
    drawnDaRate.addEventListener('change', calculateArrears);

    // Duration Pill Buttons
    const pills = document.querySelectorAll('#monthPills .chip-btn');
    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        pills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        arrearsMonthsInput.value = pill.getAttribute('data-m');
        calculateArrears();
      });
    });

    // FAQ Accordion
    document.querySelectorAll('.faq-quest').forEach(q => {
      q.addEventListener('click', () => {
        q.parentElement.classList.toggle('open');
      });
    });

    // Initial Execution
    calculateArrears();
  </script>

