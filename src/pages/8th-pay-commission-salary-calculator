  <script is:inline>
    function calculateSalary() {
      const basicInput = document.getElementById('currentBasic');
      const fitmentSelect = document.getElementById('fitmentFactor');
      const citySelect = document.getElementById('cityClass');
      const levelSelect = document.getElementById('payLevel');

      const basic = parseFloat(basicInput.value) || 0;
      const fitment = parseFloat(fitmentSelect.value) || 2.86;
      const hraRate = parseFloat(citySelect.value) || 0.30;

      // Calculations
      const revisedBasic = Math.round(basic * fitment);
      const revisedHra = Math.round(revisedBasic * hraRate);
      
      // Standard baseline Transport Allowance estimate based on pay scale level
      const taBase = basic >= 35400 ? 3600 : 1350;
      const gross = revisedBasic + revisedHra + taBase;

      // Update DOM
      document.getElementById('dispBasic').textContent = '₹' + revisedBasic.toLocaleString('en-IN');
      document.getElementById('dispHra').textContent = '₹' + revisedHra.toLocaleString('en-IN');
      document.getElementById('dispGross').textContent = '₹' + gross.toLocaleString('en-IN');
    }

    // Update basic pay when a user switches the Level dropdown preset
    document.getElementById('payLevel').addEventListener('change', (e) => {
      document.getElementById('currentBasic').value = e.target.value;
      calculateSalary();
    });

    // Listen to changes across all inputs
    document.getElementById('currentBasic').addEventListener('input', calculateSalary);
    document.getElementById('fitmentFactor').addEventListener('change', calculateSalary);
    document.getElementById('cityClass').addEventListener('change', calculateSalary);

