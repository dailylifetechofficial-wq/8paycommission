// src/pages/salary-calculator.astro
const siteUrl = "https://8paycommission.com";
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const pageTitle = "8th Pay Commission Salary Calculator: In-Hand Hike, Pay Matrix & Fitment Factor";
const pageDescription = "Calculate your projected 8th Pay Commission salary hike with detailed arithmetic. Instant basic pay, HRA, TA, NPS deductions, and net monthly take-home estimates across all levels.";

// 7th CPC Benchmark Entry Matrix Data (Levels 1 to 18)
const payMatrixLevels = [
  { level: "Level 1", gp: "GP 1800", role: "MTS / Group D Staff", entry7th: 18000 },
  { level: "Level 2", gp: "GP 1900", role: "Lower Division Clerk (LDC)", entry7th: 19900 },
  { level: "Level 3", gp: "GP 2000", role: "Senior Clerk / Constable / Driver", entry7th: 21700 },
  { level: "Level 4", gp: "GP 2400", role: "Upper Division Clerk (UDC) / Head Constable", entry7th: 25500 },
  { level: "Level 5", gp: "GP 2800", role: "Auditor / Accountant / Junior Assistant", entry7th: 29200 },
  { level: "Level 6", gp: "GP 4200", role: "Inspector / Sub-Inspector / Primary Teacher", entry7th: 35400 },
  { level: "Level 7", gp: "GP 4600", role: "Assistant Section Officer (ASO) / Section Engineer", entry7th: 44900 },
  { level: "Level 8", gp: "GP 4800", role: "Assistant Accounts Officer (AAO) / Section Officer", entry7th: 47600 },
  { level: "Level 9", gp: "GP 5400 (PB-2)", role: "Senior Accounts Officer / Assistant Director", entry7th: 53100 },
  { level: "Level 10", gp: "GP 5400 (PB-3)", role: "Group-A Entry / SDM / DSP / Assistant Commissioner", entry7th: 56100 },
  { level: "Level 11", gp: "GP 6600", role: "Under Secretary / Executive Engineer", entry7th: 67700 },
  { level: "Level 12", gp: "GP 7600", role: "Deputy Secretary / Superintendent Engineer", entry7th: 78800 },
  { level: "Level 13", gp: "GP 8700", role: "Director / Selection Grade", entry7th: 123100 },
  { level: "Level 13A", gp: "GP 8900", role: "Senior Director / DIG / Chief Engineer", entry7th: 139600 },
  { level: "Level 14", gp: "GP 10000", role: "Joint Secretary / Inspector General (IG)", entry7th: 144200 },
  { level: "Level 15", gp: "HAG", role: "Principal Secretary / Additional Director General", entry7th: 182200 },
  { level: "Level 16", gp: "HAG+", role: "Special Secretary / Director General of Police (DG)", entry7th: 205400 },
  { level: "Level 17", gp: "Apex Scale", role: "Secretary to the Government of India", entry7th: 225000 },
  { level: "Level 18", gp: "Cabinet Sec", role: "Cabinet Secretary of India", entry7th: 250000 }
];

const faqs = [
  {
    q: "How does this 8th Pay Commission salary calculator calculate in-hand pay?",
    a: "The calculator multiples your current 7th CPC Basic Pay by the selected fitment factor (e.g., 2.25x, 2.57x, or 2.86x). It then applies city-specific HRA rates (30%, 20%, or 10%), resets initial Dearness Allowance to 0%, adds base Transport Allowance (TA), and subtracts mandatory statutory pension deductions (10% under NPS/UPS) alongside healthcare and standard tax withholdings to establish your net monthly take-home salary."
  },
  {
    q: "Why is Dearness Allowance (DA) reset to 0% after the 8th CPC begins?",
    a: "In line with statutory Central Pay Commission precedent, all accumulated Dearness Allowance is subsumed into the new expanded base pay through the fitment multiplier. Because inflation compensation is integrated into basic earnings, the DA counter restarts at 0% and accrues anew semi-annually based on the 12-month average of the All-India Consumer Price Index for Industrial Workers (AICPI-IW)."
  },
  {
    q: "What is the most likely fitment factor for the 8th Pay Commission?",
    a: "While staff side confederations including the National Council (JCM) have advocated for a 2.86x to 3.25x fitment factor using the Dr. Aykroyd nutritional minimum wage formula, fiscal analysts and economic think tanks evaluate a pragmatic baseline range between 2.25x and 2.57x to maintain sustainable revenue-to-expenditure ratios."
  },
  {
    q: "Will state government employees receive 8th Pay Commission salary hikes?",
    a: "Yes. While Central Pay Commissions are constituted specifically for central civil servants, railways, postal staff, and defence personnel, individual state governments routinely issue corresponding Government Orders (GOs) adopting equivalent pay matrices and allowance revisions within 6 to 18 months of central notification."
  },
  {
    q: "How will the Unified Pension Scheme (UPS) and NPS pensions be affected?",
    a: "Under the Unified Pension Scheme (UPS), assured pensions are pegged at 50% of the average basic pay drawn in the 12 months preceding superannuation. Because the 8th Pay Commission significantly expands base salaries, assured retirement pensions and family pension annuities will increase in direct proportion to the fitment ratio."
  }
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <meta name="keywords" content="8th pay commission salary calculator, 8th cpc salary calculator, fitment factor 2026, 8th pay matrix level 1 to 18, in-hand salary hike, central government employees pay revision" />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:locale" content="en_IN" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="8th Pay Commission Hub" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Structured Data JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebApplication",
        "name": "8th Pay Commission Salary Calculator",
        "url": canonicalURL.toString(),
        "operatingSystem": "All",
        "applicationCategory": "FinanceApplication",
        "offers": { "@type": "Offer", "price": "0", "priceCurrency": "INR" }
      },
      {
        "@type": "FAQPage",
        "mainEntity": faqs.map((f) => ({
          "@type": "Question",
          "name": f.q,
          "acceptedAnswer": { "@type": "Answer", "text": f.a }
        }))
      }
    ]
  })} />

  <style>
    :root {
      --bg: #f8fafc;
      --surface: #ffffff;
      --surface-subtle: #f1f5f9;
      --border: #e2e8f0;
      --border-focus: #2563eb;
      --primary: #1d4ed8;
      --primary-hover: #1e40af;
      --primary-gradient: linear-gradient(135deg, #1d4ed8 0%, #0284c7 100%);
      --text: #0f172a;
      --text-muted: #64748b;
      --accent-green: #15803d;
      --accent-green-bg: #dcfce7;
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.05);
      --shadow-md: 0 4px 12px -2px rgba(15, 23, 42, 0.08);
      --shadow-lg: 0 16px 32px -4px rgba(15, 23, 42, 0.08);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif; }
    body { background: var(--bg); color: var(--text); line-height: 1.7; font-size: 15px; -webkit-font-smoothing: antialiased; }
    a { color: var(--primary); text-decoration: none; transition: color 0.2s ease; }
    a:hover { color: var(--primary-hover); }

    /* Top Brand Navigation */
    header.site-nav {
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 1000;
    }
    .nav-container {
      max-width: 1180px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.85rem 1.25rem;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 1.2rem;
      font-weight: 800;
      color: var(--text);
      letter-spacing: -0.02em;
    }
    .brand-badge {
      background: var(--primary-gradient);
      width: 32px;
      height: 32px;
      border-radius: 8px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-weight: 800;
      box-shadow: 0 2px 8px rgba(37, 99, 235, 0.35);
    }
    .nav-links { display: flex; gap: 1.25rem; align-items: center; }
    .nav-links a { color: #334155; font-weight: 600; font-size: 0.9rem; padding: 0.4rem 0.7rem; border-radius: 6px; }
    .nav-links a:hover, .nav-links a.active { color: var(--primary); background: #eff6ff; }
    @media (max-width: 768px) { .nav-links { display: none; } }

    .layout-wrap { max-width: 1100px; margin: 0 auto; padding: 0 1.25rem; }

    /* Hero Header */
    .hero-header {
      text-align: center;
      padding: 2.75rem 1rem 1.75rem;
    }
    .badge-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: #eff6ff;
      border: 1px solid #bfdbfe;
      color: #1d4ed8;
      padding: 0.25rem 0.85rem;
      border-radius: 30px;
      font-size: 0.78rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.85rem;
    }
    .hero-header h1 {
      font-size: clamp(1.85rem, 4vw, 2.75rem);
      font-weight: 800;
      letter-spacing: -0.035em;
      line-height: 1.22;
      margin-bottom: 0.75rem;
      color: var(--text);
    }
    .hero-header p {
      color: var(--text-muted);
      max-width: 740px;
      margin: 0 auto;
      font-size: 1.05rem;
    }

    /* Calculator Main Widget */
    .calc-box {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 2rem;
      box-shadow: var(--shadow-lg);
      margin-bottom: 3.5rem;
    }
    .chip-bar {
      display: flex;
      gap: 0.5rem;
      overflow-x: auto;
      padding: 0.5rem 0 1.25rem;
      scrollbar-width: none;
    }
    .chip-bar::-webkit-scrollbar { display: none; }
    .chip-btn {
      background: #f1f5f9;
      border: 1px solid var(--border);
      color: #475569;
      padding: 0.5rem 1.1rem;
      border-radius: 30px;
      font-size: 0.84rem;
      font-weight: 700;
      white-space: nowrap;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .chip-btn:hover { background: #e2e8f0; }
    .chip-btn.active {
      background: var(--primary);
      border-color: var(--primary);
      color: #ffffff;
      box-shadow: 0 2px 8px rgba(29, 78, 216, 0.3);
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1.25rem;
      margin-bottom: 1.5rem;
    }
    .form-item {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
    .form-item label {
      font-size: 0.82rem;
      font-weight: 700;
      color: #334155;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }
    .form-item input, .form-item select {
      background: #ffffff;
      border: 1.5px solid #cbd5e1;
      color: var(--text);
      padding: 0.75rem 0.9rem;
      border-radius: var(--radius-sm);
      font-size: 0.96rem;
      font-weight: 600;
      outline: none;
      transition: all 0.2s;
    }
    .form-item input:focus, .form-item select:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
    }

    /* Live Summary KPI Units */
    .summary-cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      margin-bottom: 1.5rem;
    }
    .kpi-unit {
      background: #f8fafc;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 1.25rem;
      text-align: center;
      position: relative;
    }
    .kpi-unit.highlight {
      background: #eff6ff;
      border-color: #bfdbfe;
    }
    .kpi-unit.success {
      background: var(--accent-green-bg);
      border-color: #86efac;
    }
    .kpi-unit .kpi-label {
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
      margin-bottom: 0.35rem;
    }
    .kpi-unit .kpi-val {
      font-size: 1.5rem;
      font-weight: 800;
      color: var(--text);
    }
    .kpi-unit.highlight .kpi-val { color: var(--primary); }
    .kpi-unit.success .kpi-val { color: var(--accent-green); }

    /* Detailed Arithmetic Breakdown Table */
    .breakdown-box {
      background: #f8fafc;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 1.5rem;
      margin-top: 1.5rem;
    }
    .breakdown-title {
      font-weight: 800;
      font-size: 1rem;
      color: var(--text);
      margin-bottom: 0.85rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .breakdown-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.94rem;
    }
    .breakdown-table td {
      padding: 0.65rem 0.5rem;
      border-bottom: 1px dashed #cbd5e1;
    }
    .breakdown-table tr:last-child td { border-bottom: none; }
    .breakdown-table td.num {
      text-align: right;
      font-weight: 700;
    }

    /* Long-Form Content Area */
    .article-wrap {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 2.75rem;
      box-shadow: var(--shadow-sm);
      margin-bottom: 3.5rem;
    }
    .article-wrap h2 {
      font-size: 1.6rem;
      font-weight: 800;
      color: var(--text);
      letter-spacing: -0.025em;
      margin: 2.5rem 0 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 2px solid #eff6ff;
    }
    .article-wrap h3 {
      font-size: 1.25rem;
      font-weight: 700;
      color: #1e293b;
      margin: 1.6rem 0 0.65rem;
    }
    .article-wrap p {
      margin-bottom: 1.25rem;
      color: #334155;
      font-size: 1.02rem;
    }
    .article-wrap ul, .article-wrap ol {
      margin-bottom: 1.5rem;
      padding-left: 1.5rem;
      color: #334155;
    }
    .article-wrap li { margin-bottom: 0.45rem; }

    .formula-banner {
      background: #eff6ff;
      border-left: 4px solid var(--primary);
      padding: 1.15rem 1.35rem;
      border-radius: 0 8px 8px 0;
      margin: 1.5rem 0;
      font-family: monospace;
      font-size: 0.96rem;
      color: #1e40af;
    }

    /* Responsive Data Tables */
    .table-responsive {
      overflow-x: auto;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      margin: 1.5rem 0;
    }
    table.data-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 0.92rem;
    }
    table.data-table th, table.data-table td {
      padding: 0.85rem 1rem;
      border-bottom: 1px solid var(--border);
    }
    table.data-table th {
      background: #f8fafc;
      color: #475569;
      font-weight: 700;
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    table.data-table tr:hover td { background: #f8fafc; }

    /* Level Badges Grid */
    .level-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
      gap: 0.65rem;
      margin: 1.25rem 0;
    }
    .level-pill {
      background: #ffffff;
      border: 1px solid var(--border);
      padding: 0.75rem 0.5rem;
      border-radius: var(--radius-sm);
      text-align: center;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .level-pill:hover {
      border-color: var(--primary);
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
      background: #eff6ff;
    }
    .level-pill strong { display: block; font-size: 0.95rem; color: var(--text); }
    .level-pill span { font-size: 0.78rem; color: var(--text-muted); }

    /* FAQ System */
    .faq-unit {
      border-bottom: 1px solid var(--border);
      padding: 1.15rem 0;
    }
    .faq-quest {
      font-weight: 700;
      color: var(--text);
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 1.02rem;
    }
    .faq-ans {
      display: none;
      padding-top: 0.65rem;
      color: #475569;
      font-size: 0.96rem;
      line-height: 1.7;
    }
    .faq-unit.open .faq-ans { display: block; }
    .faq-unit.open .faq-arrow { transform: rotate(180deg); }
    .faq-arrow { transition: transform 0.2s ease; font-size: 0.75rem; color: var(--text-muted); }

    /* Sticky Mobile Summary Bar */
    .mobile-sticky-bar {
      display: none;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: rgba(255, 255, 255, 0.96);
      border-top: 1px solid var(--border);
      backdrop-filter: blur(12px);
      padding: 0.75rem 1.25rem;
      z-index: 990;
      justify-content: space-between;
      align-items: center;
      box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.06);
    }
    .mobile-sticky-bar .lbl { font-size: 0.74rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700; }
    .mobile-sticky-bar .val { font-size: 1.2rem; font-weight: 800; color: var(--primary); }
    @media (max-width: 768px) {
      .mobile-sticky-bar { display: flex; }
      body { padding-bottom: 4.5rem; }
    }

    /* Footer */
    footer {
      background: #ffffff;
      border-top: 1px solid var(--border);
      padding: 3.5rem 1.25rem 2.5rem;
      font-size: 0.88rem;
      color: #64748b;
    }
    .footer-content {
      max-width: 1100px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1.25rem;
    }
    .footer-links a { color: #475569; margin-left: 1.25rem; }
    .footer-links a:hover { color: var(--primary); }
    .disclaimer-strip {
      max-width: 1100px;
      margin: 2rem auto 0;
      padding: 1.25rem;
      background: #f8fafc;
      border: 1px solid var(--border);
      border-left: 4px solid #94a3b8;
      border-radius: var(--radius-sm);
      font-size: 0.82rem;
      line-height: 1.6;
      color: #64748b;
    }
  </style>
</head>
<body>

  <!-- NAVIGATION HEADER -->
  <header class="site-nav">
    <div class="nav-container">
      <a href="/" class="brand">
        <span class="brand-badge">₹</span>
        8paycommission
      </a>
      <nav class="nav-links">
        <a href="/">Home</a>
        <a href="/salary-calculator" class="active">Salary Calculator</a>
        <a href="/pay-matrix">Pay Matrix</a>
        <a href="/pension-calculator">Pension Calculator</a>
        <a href="/arrears-calculator">Arrears</a>
      </nav>
    </div>
  </header>

  <main class="layout-wrap">

    <!-- HERO HEADER -->
    <header class="hero-header">
      <div class="badge-pill">Central & State Service Salary Modeling</div>
      <h1>8th Pay Commission Salary Calculator</h1>
      <p>Estimate revised basic pay, city HRA, Dearness Allowance roll-in, and monthly in-hand net salary based on expected fitment factors (1.92x to 3.00x).</p>
    </header>

    <!-- INTERACTIVE ABOVE-THE-FOLD SALARY CALCULATOR -->
    <section class="calc-box" aria-label="8th Pay Commission Interactive Calculator">
      
      <!-- Fitment Multiplier Pill Selector -->
      <div style="margin-bottom: 1.25rem;">
        <span style="font-size: 0.8rem; font-weight: 700; color: #64748b; text-transform: uppercase;">Expected Fitment Factor:</span>
        <div class="chip-bar" id="factorPills">
          <button class="chip-btn" data-f="1.92">1.92x (Conservative)</button>
          <button class="chip-btn" data-f="2.25">2.25x (Baseline Model)</button>
          <button class="chip-btn" data-f="2.57">2.57x (7th CPC Parity)</button>
          <button class="chip-btn active" data-f="2.86">2.86x (Federation Target)</button>
        </div>
      </div>

      <!-- Controls Grid -->
      <div class="form-grid">
        <div class="form-item">
          <label for="levelSelect">Pay Matrix Level (Preset)</label>
          <select id="levelSelect">
            {payMatrixLevels.map((lvl) => (
              <option value={lvl.entry7th} selected={lvl.level === "Level 6"}>
                {lvl.level} ({lvl.gp}) - Min ₹{lvl.entry7th.toLocaleString('en-IN')}
              </option>
            ))}
          </select>
        </div>

        <div class="form-item">
          <label for="basicInput">Current 7th CPC Basic Pay (₹)</label>
          <input type="number" id="basicInput" value="35400" min="18000" step="100" />
        </div>

        <div class="form-item">
          <label for="fitmentSelect">Fitment Multiplier</label>
          <select id="fitmentSelect">
            <option value="1.92">1.92x (Conservative Baseline)</option>
            <option value="2.10">2.10x (Balanced Growth)</option>
            <option value="2.25">2.25x (Consensus Projection)</option>
            <option value="2.57">2.57x (Equivalent to 7th CPC)</option>
            <option value="2.86" selected>2.86x (Staff Federation Demand)</option>
            <option value="3.00">3.00x (Aspirational Ceiling)</option>
          </select>
        </div>

        <div class="form-item">
          <label for="citySelect">City Classification (HRA Rate)</label>
          <select id="citySelect">
            <option value="0.30" selected>Class X (30% - Metro: Delhi, Mumbai, Chennai)</option>
            <option value="0.20">Class Y (20% - Tier-2 Towns)</option>
            <option value="0.10">Class Z (10% - Small Towns/Rural)</option>
          </select>
        </div>
      </div>

      <!-- Real-Time Metric Highlights -->
      <div class="summary-cards">
        <div class="kpi-unit">
          <div class="kpi-label">Revised 8th CPC Basic</div>
          <div class="kpi-val" id="dispBasic">₹1,01,244</div>
        </div>
        <div class="kpi-unit highlight">
          <div class="kpi-label">Projected Gross Monthly</div>
          <div class="kpi-val" id="dispGross">₹1,35,217</div>
        </div>
