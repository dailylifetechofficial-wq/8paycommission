---
const pageTitle = "8th Pay Commission Salary Calculator";
const pageDescription = "Calculate your projected 8th CPC revised basic pay, HRA, and estimated gross salary.";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <style>
      :root { font-family: system-ui, sans-serif; color: #0f172a; background: #f8fafc; }
      * { box-sizing: border-box; }
      body { margin: 0; padding: 1rem; }
      main { max-width: 960px; margin: 0 auto; }
      header { text-align: center; margin: 1rem 0 2rem; }
      .card { background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.5rem; box-shadow: 0 4px 12px rgba(15, 23, 42, .06); }
      .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; }
      label { display: block; font-weight: 600; margin-bottom: .4rem; }
      input, select { width: 100%; padding: .75rem; border: 1px solid #cbd5e1; border-radius: 6px; font: inherit; }
      .results { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; margin-top: 1.5rem; }
      .result { padding: 1rem; text-align: center; background: #f1f5f9; border-radius: 8px; }
      .result strong { display: block; color: #475569; font-size: .8rem; text-transform: uppercase; }
      .result span { display: block; margin-top: .35rem; font-size: 1.35rem; font-weight: 700; }
      .highlight { background: #dcfce7; color: #166534; }
      article { margin-top: 2rem; line-height: 1.7; }
    </style>
  </head>
  <body>
    <main>
      <header>
        <h1>8th Pay Commission Salary Calculator</h1>
        <p>Estimate revised basic pay, HRA, and monthly gross salary under different fitment factors.</p>
      </header>

      <section class="card" aria-label="8th Pay Commission salary calculator">
        <div class="grid">
          <div>
            <label for="currentBasic">Current 7th CPC Basic Pay (₹)</label>
            <input id="currentBasic" type="number" value="35400" min="18000" step="100" />
          </div>
          <div>
            <label for="fitmentFactor">Expected Fitment Factor</label>
            <select id="fitmentFactor">
              <option value="1.92">1.92x</option>
              <option value="2.28">2.28x</option>
              <option value="2.57">2.57x</option>
              <option value="2.86" selected>2.86x</option>
              <option value="3">3.00x</option>
              <option value="3.68">3.68x</option>
            </select>
          </div>
          <div>
            <label for="cityClass">City Classification</label>
            <select id="cityClass">
              <option value="0.30" selected>Class X — 30% HRA</option>
              <option value="0.20">Class Y — 20% HRA</option>
              <option value="0.10">Class Z — 10% HRA</option>
            </select>
          </div>
        </div>

        <div class="results" aria-live="polite">
          <div class="result"><strong>Revised 8th CPC Basic</strong><span id="dispBasic">₹0</span></div>
          <div class="result"><strong>Estimated Revised HRA</strong><span id="dispHra">₹0</span></div>
          <div class="result highlight"><strong>Estimated Gross Salary</strong><span id="dispGross">₹0</span></div>
        </div>
      </section>

      <article class="card">
        <h2>How the calculator works</h2>
        <p>Revised basic pay is estimated by multiplying your current 7th CPC basic pay by the selected fitment factor. Estimated HRA is then calculated using the selected city classification. These figures are projections only and are not official 8th CPC rates.</p>
      </article>
    </main>

    <script is:inline>
      function calculateSalary() {
        const basic = Number(document.getElementById('currentBasic').value) || 0;
        const fitment = Number(document.getElementById('fitmentFactor').value) || 2.86;
        const hraRate = Number(document.getElementById('cityClass').value) || 0.30;
        const revisedBasic = Math.round(basic * fitment);
        const revisedHra = Math.round(revisedBasic * hraRate);
        const transportAllowance = basic >= 35400 ? 3600 : 1350;
        const gross = revisedBasic + revisedHra + transportAllowance;
        document.getElementById('dispBasic').textContent = '₹' + revisedBasic.toLocaleString('en-IN');
        document.getElementById('dispHra').textContent = '₹' + revisedHra.toLocaleString('en-IN');
        document.getElementById('dispGross').textContent = '₹' + gross.toLocaleString('en-IN');
      }
      document.getElementById('currentBasic').addEventListener('input', calculateSalary);
      document.getElementById('fitmentFactor').addEventListener('change', calculateSalary);
      document.getElementById('cityClass').addEventListener('change', calculateSalary);
      calculateSalary();
    </script>
  </body>
</html>
