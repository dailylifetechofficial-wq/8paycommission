    overflow-x: auto;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    margin: 1.25rem 0;
  }

  table.data-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 760px;
    text-align: left;
  }

  table.data-table th,
  table.data-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid #e2e8f0;
  }

  table.data-table th {
    background: #f8fafc;
    color: #475569;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .level-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 0.7rem;
    margin: 1.3rem 0;
  }

  .level-pill {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    text-align: center;
    padding: 0.8rem 0.55rem;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .level-pill:hover {
    transform: translateY(-2px);
    border-color: #1d4ed8;
    box-shadow: 0 12px 24px -18px rgba(29, 78, 216, 0.4);
  }

  .level-pill strong {
    display: block;
    font-size: 0.95rem;
  }

  .level-pill span {
    font-size: 0.78rem;
    color: #64748b;
  }

  .faq-unit {
    border-bottom: 1px solid #e2e8f0;
    padding: 1.1rem 0;
  }

  .faq-quest {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: 700;
    color: #0f172a;
    cursor: pointer;
  }

  .faq-arrow {
    color: #64748b;
    transition: transform 0.2s ease;
  }

  .faq-unit.open .faq-arrow {
    transform: rotate(180deg);
  }

  .faq-ans {
    display: none;
    padding-top: 0.7rem;
    color: #475569;
    line-height: 1.7;
  }

  .faq-unit.open .faq-ans {
    display: block;
  }

  .mobile-sticky-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    display: none;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.8rem 1.2rem;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(12px);
    border-top: 1px solid #e2e8f0;
    z-index: 990;
    box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.06);
  }

  .mobile-sticky-bar .lbl {
    font-size: 0.72rem;
    color: #64748b;
    text-transform: uppercase;
    font-weight: 700;
  }

  .mobile-sticky-bar .val {
    font-size: 1.2rem;
    font-weight: 800;
    color: #1d4ed8;
  }

  @media (max-width: 768px) {
    .mobile-sticky-bar {
      display: flex;
    }

    body {
      padding-bottom: 4.3rem;
    }

    .calc-box,
    .article-wrap {
      padding: 1.25rem;
    }

    .breakdown-title {
      display: block;
    }
  }
</style>

<script is:inline>
  const basicInput = document.getElementById('basicInput');
  const levelSelect = document.getElementById('levelSelect');
  const fitmentSelect = document.getElementById('fitmentSelect');
  const citySelect = document.getElementById('citySelect');

  const dispBasic = document.getElementById('dispBasic');
  const dispGross = document.getElementById('dispGross');
  const dispNet = document.getElementById('dispNet');
  const stickyNet = document.getElementById('stickyNet');

  const slipBasic = document.getElementById('slipBasic');
  const slipHra = document.getElementById('slipHra');
  const slipTa = document.getElementById('slipTa');
  const slipGross = document.getElementById('slipGross');
  const slipNps = document.getElementById('slipNps');
  const slipDeduct = document.getElementById('slipDeduct');
  const slipNet = document.getElementById('slipNet');
  const slipLevelLabel = document.getElementById('slipLevelLabel');

  function calculate() {
    const basic = Number(basicInput.value || 0);
    const factor = Number(fitmentSelect.value) || 2.86;
    const hraRate = Number(citySelect.value) || 0.3;

    const revisedBasic = Math.round(basic * factor);
    const revisedHra = Math.round(revisedBasic * hraRate);
    const ta = basic >= 35400 ? 3600 : 1350;
    const gross = revisedBasic + revisedHra + ta;
    const nps = Math.round(revisedBasic * 0.1);

    let otherDeduct = 650;
    if (revisedBasic > 80000) otherDeduct = 6300;
    else if (revisedBasic > 50000) otherDeduct = 2500;

    const netInHand = Math.max(0, gross - (nps + otherDeduct));

    const money = (value) => '₹' + Math.round(value).toLocaleString('en-IN');

    dispBasic.textContent = money(revisedBasic);
    dispGross.textContent = money(gross);
    dispNet.textContent = money(netInHand);
    if (stickyNet) stickyNet.textContent = money(netInHand);

    slipBasic.textContent = money(revisedBasic);
    slipHra.textContent = money(revisedHra);
    slipTa.textContent = money(ta);
    slipGross.textContent = money(gross);
    slipNps.textContent = '-₹' + nps.toLocaleString('en-IN');
    slipDeduct.textContent = '-₹' + otherDeduct.toLocaleString('en-IN');
    slipNet.textContent = money(netInHand);

    const selectedOption = levelSelect.options[levelSelect.selectedIndex];
    if (selectedOption) {
      slipLevelLabel.textContent = selectedOption.text.split(' - ')[0];
    }
  }

  basicInput.addEventListener('input', calculate);
  fitmentSelect.addEventListener('change', calculate);
  citySelect.addEventListener('change', calculate);

  levelSelect.addEventListener('change', (event) => {
    basicInput.value = event.target.value;
    calculate();
  });

  const pillButtons = document.querySelectorAll('#factorPills .chip-btn');
  pillButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      pillButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      fitmentSelect.value = btn.getAttribute('data-f');
      calculate();
    });
  });

  document.querySelectorAll('.level-pill').forEach((pill) => {
    pill.addEventListener('click', () => {
      const value = pill.getAttribute('data-base');
      basicInput.value = value;
      levelSelect.value = value;
      calculate();
    });
  });

  document.querySelectorAll('.faq-quest').forEach((button) => {
    button.addEventListener('click', () => {
      const item = button.parentElement;
      item.classList.toggle('open');
    });
  });

  calculate();
</script>
