---
import SiteLayout from "../layouts/SiteLayout.astro";

const title = "8th Pay Commission Salary Calculator";
const description = "Calculate projected 8th Pay Commission basic pay, HRA, and gross salary.";
---

<SiteLayout title={title} description={description}>
  <article>
    <h1>{title}</h1>
    <p>{description}</p>
    <p>Use the navigation above to open the pay matrix, pension, HRA, DA, and other 8th Pay Commission pages.</p>

    <section id="calculator" style="margin-top: 2rem; padding: 1.5rem; background: white; border: 1px solid #e2e8f0; border-radius: 14px;">
      <h2>Salary calculator</h2>
      <label for="basicPay">Current basic pay (₹)</label>
      <input id="basicPay" type="number" value="35400" min="0" style="display:block; margin:.5rem 0 1rem; padding:.7rem;" />
      <label for="fitment">Fitment factor</label>
      <select id="fitment" style="display:block; margin:.5rem 0 1rem; padding:.7rem;">
        <option value="1.92">1.92x</option>
        <option value="2.25">2.25x</option>
        <option value="2.57">2.57x</option>
        <option value="2.86" selected>2.86x</option>
      </select>
      <p>Projected revised basic pay: <strong id="result">₹1,01,244</strong></p>
    </section>
  </article>
</SiteLayout>

<script is:inline>
  const basic = document.getElementById('basicPay');
  const fitment = document.getElementById('fitment');
  const result = document.getElementById('result');
  const calculate = () => { result.textContent = '₹' + Math.round((Number(basic.value) || 0) * (Number(fitment.value) || 0)).toLocaleString('en-IN'); };
  basic.addEventListener('input', calculate);
  fitment.addEventListener('change', calculate);
</script>
