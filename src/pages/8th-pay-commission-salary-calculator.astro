  }

  .breakdown-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .breakdown-table td {
    padding: 0.7rem 0.5rem;
    border-bottom: 1px dashed #cbd5e1;
  }

  .breakdown-table tr:last-child td {
    border-bottom: none;
  }

  .breakdown-table td.num {
    text-align: right;
    font-weight: 700;
  }

  .total-row {
    background: #f1f5f9;
    font-weight: 800;
  }

  .net-row {
    background: #dcfce7;
    font-weight: 800;
  }

  .negative {
    color: #dc2626;
  }

  .muted-copy {
    color: #64748b;
  }

  .article-wrap {
    padding: 2rem 2.25rem 2.5rem;
  }

  .article-wrap h2 {
    font-size: clamp(1.4rem, 2vw, 1.8rem);
    margin: 2rem 0 1rem;
