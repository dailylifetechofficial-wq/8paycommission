---
import SiteLayout from '../layouts/SiteLayout.astro';

const siteUrl = 'https://8paycommission.com';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const pageTitle = '8th Pay Commission Salary Calculator: In-Hand Hike, Pay Matrix & Fitment Factor';
const pageDescription = 'Calculate your projected 8th Pay Commission salary hike with detailed arithmetic. Instant basic pay, HRA, TA, NPS deductions, and net monthly take-home estimates across all levels.';

const payMatrixLevels = [
  { level: 'Level 1', gp: 'GP 1800', role: 'MTS / Group D Staff', entry7th: 18000 },
  { level: 'Level 2', gp: 'GP 1900', role: 'Lower Division Clerk (LDC)', entry7th: 19900 },
  { level: 'Level 3', gp: 'GP 2000', role: 'Senior Clerk / Constable / Driver', entry7th: 21700 },
  { level: 'Level 4', gp: 'GP 2400', role: 'Upper Division Clerk (UDC) / Head Constable', entry7th: 25500 },
  { level: 'Level 5', gp: 'GP 2800', role: 'Auditor / Accountant / Junior Assistant', entry7th: 29200 },
  { level: 'Level 6', gp: 'GP 4200', role: 'Inspector / Sub-Inspector / Primary Teacher', entry7th: 35400 },
  { level: 'Level 7', gp: 'GP 4600', role: 'Assistant Section Officer (ASO) / Section Engineer', entry7th: 44900 },
  { level: 'Level 8', gp: 'GP 4800', role: 'Assistant Accounts Officer (AAO) / Section Officer', entry7th: 47600 },
  { level: 'Level 9', gp: 'GP 5400 (PB-2)', role: 'Senior Accounts Officer / Assistant Director', entry7th: 53100 },
  { level: 'Level 10', gp: 'GP 5400 (PB-3)', role: 'Group-A Entry / SDM / DSP / Assistant Commissioner', entry7th: 56100 },
  { level: 'Level 11', gp: 'GP 6600', role: 'Under Secretary / Executive Engineer', entry7th: 67700 },
  { level: 'Level 12', gp: 'GP 7600', role: 'Deputy Secretary / Superintendent Engineer', entry7th: 78800 },
  { level: 'Level 13', gp: 'GP 8700', role: 'Director / Selection Grade', entry7th: 123100 },
  { level: 'Level 13A', gp: 'GP 8900', role: 'Senior Director / DIG / Chief Engineer', entry7th: 139600 },
  { level: 'Level 14', gp: 'GP 10000', role: 'Joint Secretary / Inspector General (IG)', entry7th: 144200 },
  { level: 'Level 15', gp: 'HAG', role: 'Principal Secretary / Additional Director General', entry7th: 182200 },
  { level: 'Level 16', gp: 'HAG+', role: 'Special Secretary / Director General of Police (DG)', entry7th: 205400 },
  { level: 'Level 17', gp: 'Apex Scale', role: 'Secretary to the Government of India', entry7th: 225000 },
  { level: 'Level 18', gp: 'Cabinet Sec', role: 'Cabinet Secretary of India', entry7th: 250000 },
];

const faqs = [
  {
    q: 'How does this 8th Pay Commission salary calculator calculate in-hand pay?',
    a: 'The calculator multiplies your current 7th CPC Basic Pay by the selected fitment factor (for example 2.25x, 2.57x or 2.86x). It then applies city-specific HRA rates (30%, 20% or 10%), resets the initial Dearness Allowance to 0%, adds transport allowance, and subtracts mandatory pension contributions and healthcare/tax deductions to estimate your net monthly salary.',
  },
  {
    q: 'Why is Dearness Allowance (DA) reset to 0% after the 8th CPC begins?',
    a: 'In line with statutory precedent, accumulated DA gets merged into the revised base pay through the fitment multiplier. Because inflation compensation is absorbed into basic earnings, DA is effectively reset and reintroduced later as part of the post-implementation allowance framework.',
  },
  {
    q: 'What is the most likely fitment factor for the 8th Pay Commission?',
    a: 'The most discussed range is between 2.25x and 2.86x. The 2.86x figure remains a benchmark cited by staff federations and is often modeled as a target scenario, while 2.25x is treated as a practical baseline estimate for planning purposes.',
  },
  {
    q: 'Will state government employees receive 8th Pay Commission salary hikes?',
    a: 'The central pay commission is for central employees, but states often align their salary structures with central revisions. State governments typically issue separate orders, adopting similar pay matrices and allowance changes over a short period after the central decision.',
  },
  {
    q: 'How will the Unified Pension Scheme (UPS) and NPS pensions be affected?',
    a: 'Under UPS, pensions are linked to average emoluments while the broader pay revision increases the base from which future pension calculations are derived. Higher revised salaries lead to larger pension entitlements and commensurately larger retirement contributions.',
  },
];
---

<SiteLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'WebApplication',
        name: '8th Pay Commission Salary Calculator',
        url: canonicalURL.toString(),
        operatingSystem: 'All',
        applicationCategory: 'FinanceApplication',
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
      },
      {
        '@type': 'FAQPage',
        mainEntity: faqs.map((item) => ({
          '@type': 'Question',
          name: item.q,
          acceptedAnswer: { '@type': 'Answer', text: item.a },
        })),
      },
    ],
  })} />

  <main class="page-shell">
    <header class="hero-header">
      <div class="badge-pill">Central &amp; State Service Salary Modeling</div>
      <h1>8th Pay Commission Salary Calculator</h1>
      <p>
        Estimate revised basic pay, city HRA, Dearness Allowance roll-in, and monthly in-hand pay based on expected fitment factors from 1.92x to 3.00x.
      </p>
    </header>

    <section class="calc-box" aria-label="8th Pay Commission Interactive Calculator">
      <div style="margin-bottom: 1.25rem;">
        <span class="factor-label">Expected Fitment Factor:</span>
        <div class="chip-bar" id="factorPills">
          <button class="chip-btn" data-f="1.92">1.92x (Conservative)</button>
          <button class="chip-btn" data-f="2.25">2.25x (Baseline Model)</button>
          <button class="chip-btn" data-f="2.57">2.57x (7th CPC Parity)</button>
          <button class="chip-btn active" data-f="2.86">2.86x (Federation Target)</button>
        </div>
      </div>

      <div class="form-grid">
        <div class="form-item">
          <label for="levelSelect">Pay Matrix Level (Preset)</label>
          <select id="levelSelect">
            {payMatrixLevels.map((lvl) => (
              <option value={lvl.entry7th} selected={lvl.level === 'Level 6'}>
                {lvl.level} ({lvl.gp}) - Min ₹{lvl.entry7th.toLocaleString('en-IN')}
              </option>
            ))}
          </select>
        </div>

        <div class="form-item">
          <label for="basicInput">Current 7th CPC Basic Pay (₹)</label>
          <input type="number" id="basicInput" value="35400" min="18000" step="100" />
        </div>

        <div class="form-item">
          <label for="fitmentSelect">Fitment Multiplier</label>
          <select id="fitmentSelect">
            <option value="1.92">1.92x (Conservative Baseline)</option>
            <option value="2.10">2.10x (Balanced Growth)</option>
            <option value="2.25">2.25x (Consensus Projection)</option>
            <option value="2.57">2.57x (Equivalent to 7th CPC)</option>
            <option value="2.86" selected>2.86x (Staff Federation Demand)</option>
            <option value="3.00">3.00x (Aspirational Ceiling)</option>
          </select>
        </div>

        <div class="form-item">
          <label for="citySelect">City Classification (HRA Rate)</label>
          <select id="citySelect">
            <option value="0.30" selected>Class X (30% - Metro: Delhi, Mumbai, Chennai)</option>
            <option value="0.20">Class Y (20% - Tier-2 Towns)</option>
            <option value="0.10">Class Z (10% - Small Towns / Rural)</option>
          </select>
        </div>
      </div>

      <div class="summary-cards">
        <div class="kpi-unit">
          <div class="kpi-label">Revised 8th CPC Basic</div>
          <div class="kpi-val" id="dispBasic">₹1,01,244</div>
        </div>
        <div class="kpi-unit highlight">
          <div class="kpi-label">Projected Gross Monthly</div>
          <div class="kpi-val" id="dispGross">₹1,35,217</div>
        </div>
        <div class="kpi-unit success">
          <div class="kpi-label">Est. In-Hand Monthly Take-Home</div>
          <div class="kpi-val" id="dispNet">₹1,18,793</div>
        </div>
      </div>

      <div class="breakdown-box">
        <div class="breakdown-title">
          <span>Projected Monthly Payslip Calculation Breakdown</span>
          <span class="breakdown-level" id="slipLevelLabel">Level 6 (GP 4200)</span>
        </div>
        <table class="breakdown-table">
          <tbody>
            <tr>
              <td>Revised Basic Pay (7th CPC Basic × Fitment Factor)</td>
              <td class="num" id="slipBasic">₹1,01,244</td>
            </tr>
            <tr>
              <td>Dearness Allowance (DA) — <span class="muted-copy">Reset to 0% upon rollout</span></td>
              <td class="num">₹0</td>
            </tr>
            <tr>
              <td>House Rent Allowance (HRA applied to expanded basic pay)</td>
              <td class="num" id="slipHra">₹30,373</td>
            </tr>
            <tr>
              <td>Transport Allowance (Base TA allocated to cadre tier)</td>
              <td class="num" id="slipTa">₹3,600</td>
            </tr>
            <tr class="total-row">
              <td>Estimated Monthly Gross Emoluments</td>
              <td class="num" id="slipGross">₹1,35,217</td>
            </tr>
            <tr>
              <td>Mandatory Pension Contribution (10% of Basic Pay under NPS/UPS)</td>
              <td class="num negative" id="slipNps">-₹10,124</td>
            </tr>
            <tr>
              <td>Estimated Statutory Deductions (CGHS &amp; professional tax)</td>
              <td class="num negative" id="slipDeduct">-₹6,300</td>
            </tr>
            <tr class="net-row">
              <td>Projected Net In-Hand Monthly Salary</td>
              <td class="num" id="slipNet">₹1,18,793</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <article class="article-wrap">
      <h2>Comprehensive Guide: Inside the 8th Central Pay Commission Salary Framework</h2>
      <p>
        The 8th Central Pay Commission is expected to reshape the financial structure for over 4.8 million central government employees and pensioners. A fitment factor is the primary mechanism driving the increase in revised basic salary, and it determines the baseline from which allowances, pension entitlements, and in-hand take-home pay are recalculated.
      </p>
      <p>
        The arithmetic is straightforward: current 7th CPC basic pay gets multiplied by the selected fitment factor, then HRA and transport allowance are recalculated on the revised base. In practice, that means a higher basic salary, larger HRA payouts in metro cities, and a higher monthly take-home figure after mandatory pension deductions and other deductions.
      </p>

      <h2>1. The Arithmetic Foundation: Understanding the Fitment Factor</h2>
      <p>
        At the centre of every 8th Pay Commission calculator is the fitment factor. It acts as an across-the-board multiplier applied to existing basic pay to generate the revised pay matrix value. The selected multiplier carries a direct implication for revised salary levels across all ranks, from entry-level staff to senior central secretariat employees.
      </p>
      <div class="formula-banner">
        Revised 8th CPC Basic Pay = Existing 7th CPC Basic Pay × Approved Fitment Multiplier
      </div>
      <p>
        If your existing basic pay is ₹35,400 and the approved multiplier is 2.86x, the projected revised basic becomes ₹1,01,244. Once HRA and TA are added, the monthly gross rises materially, even before pension deductions and taxes are applied.
      </p>

      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>Fitment Multiplier</th>
              <th>Model</th>
              <th>Projected Level 1 Minimum Basic</th>
              <th>Implication</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>1.92x</strong></td>
              <td>Fiscal restraint</td>
              <td>₹34,560</td>
              <td>Conservative increase with controlled budgetary impact.</td>
            </tr>
            <tr>
              <td><strong>2.25x</strong></td>
              <td>Consensus baseline</td>
              <td>₹40,500</td>
              <td>Balanced model often used in medium-term salary projections.</td>
            </tr>
            <tr>
              <td><strong>2.57x</strong></td>
              <td>Parity scenario</td>
              <td>₹46,260</td>
              <td>Replicates the broad scale of the 7th Pay Commission uplift.</td>
            </tr>
            <tr>
              <td><strong>2.86x</strong></td>
              <td>Federation target</td>
              <td>₹51,480</td>
              <td>Often cited as a staffing demand scenario tied to inflation and social cost benchmarks.</td>
            </tr>
            <tr>
              <td><strong>3.00x</strong></td>
              <td>Aspirational ceiling</td>
              <td>₹54,000</td>
              <td>Upper-end projection used for hypothetical maximum-case planning.</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h2>2. Step-by-Step Methodology: How Monthly In-Hand Pay is Computed</h2>
      <p>
        The revised salary is not simply the product of basic pay and a multiplier. A realistic projection also includes HRA, transport allowance, pension deductions, and tax withholdings. That is why the net paycheck can appear lower than the headline gross salary estimate.
      </p>
      <h3>Step 1: Baseline Recalibration</h3>
      <p>
        The current 7th CPC basic pay is multiplied by the chosen fitment factor. In the example calculator, an employee at Level 6 with a basic pay of ₹35,400 becomes ₹1,01,244 at 2.86x. This enlarged basic is the new salary foundation.
      </p>
      <h3>Step 2: Dearness Allowance Roll-In</h3>
      <p>
        Under the usual framework, all accumulated Dearness Allowance gets merged into the revised salary baseline. The DA rate effectively resets to 0% at the implementation date, and future annual revisions are handled separately under the post-implementation allowance cycle.
      </p>
      <h3>Step 3: HRA Revision</h3>
      <p>
        HRA then applies to the revised basic pay according to city class: 30% for Class X metros, 20% for Class Y towns, and 10% for Class Z rural or smaller locations. Because this allowance is applied to the expanded base, it rises materially with each higher fitment factor.
      </p>
      <h3>Step 4: Transport Allowance Calibration</h3>
      <p>
        TA is added to the revised gross salary calculation. In practice, it varies by pay level and posting location, but the calculator uses a practical base allowance for the relevant salary bracket so users can compare likely monthly cash flows.
      </p>
      <h3>Step 5: Statutory Deductions</h3>
      <p>
        The final in-hand estimate subtracts mandatory pension contributions and other statutory deductions such as CGHS and tax withholdings. This is why gross salary and take-home pay differ: the calculator is designed to estimate realistic net monthly earnings, not just the pre-deduction salary figure.
      </p>

      <h2>3. 7th vs 8th CPC Pay Matrix Benchmark Projections</h2>
      <p>
        The 7th CPC introduced an 18-level pay matrix and standardised salary entry points across central government roles. The 8th Pay Commission is expected to preserve the same structural approach while revising starting pay points upward under a new fitment factor framework.
      </p>
      <div class="level-grid">
        {payMatrixLevels.map((item) => (
          <div class="level-pill" data-base={item.entry7th}>
            <strong>{item.level}</strong>
            <span>7th: ₹{item.entry7th.toLocaleString('en-IN')}</span>
          </div>
        ))}
      </div>

      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>Pay Level</th>
              <th>Grade Pay</th>
              <th>Cadre Role</th>
              <th>7th CPC Base</th>
              <th>8th CPC (2.25x)</th>
              <th>8th CPC (2.86x)</th>
            </tr>
          </thead>
          <tbody>
            {payMatrixLevels.map((row) => (
              <tr>
                <td><strong>{row.level}</strong></td>
                <td>{row.gp}</td>
                <td>{row.role}</td>
                <td>₹{row.entry7th.toLocaleString('en-IN')}</td>
                <td>₹{Math.round(row.entry7th * 2.25).toLocaleString('en-IN')}</td>
                <td style="color: #1d4ed8; font-weight: 700;">₹{Math.round(row.entry7th * 2.86).toLocaleString('en-IN')}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2>4. Frequently Asked Questions</h2>
      <div class="faq-list">
        {faqs.map((faq) => (
          <div class="faq-unit">
            <div class="faq-quest">
              <span>{faq.q}</span>
              <span class="faq-arrow">▼</span>
            </div>
            <div class="faq-ans">{faq.a}</div>
          </div>
        ))}
      </div>
    </article>

    <div class="mobile-sticky-bar">
      <div>
        <div class="lbl">Estimated In-Hand Pay</div>
        <div class="val" id="stickyNet">₹1,18,793</div>
      </div>
      <a href="#basicInput" class="chip-btn active">Recalculate</a>
    </div>
  </main>
</SiteLayout>

<style>
  :global(body) {
    background: #f8fafc;
    color: #0f172a;
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
  }

  .page-shell {
    width: min(1100px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 2rem 0 3rem;
  }

  .hero-header {
    text-align: center;
    padding: 2.5rem 1rem 1.5rem;
  }

  .badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    color: #1d4ed8;
    padding: 0.25rem 0.85rem;
    border-radius: 30px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 0.9rem;
  }

  .hero-header h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.9rem, 4vw, 2.8rem);
    line-height: 1.2;
    letter-spacing: -0.035em;
  }

  .hero-header p {
    color: #64748b;
    max-width: 760px;
    margin: 0 auto;
    font-size: 1.04rem;
  }

  .calc-box,
  .article-wrap {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    box-shadow: 0 16px 32px -4px rgba(15, 23, 42, 0.08);
  }

  .calc-box {
    padding: 2rem;
    margin-bottom: 3rem;
  }

  .factor-label {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 0.75rem;
  }

  .chip-bar {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding-bottom: 0.25rem;
  }

