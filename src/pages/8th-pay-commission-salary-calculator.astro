    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .chip-btn:hover {
    background: #e2e8f0;
  }

  .chip-btn.active {
    background: #1d4ed8;
    border-color: #1d4ed8;
    color: #ffffff;
    box-shadow: 0 2px 8px rgba(29, 78, 216, 0.3);
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
    margin: 1.5rem 0;
  }

