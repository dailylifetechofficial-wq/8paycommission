  <!-- STICKY MOBILE SUMMARY BAR -->
  <div class="mobile-sticky-bar">
    <div>
      <div class="lbl">Projected 8th CPC Basic</div>
      <div class="val" id="stickyBasic">₹1,01,244</div>
    </div>
    <a href="#fitmentBasicInput" class="chip-btn active" style="padding: 0.45rem 0.95rem; font-size: 0.82rem;">Recalculate</a>
  </div>

  <!-- CLIENT-SIDE COMPUTATION JAVASCRIPT -->
  <script is:inline>
    const fitmentBasicInput = document.getElementById('fitmentBasicInput');
    const fitmentLevelPreset = document.getElementById('fitmentLevelPreset');
    const fitmentMultiplierInput = document.getElementById('fitmentMultiplierInput');
    const fitmentCityTier = document.getElementById('fitmentCityTier');

    const disp7thBasic = document.getElementById('disp7thBasic');
    const disp8thBasic = document.getElementById('disp8thBasic');
    const dispBasicDiff = document.getElementById('dispBasicDiff');
    const stickyBasic = document.getElementById('stickyBasic');

    const slipCurrentBasic = document.getElementById('slipCurrentBasic');
    const slipFactorLabel = document.getElementById('slipFactorLabel');
    const slipRevisedBasic = document.getElementById('slipRevisedBasic');
    const slipHra = document.getElementById('slipHra');
    const slipTa = document.getElementById('slipTa');
    const slipGross = document.getElementById('slipGross');
    const slipLevelLabel = document.getElementById('slipLevelLabel');

    function calculateFitment() {
      const basic = parseFloat(fitmentBasicInput.value) || 0;
      const factor = parseFloat(fitmentMultiplierInput.value) || 2.86;
      const hraRate = parseFloat(fitmentCityTier.value) || 0.30;

      // Arithmetic Engine
      const revisedBasic = Math.round(basic * factor);
      const basicDiff = revisedBasic - basic;

      const hra = Math.round(revisedBasic * hraRate);
      const ta = basic >= 35400 ? 3600 : 1350;
      const gross = revisedBasic + hra + ta;

      // Update KPI Cards
      disp7thBasic.textContent = '₹' + basic.toLocaleString('en-IN');
      disp8thBasic.textContent = '₹' + revisedBasic.toLocaleString('en-IN');
      dispBasicDiff.textContent = '+₹' + basicDiff.toLocaleString('en-IN');
      if (stickyBasic) stickyBasic.textContent = '₹' + revisedBasic.toLocaleString('en-IN');

      // Update Breakdown Table
      slipCurrentBasic.textContent = '₹' + basic.toLocaleString('en-IN');
      slipFactorLabel.textContent = factor.toFixed(2) + 'x';
      slipRevisedBasic.textContent = '₹' + revisedBasic.toLocaleString('en-IN');
      slipHra.textContent = '₹' + hra.toLocaleString('en-IN');
      slipTa.textContent = '₹' + ta.toLocaleString('en-IN');
      slipGross.textContent = '₹' + gross.toLocaleString('en-IN');

      // Update Subtitle Label
      const selectedLevel = fitmentLevelPreset.options[fitmentLevelPreset.selectedIndex];
      if (selectedLevel) {
        const levelName = selectedLevel.text.split(' - ')[0];
        slipLevelLabel.textContent = `${levelName} • ${factor.toFixed(2)}x Multiplier`;
      }
    }

    // Input Listeners
    fitmentBasicInput.addEventListener('input', calculateFitment);
    fitmentMultiplierInput.addEventListener('input', calculateFitment);
    fitmentCityTier.addEventListener('change', calculateFitment);

    // Preset Level Dropdown Handler
    fitmentLevelPreset.addEventListener('change', (e) => {
      fitmentBasicInput.value = e.target.value;
      calculateFitment();
    });

    // Multiplier Button Pills
    const pills = document.querySelectorAll('#factorPills .chip-btn');
    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        pills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        const val = parseFloat(pill.getAttribute('data-f'));
        fitmentMultiplierInput.value = val;
        calculateFitment();
      });
    });

    // FAQ Accordion Toggle
    document.querySelectorAll('.faq-quest').forEach(q => {
      q.addEventListener('click', () => {
        q.parentElement.classList.toggle('open');
      });
    });

    // Initial Execution
    calculateFitment();
  </script>

