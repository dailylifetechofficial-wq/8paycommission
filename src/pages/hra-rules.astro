          <thead>
            <tr>
              <th>City Classification</th>
              <th>Population Benchmark</th>
              <th>Current 7th CPC Restored Rate</th>
              <th>Projected 8th CPC Baseline</th>
              <th>Statutory Minimum Floor (7th vs 8th CPC)</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Class X (Metro Cities)</strong></td>
