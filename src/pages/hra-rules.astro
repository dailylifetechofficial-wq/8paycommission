  <div class="mobile-sticky-bar">
    <div>
      <div class="lbl">Monthly HRA Entitlement</div>
      <div class="val" id="stickyHra">₹30,373</div>
    </div>
    <a href="#basicPayInput" class="chip-btn active" style="padding: 0.45rem 0.95rem; font-size: 0.82rem;">Recalculate</a>
  </div>

  <!-- CLIENT-SIDE COMPUTATION JAVASCRIPT -->
  <script is:inline>
    const cityTierSelect = document.getElementById('cityTierSelect');
    const basicPayInput = document.getElementById('basicPayInput');
    const fitmentMultiplier = document.getElementById('fitmentMultiplier');
    const accommodationStatus = document.getElementById('accommodationStatus');

    const dispBasic = document.getElementById('dispBasic');
    const dispFloor = document.getElementById('dispFloor');
    const dispHra = document.getElementById('dispHra');
    const stickyHra = document.getElementById('stickyHra');

    const slipComputedBasic = document.getElementById('slipComputedBasic');
    const slipRate = document.getElementById('slipRate');
    const slipRawHra = document.getElementById('slipRawHra');
    const slipFloorVal = document.getElementById('slipFloorVal');
    const slipDeduction = document.getElementById('slipDeduction');
    const slipFinalHra = document.getElementById('slipFinalHra');
    const slipCityLabel = document.getElementById('slipCityLabel');

    function calculateCityHRA() {
      const basic = parseFloat(basicPayInput.value) || 0;
      const fitment = parseFloat(fitmentMultiplier.value) || 1.0;
      const rate = parseFloat(cityTierSelect.value) || 0.30;
      const isGovt = accommodationStatus.value === 'govt';

      const selectedOption = cityTierSelect.options[cityTierSelect.selectedIndex];
      const floor7th = parseFloat(selectedOption.getAttribute('data-floor')) || 5400;
      const floor8th = parseFloat(selectedOption.getAttribute('data-f8th')) || 15444;
      const activeFloor = fitment > 1.0 ? floor8th : floor7th;

      // Arithmetic Engine
      const computedBasic = Math.round(basic * fitment);
      const rawHra = Math.round(computedBasic * rate);
      const protectedHra = Math.max(rawHra, activeFloor);
      const finalDisbursedHra = isGovt ? 0 : protectedHra;

      // Update KPI Cards
      dispBasic.textContent = '₹' + computedBasic.toLocaleString('en-IN');
      dispFloor.textContent = '₹' + activeFloor.toLocaleString('en-IN');
      dispHra.textContent = '₹' + finalDisbursedHra.toLocaleString('en-IN');
      if (stickyHra) stickyHra.textContent = '₹' + finalDisbursedHra.toLocaleString('en-IN');

      // Update Breakdown Table
      slipComputedBasic.textContent = '₹' + computedBasic.toLocaleString('en-IN');
      slipRate.textContent = `${Math.round(rate * 100)}% (${selectedOption.text.split(' (')[0]})`;
      slipRawHra.textContent = '₹' + rawHra.toLocaleString('en-IN');
      slipFloorVal.textContent = '₹' + activeFloor.toLocaleString('en-IN');
      slipDeduction.textContent = isGovt ? '-100% (Quarters Allotted)' : '₹0 (Admissible)';
      slipFinalHra.textContent = '₹' + finalDisbursedHra.toLocaleString('en-IN');

      // Update Subtitle Label
      slipCityLabel.textContent = `${selectedOption.text.split(' (')[0]} • ${Math.round(rate * 100)}% Rate`;
    }

    // Input Listeners
    cityTierSelect.addEventListener('change', calculateCityHRA);
    basicPayInput.addEventListener('input', calculateCityHRA);
    fitmentMultiplier.addEventListener('change', calculateCityHRA);
    accommodationStatus.addEventListener('change', calculateCityHRA);

    // Preset Chip Buttons
    const pills = document.querySelectorAll('#tierPills .chip-btn');
    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        pills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        cityTierSelect.value = pill.getAttribute('data-tier');
        calculateCityHRA();
      });
    });

    // FAQ Accordion Toggle
    document.querySelectorAll('.faq-quest').forEach(q => {
      q.addEventListener('click', () => {
        q.parentElement.classList.toggle('open');
      });
    });

    // Initial Execution
    calculateCityHRA();
  </script>

</body>
