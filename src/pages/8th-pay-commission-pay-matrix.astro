  { level: "Level 6", gp: "GP 4200", pb: "PB-2 (9300-34800)", roles: "Sub-Inspector (SI), Inspector, Primary Teacher, Junior Engineer", min7th: 35400, max7th: 112400, min8th_225: 79650, max8th_225: 252900, min8th_286: 101244, max8th_286: 321464, cells: 40 },
  { level: "Level 7", gp: "GP 4600", pb: "PB-2 (9300-34800)", roles: "Assistant Section Officer (ASO), Section Engineer, Inspector", min7th: 44900, max7th: 142400, min8th_225: 101025, max8th_225: 320400, min8th_286: 128414, max8th_286: 407264, cells: 40 },
  { level: "Level 8", gp: "GP 4800", pb: "PB-2 (9300-34800)", roles: "Assistant Accounts Officer (AAO), Section Officer (SO)", min7th: 47600, max7th: 151100, min8th_225: 107100, max8th_225: 339975, min8th_286: 136136, max8th_286: 432146, cells: 40 },
  { level: "Level 9", gp: "GP 5400 (PB-2)", pb: "PB-2 (9300-34800)", roles: "Senior Section Officer, Senior Accounts Officer", min7th: 53100, max7th: 167800, min8th_225: 119475, max8th_225: 377550, min8th_286: 151866, max8th_286: 479908, cells: 40 },
  { level: "Level 10", gp: "GP 5400 (PB-3)", pb: "PB-3 (15600-39100)", roles: "Group-A Entry, SDM, DSP, Assistant Commissioner, Capt/Lt", min7th: 56100, max7th: 177500, min8th_225: 126225, max8th_225: 399375, min8th_286: 160446, max8th_286: 507650, cells: 40 },
  { level: "Level 11", gp: "GP 6600", pb: "PB-3 (15600-39100)", roles: "Under Secretary, Executive Engineer, Major", min7th: 67700, max7th: 208700, min8th_225: 152325, max8th_225: 469575, min8th_286: 193622, max8th_286: 596882, cells: 39 },
  { level: "Level 12", gp: "GP 7600", pb: "PB-3 (15600-39100)", roles: "Deputy Secretary, Superintending Engineer, Lt Colonel", min7th: 78800, max7th: 209200, min8th_225: 177300, max8th_225: 470700, min8th_286: 225368, max8th_286: 598312, cells: 34 },
  { level: "Level 13", gp: "GP 8700", pb: "PB-4 (37400-67000)", roles: "Director, Chief Engineer, Colonel", min7th: 123100, max7th: 215900, min8th_225: 276975, max8th_225: 485775, min8th_286: 352066, max8th_286: 617474, cells: 20 },
  { level: "Level 13A", gp: "GP 8900", pb: "PB-4 (37400-67000)", roles: "Senior Director, DIG, Chief Engineer Non-Functional", min7th: 139600, max7th: 217600, min8th_225: 314100, max8th_225: 489600, min8th_286: 399256, max8th_286: 622336, cells: 18 },
