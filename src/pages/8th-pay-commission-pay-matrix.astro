---
// src/pages/pay-matrix.astro
const siteUrl = "https://8paycommission.com";
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const pageTitle = "8th Pay Commission Pay Matrix Table: Levels 1 to 18 Comparative Grid & Stages";
const pageDescription = "Explore the complete 8th Pay Commission Pay Matrix table across Levels 1 to 18. Comparative analysis of 7th vs 8th CPC starting basic pay, 3% annual increments, and career stages.";

// Complete Level 1 to 18 Comprehensive Pay Matrix Data
const fullMatrixData = [
  { level: "Level 1", gp: "GP 1800", pb: "PB-1 (5200-20200)", roles: "MTS, Peon, Group D, Track Maintainer", min7th: 18000, max7th: 56900, min8th_225: 40500, max8th_225: 128025, min8th_286: 51480, max8th_286: 162734, cells: 40 },
  { level: "Level 2", gp: "GP 1900", pb: "PB-1 (5200-20200)", roles: "Lower Division Clerk (LDC), Junior Constable", min7th: 19900, max7th: 63200, min8th_225: 44775, max8th_225: 142200, min8th_286: 56914, max8th_286: 180752, cells: 40 },
