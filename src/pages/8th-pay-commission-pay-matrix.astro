---
// src/pages/pay-matrix.astro
const siteUrl = "https://8paycommission.com";
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const pageTitle = "8th Pay Commission Pay Matrix Table: Levels 1-18 Stages, Increments & Fitment";
const pageDescription = "Explore the complete 8th Central Pay Commission Pay Matrix. Analyze Level 1 to 18 cell progressions, annual 3% compounding increments, promotion jump rules, and career stage benchmarks.";

// Comprehensive Pay Matrix Data with Structural Benchmarks
const matrixData = [
  { level: "Level 1", gp: "GP 1800", group: "Group C (MTS / Operational)", entry7th: 18000, ceil7th: 56900, entry225: 40500, ceil225: 128025, entry286: 51480, ceil286: 162734, steps: 40 },
  { level: "Level 2", gp: "GP 1900", group: "Group C (LDC / Clerical)", entry7th: 19900, ceil7th: 63200, entry225: 44775, ceil225: 142200, entry286: 56914, ceil286: 180752, steps: 40 },
  { level: "Level 3", gp: "GP 2000", group: "Group C (Constable / Driver)", entry7th: 21700, ceil7th: 69100, entry225: 48825, ceil225: 155475, entry286: 62062, ceil286: 197626, steps: 40 },
  { level: "Level 4", gp: "GP 2400", group: "Group C (UDC / Technical Assistant)", entry7th: 25500, ceil7th: 81100, entry225: 57375, ceil225: 182475, entry286: 72930, ceil286: 231946, steps: 40 },
  { level: "Level 5", gp: "GP 2800", group: "Group C (Auditor / Accountant)", entry7th: 29200, ceil7th: 92300, entry225: 65700, ceil225: 207675, entry286: 83512, ceil286: 263978, steps: 40 },
  { level: "Level 6", gp: "GP 4200", group: "Group B Non-Gazetted (SI / Inspector)", entry7th: 35400, ceil7th: 112400, entry225: 79650, ceil225: 252900, entry286: 101244, ceil286: 321464, steps: 40 },
  { level: "Level 7", gp: "GP 4600", group: "Group B Non-Gazetted (ASO / Section Eng)", entry7th: 44900, ceil7th: 142400, entry225: 101025, ceil225: 320400, entry286: 128414, ceil286: 407264, steps: 40 },
  { level: "Level 8", gp: "GP 4800", group: "Group B Gazetted (AAO / Section Officer)", entry7th: 47600, ceil7th: 151100, entry225: 107100, ceil225: 339975, entry286: 136136, ceil286: 432146, steps: 40 },
  { level: "Level 9", gp: "GP 5400", group: "Group B Gazetted (Senior Accounts Officer)", entry7th: 53100, ceil7th: 167800, entry225: 119475, ceil225: 377550, entry286: 151866, ceil286: 479908, steps: 40 },
  { level: "Level 10", gp: "GP 5400", group: "Group A (Direct Recruit SDM / DSP / Assistant Comm)", entry7th: 56100, ceil7th: 177500, entry225: 126225, ceil225: 399375, entry286: 160446, ceil286: 507650, steps: 40 },
  { level: "Level 11", gp: "GP 6600", group: "Group A (Under Secretary / Executive Eng)", entry7th: 67700, ceil7th: 208700, entry225: 152325, ceil225: 469575, entry286: 193622, ceil286: 596882, steps: 39 },
  { level: "Level 12", gp: "GP 7600", group: "Group A (Deputy Secretary / Joint Director)", entry7th: 78800, ceil7th: 209200, entry225: 177300, ceil225: 470700, entry286: 225368, ceil286: 598312, steps: 34 },
  { level: "Level 13", gp: "GP 8700", group: "Group A (Director / Chief Engineer)", entry7th: 123100, ceil7th: 215900, entry225: 276975, ceil225: 485775, entry286: 352066, ceil286: 617474, steps: 20 },
  { level: "Level 13A", gp: "GP 8900", group: "Group A (Senior Director / DIG Selection)", entry7th: 139600, ceil7th: 217600, entry225: 314100, ceil225: 489600, entry286: 399256, ceil286: 622336, steps: 18 },
  { level: "Level 14", gp: "GP 10000", group: "Group A (Joint Secretary / IG Police)", entry7th: 144200, ceil7th: 218200, entry225: 324450, ceil225: 490950, entry286: 412412, ceil286: 624052, steps: 16 },
  { level: "Level 15", gp: "HAG", group: "Senior Leadership (Principal Sec / ADG)", entry7th: 182200, ceil7th: 224100, entry225: 409950, ceil225: 504225, entry286: 521092, ceil286: 640926, steps: 9 },
  { level: "Level 16", gp: "HAG+", group: "Executive Directorship (Special Sec / DG Police)", entry7th: 205400, ceil7th: 224400, entry225: 462150, ceil225: 504900, entry286: 587444, ceil286: 641784, steps: 5 },
  { level: "Level 17", gp: "Apex Scale", group: "Departmental Secretary to Govt of India", entry7th: 225000, ceil7th: 225000, entry225: 506250, ceil225: 506250, entry286: 643500, ceil286: 643500, steps: 1 },
  { level: "Level 18", gp: "Cabinet Sec", group: "Cabinet Secretary of India", entry7th: 250000, ceil7th: 250000, entry225: 562500, ceil225: 562500, entry286: 715000, ceil286: 715000, steps: 1 }
];

const faqs = [
  {
    q: "How does the Pay Matrix prevent pay anomalies between seniors and juniors?",
    a: "Under older running pay bands, junior recruits joining after a dearness allowance hike often drew comparable basic salaries to seniors who had served for years. The Pay Matrix eliminates this through distinct index stages. When a senior's basic salary is eclipsed or matched by a newly appointed or promoted junior within the same cadre, administrative 'stepping-up of pay' rules adjust the senior's basic pay upward to preserve seniority hierarchy."
  },
  {
    q: "What is 'bunching of stages' and how will it be addressed in the 8th Pay Matrix?",
    a: "Bunching occurs when consecutive salary stages from an older scale are compressed into a single identical cell in a new matrix. To prevent loss of earned seniority, pay revision rules mandate that whenever two or more consecutive stages in an older scale fall into the same cell of the revised scale, an additional increment (3% step) is added for every two completed stages to maintain clear seniority separation."
  },
  {
    q: "How does horizontal cell progression operate during an MACP financial upgradation?",
    a: "Under the Modified Assured Career Progression (MACP) scheme, an employee who completes 10, 20, or 30 years without functional promotion is upgraded to the immediate next vertical Pay Level. Their salary is computed by adding one annual increment in their existing level, and then fitting that resulting figure into the cell that equals or immediately exceeds it in the higher Pay Level."
  },
  {
    q: "Why do senior bureaucratic levels (15 to 18) contain fewer index cells?",
    a: "Levels 1 to 12 contain between 34 and 40 cells to accommodate careers spanning 30 to 40 years without stagnation. In contrast, Higher Administrative Grade (HAG) and Apex posts (Levels 15 to 18) are typically reached near the twilight of an official's career. As officers serve limited tenures (usually 1 to 5 years) before superannuation, fewer annual increment stages are mathematically required."
  }
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <meta name="keywords" content="8th pay commission pay matrix table, 7th cpc vs 8th cpc salary grid, level 1 to 18 basic pay cells, macp promotion pay adjustment, annual increment 3 percent compounding, stepping up of pay rules" />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:locale" content="en_IN" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="8th Pay Commission Portal" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebPage",
        "name": pageTitle,
        "url": canonicalURL.toString(),
        "description": pageDescription,
        "inLanguage": "en-IN"
      },
      {
        "@type": "FAQPage",
        "mainEntity": faqs.map((f) => ({
          "@type": "Question",
          "name": f.q,
          "acceptedAnswer": { "@type": "Answer", "text": f.a }
        }))
      }
    ]
  })} />

  <style>
    :root {
      --bg: #f8fafc;
      --surface: #ffffff;
      --surface-subtle: #f1f5f9;
      --border: #e2e8f0;
      --primary: #1d4ed8;
      --primary-hover: #1e40af;
      --primary-gradient: linear-gradient(135deg, #1d4ed8 0%, #0284c7 100%);
      --text: #0f172a;
      --text-muted: #64748b;
      --accent-green: #15803d;
      --accent-green-bg: #dcfce7;
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.05);
      --shadow-md: 0 4px 12px -2px rgba(15, 23, 42, 0.08);
      --shadow-lg: 0 16px 32px -4px rgba(15, 23, 42, 0.08);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; }
    body { background: var(--bg); color: var(--text); line-height: 1.7; font-size: 15px; -webkit-font-smoothing: antialiased; }
    a { color: var(--primary); text-decoration: none; transition: color 0.2s ease; }
    a:hover { color: var(--primary-hover); }

    .layout-wrap { max-width: 1160px; margin: 0 auto; padding: 0 1.25rem; }

    /* Hero */
    .hero-header {
      text-align: center;
      padding: 3rem 1rem 1.75rem;
    }
    .badge-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: #eff6ff;
      border: 1px solid #bfdbfe;
      color: #1d4ed8;
      padding: 0.25rem 0.85rem;
      border-radius: 30px;
      font-size: 0.78rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.85rem;
    }
    .hero-header h1 {
      font-size: clamp(1.85rem, 4vw, 2.75rem);
      font-weight: 800;
      letter-spacing: -0.035em;
      line-height: 1.22;
      margin-bottom: 0.75rem;
      color: var(--text);
    }
    .hero-header p {
      color: var(--text-muted);
      max-width: 780px;
      margin: 0 auto;
      font-size: 1.05rem;
    }

    /* Interactive Matrix Simulator Widget */
    .calc-box {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 2rem;
      box-shadow: var(--shadow-lg);
      margin-bottom: 3.5rem;
    }
    .chip-bar {
      display: flex;
      gap: 0.5rem;
      overflow-x: auto;
      padding: 0.5rem 0 1.25rem;
      scrollbar-width: none;
    }
    .chip-bar::-webkit-scrollbar { display: none; }
    .chip-btn {
      background: #f1f5f9;
      border: 1px solid var(--border);
      color: #475569;
      padding: 0.5rem 1.1rem;
      border-radius: 30px;
      font-size: 0.84rem;
      font-weight: 700;
      white-space: nowrap;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .chip-btn:hover { background: #e2e8f0; }
    .chip-btn.active {
      background: var(--primary);
      border-color: var(--primary);
      color: #ffffff;
      box-shadow: 0 2px 8px rgba(29, 78, 216, 0.3);
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1.25rem;
      margin-bottom: 1.5rem;
    }
    .form-item {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
    .form-item label {
      font-size: 0.82rem;
      font-weight: 700;
      color: #334155;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }
    .form-item input, .form-item select {
      background: #ffffff;
      border: 1.5px solid #cbd5e1;
      color: var(--text);
      padding: 0.75rem 0.9rem;
      border-radius: var(--radius-sm);
      font-size: 0.96rem;
      font-weight: 600;
      outline: none;
      transition: all 0.2s;
    }
    .form-item input:focus, .form-item select:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
    }

    /* Live Summary Cards */
    .summary-cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      margin-bottom: 1.5rem;
    }
    .kpi-unit {
      background: #f8fafc;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 1.25rem;
      text-align: center;
      position: relative;
    }
    .kpi-unit.highlight {
      background: #eff6ff;
      border-color: #bfdbfe;
    }
    .kpi-unit.success {
      background: var(--accent-green-bg);
      border-color: #86efac;
    }
    .kpi-unit .kpi-label {
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
      margin-bottom: 0.35rem;
    }
    .kpi-unit .kpi-val {
      font-size: 1.45rem;
      font-weight: 800;
      color: var(--text);
    }
    .kpi-unit.highlight .kpi-val { color: var(--primary); }
    .kpi-unit.success .kpi-val { color: var(--accent-green); }

    /* Breakdown Box */
    .breakdown-box {
      background: #f8fafc;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 1.5rem;
      margin-top: 1.5rem;
    }
    .breakdown-title {
      font-weight: 800;
      font-size: 1rem;
      color: var(--text);
      margin-bottom: 0.85rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .breakdown-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.94rem;
    }
    .breakdown-table td {
      padding: 0.65rem 0.5rem;
      border-bottom: 1px dashed #cbd5e1;
    }
    .breakdown-table tr:last-child td { border-bottom: none; }
    .breakdown-table td.num {
      text-align: right;
      font-weight: 700;
    }

    /* Content Area */
    .article-wrap {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 2.75rem;
      box-shadow: var(--shadow-sm);
      margin-bottom: 3.5rem;
    }
    .article-wrap h2 {
      font-size: 1.6rem;
      font-weight: 800;
      color: var(--text);
      letter-spacing: -0.025em;
      margin: 2.5rem 0 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 2px solid #eff6ff;
    }
    .article-wrap h3 {
      font-size: 1.25rem;
      font-weight: 700;
      color: #1e293b;
      margin: 1.6rem 0 0.65rem;
    }
    .article-wrap p {
      margin-bottom: 1.25rem;
      color: #334155;
      font-size: 1.02rem;
    }
    .article-wrap ul, .article-wrap ol {
      margin-bottom: 1.5rem;
      padding-left: 1.5rem;
      color: #334155;
    }
    .article-wrap li { margin-bottom: 0.45rem; }

    .formula-banner {
      background: #eff6ff;
      border-left: 4px solid var(--primary);
      padding: 1.15rem 1.35rem;
      border-radius: 0 8px 8px 0;
      margin: 1.5rem 0;
      font-family: monospace;
      font-size: 0.96rem;
      color: #1e40af;
    }

    /* Table */
    .table-responsive {
      overflow-x: auto;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      margin: 1.5rem 0;
    }
    table.data-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 0.91rem;
    }
    table.data-table th, table.data-table td {
      padding: 0.8rem 0.95rem;
      border-bottom: 1px solid var(--border);
    }
    table.data-table th {
      background: #f8fafc;
      color: #475569;
      font-weight: 700;
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      white-space: nowrap;
    }
    table.data-table tr:hover td { background: #f8fafc; }

    /* Level Badges Grid */
    .level-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
      gap: 0.65rem;
      margin: 1.25rem 0;
    }
    .level-pill {
      background: #ffffff;
      border: 1px solid var(--border);
      padding: 0.75rem 0.5rem;
      border-radius: var(--radius-sm);
      text-align: center;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .level-pill:hover {
      border-color: var(--primary);
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
      background: #eff6ff;
    }
    .level-pill strong { display: block; font-size: 0.95rem; color: var(--text); }
    .level-pill span { font-size: 0.78rem; color: var(--text-muted); }

    /* FAQ */
    .faq-unit {
      border-bottom: 1px solid var(--border);
      padding: 1.15rem 0;
    }
    .faq-quest {
      font-weight: 700;
      color: var(--text);
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 1.02rem;
    }
    .faq-ans {
      display: none;
      padding-top: 0.65rem;
      color: #475569;
      font-size: 0.96rem;
      line-height: 1.7;
    }
    .faq-unit.open .faq-ans { display: block; }
    .faq-unit.open .faq-arrow { transform: rotate(180deg); }
    .faq-arrow { transition: transform 0.2s ease; font-size: 0.75rem; color: var(--text-muted); }

    /* Mobile Sticky Bar */
    .mobile-sticky-bar {
      display: none;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: rgba(255, 255, 255, 0.96);
      border-top: 1px solid var(--border);
      backdrop-filter: blur(12px);
      padding: 0.75rem 1.25rem;
      z-index: 990;
      justify-content: space-between;
      align-items: center;
      box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.06);
    }
    .mobile-sticky-bar .lbl { font-size: 0.74rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700; }
    .mobile-sticky-bar .val { font-size: 1.2rem; font-weight: 800; color: var(--primary); }
    @media (max-width: 768px) {
      .mobile-sticky-bar { display: flex; }
      body { padding-bottom: 4.5rem; }
    }

    /* Disclaimer */
    .disclaimer-strip {
      max-width: 1160px;
      margin: 2rem auto 4rem;
      padding: 1.25rem;
      background: #f8fafc;
      border: 1px solid var(--border);
      border-left: 4px solid #94a3b8;
      border-radius: var(--radius-sm);
      font-size: 0.82rem;
      line-height: 1.6;
      color: #64748b;
    }
  </style>
</head>
<body>

  <main class="layout-wrap">

    <!-- HERO HEADER -->
    <header class="hero-header">
      <div class="badge-pill">Public Remuneration & Cadre Matrix Analysis</div>
      <h1>8th Pay Commission Pay Matrix Table</h1>
      <p>Analyze cell-by-cell progression schedules, annual 3% compounding increments, horizontal promotion jumps, and comparative Level 1-18 starting baselines under projected fitment multipliers.</p>
    </header>

    <!-- INTERACTIVE MATRIX SIMULATOR WIDGET -->
    <section class="calc-box" aria-label="8th Pay Commission Matrix Stage Simulator">
      
      <!-- Multiplier Pills -->
      <div style="margin-bottom: 1.25rem;">
        <span style="font-size: 0.8rem; font-weight: 700; color: #64748b; text-transform: uppercase;">Expected Fitment Multiplier:</span>
        <div class="chip-bar" id="factorPills">
          <button class="chip-btn" data-f="1.92">1.92x (Conservative DA Merge)</button>
          <button class="chip-btn" data-f="2.25">2.25x (Baseline Model)</button>
          <button class="chip-btn" data-f="2.57">2.57x (7th CPC Parity)</button>
          <button class="chip-btn active" data-f="2.86">2.86x (Federation Target)</button>
        </div>
      </div>

      <!-- Controls Grid -->
      <div class="form-grid">
        <div class="form-item">
          <label for="matrixLevelSelect">Current Pay Matrix Level</label>
          <select id="matrixLevelSelect">
            {matrixData.map((row) => (
              <option value={row.entry7th} data-level={row.level} data-gp={row.gp} selected={row.level === "Level 6"}>
                {row.level} ({row.gp}) - Min 7th: ₹{row.entry7th.toLocaleString('en-IN')}
              </option>
            ))}
          </select>
        </div>

        <div class="form-item">
          <label for="matrixStageInput">Completed Service Years (Cell Index)</label>
          <select id="matrixStageInput">
            <option value="1">Cell 1 (Fresh Entry Starting Pay)</option>
            <option value="2">Cell 2 (1 Increment / 1 Year Service)</option>
            <option value="3">Cell 3 (2 Increments / 2 Years Service)</option>
            <option value="5" selected>Cell 5 (4 Increments / 4 Years Service)</option>
            <option value="10">Cell 10 (9 Increments / Mid-Career)</option>
            <option value="15">Cell 15 (14 Increments / Senior Stage)</option>
            <option value="20">Cell 20 (19 Increments / Advanced Stage)</option>
            <option value="25">Cell 25 (24 Increments / Pre-Retirement)</option>
            <option value="30">Cell 30 (29 Increments / Terminal Stage)</option>
          </select>
        </div>

        <div class="form-item">
          <label for="fitmentSelect">Fitment Multiplier</label>
          <select id="fitmentSelect">
            <option value="1.92">1.92x (Conservative Baseline)</option>
            <option value="2.10">2.10x (Moderate Growth)</option>
            <option value="2.25">2.25x (Consensus Model)</option>
            <option value="2.57">2.57x (7th CPC Equivalent)</option>
            <option value="2.86" selected>2.86x (Federation Benchmark)</option>
            <option value="3.00">3.00x (High Wage Benchmark)</option>
          </select>
        </div>

        <div class="form-item">
          <label for="citySelect">City Tier (HRA Allowance)</label>
          <select id="citySelect">
            <option value="0.30" selected>Class X (30% - Metro Cities)</option>
            <option value="0.20">Class Y (20% - Tier-2 Centers)</option>
            <option value="0.10">Class Z (10% - Small Towns/Rural)</option>
          </select>
        </div>
      </div>

      <!-- KPI Summaries -->
      <div class="summary-cards">
        <div class="kpi-unit">
          <div class="kpi-label">7th CPC Stage Basic</div>
          <div class="kpi-val" id="disp7thStage">₹39,900</div>
        </div>
        <div class="kpi-unit highlight">
          <div class="kpi-label">Projected 8th CPC Stage Basic</div>
          <div class="kpi-val" id="disp8thStage">₹1,14,114</div>
        </div>
        <div class="kpi-unit success">
          <div class="kpi-label">Est. Gross Monthly at Stage</div>
          <div class="kpi-val" id="dispStageGross">₹1,51,948</div>
        </div>
      </div>

      <!-- Live Calculation Breakdown -->
      <div class="breakdown-box">
        <div class="breakdown-title">
          <span>Cell Progression Arithmetic Slip</span>
          <span style="color: var(--primary); font-size: 0.85rem;" id="slipLevelLabel">Level 6 (GP 4200) • Cell 5</span>
        </div>
        <table class="breakdown-table">
          <tbody>
            <tr>
