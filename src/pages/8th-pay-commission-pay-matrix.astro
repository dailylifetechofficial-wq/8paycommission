  { level: "Level 15", gp: "HAG", pb: "HAG Scale", roles: "Principal Secretary, Additional Director General, Major General", min7th: 182200, max7th: 224100, min8th_225: 409950, max8th_225: 504225, min8th_286: 521092, max8th_286: 640926, cells: 9 },
  { level: "Level 16", gp: "HAG+", pb: "HAG+ Scale", roles: "Special Secretary, Director General of Police (DG), Lt General", min7th: 205400, max7th: 224400, min8th_225: 462150, max8th_225: 504900, min8th_286: 587444, max8th_286: 641784, cells: 5 },
  { level: "Level 17", gp: "Apex Scale", pb: "Apex Scale", roles: "Secretary to Government of India, Vice Chief of Army Staff", min7th: 225000, max7th: 225000, min8th_225: 506250, max8th_225: 506250, min8th_286: 643500, max8th_286: 643500, cells: 1 },
  { level: "Level 18", gp: "Cabinet Sec", pb: "Cabinet Sec Scale", roles: "Cabinet Secretary of India, Chief of Army/Navy/Air Staff", min7th: 250000, max7th: 250000, min8th_225: 562500, max8th_225: 562500, min8th_286: 715000, max8th_286: 715000, cells: 1 }
];

const faqs = [
  {
    q: "What is the 8th Pay Commission Pay Matrix?",
    a: "The 8th Pay Commission Pay Matrix is a comprehensive two-dimensional grid that defines the compensation structure for Indian Central Government employees. It arranges posts vertically into 18 hierarchy levels and horizontally into progressive index cells that represent 3% annual compound increments across an employee's service career."
  },
  {
    q: "How does an employee progress through the Pay Matrix cells?",
    a: "Employees advance in two ways: Vertically through annual performance increments (moving down one cell within the same level, worth ~3%), and Horizontally upon promotion or financial upgradation under MACP (moving to the next higher Pay Level, where pay is fitted at the nearest matching higher cell)."
  },
  {
    q: "Why was the Grade Pay system replaced by the Pay Matrix?",
    a: "The 7th CPC abolished the running Pay Band and Grade Pay framework introduced in the 6th CPC because it created severe wage compression, promotion pay anomalies, and confusion regarding allowances. The 18-level matrix provides complete transparency, uniform progression steps, and predictability."
  },
  {
    q: "What is the anticipated minimum entry salary in Level 1 under the 8th CPC?",
    a: "Level 1 starting basic pay is ₹18,000 under the 7th CPC. Under the projected 8th CPC fitment factors, minimum basic pay will adjust to ₹40,500 at a 2.25x baseline multiplier, ₹46,260 at a 2.57x parity multiplier, and ₹51,480 at a 2.86x staff federation target multiplier."
  },
  {
    q: "What is the maximum salary ceiling under Level 18 of the Pay Matrix?",
    a: "Level 18 represents the apex executive post: the Cabinet Secretary of India. Its basic salary is capped at ₹2,50,000 under the 7th CPC. Under the 8th CPC, this apex figure is projected to adjust between ₹5,62,500 (at 2.25x) and ₹7,15,000 (at 2.86x)."
  }
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <meta name="keywords" content="8th pay commission pay matrix, pay matrix level 1 to 18, 7th vs 8th cpc pay matrix table, macp promotion pay matrix, central government salary index cells, annual increment formula" />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:locale" content="en_IN" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="8th Pay Commission Hub" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Schema.org WebPage + Table + FAQPage -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebPage",
        "name": pageTitle,
        "url": canonicalURL.toString(),
        "description": pageDescription,
        "inLanguage": "en-IN"
      },
      {
        "@type": "FAQPage",
        "mainEntity": faqs.map((f) => ({
          "@type": "Question",
          "name": f.q,
          "acceptedAnswer": { "@type": "Answer", "text": f.a }
        }))
      }
    ]
  })} />

  <style>
    :root {
      --bg: #f8fafc;
      --surface: #ffffff;
      --surface-subtle: #f1f5f9;
      --border: #e2e8f0;
      --border-focus: #2563eb;
      --primary: #1d4ed8;
      --primary-hover: #1e40af;
      --primary-gradient: linear-gradient(135deg, #1d4ed8 0%, #0284c7 100%);
      --text: #0f172a;
      --text-muted: #64748b;
      --accent-green: #15803d;
      --accent-green-bg: #dcfce7;
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.05);
      --shadow-md: 0 4px 12px -2px rgba(15, 23, 42, 0.08);
      --shadow-lg: 0 16px 32px -4px rgba(15, 23, 42, 0.08);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; }
    body { background: var(--bg); color: var(--text); line-height: 1.7; font-size: 15px; -webkit-font-smoothing: antialiased; }
    a { color: var(--primary); text-decoration: none; transition: color 0.2s ease; }
    a:hover { color: var(--primary-hover); }

    .layout-wrap { max-width: 1160px; margin: 0 auto; padding: 0 1.25rem; }

    /* Hero Header */
    .hero-header {
      text-align: center;
      padding: 3rem 1rem 1.75rem;
    }
    .badge-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: #eff6ff;
      border: 1px solid #bfdbfe;
      color: #1d4ed8;
      padding: 0.25rem 0.85rem;
      border-radius: 30px;
      font-size: 0.78rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.85rem;
    }
    .hero-header h1 {
      font-size: clamp(1.85rem, 4vw, 2.75rem);
      font-weight: 800;
      letter-spacing: -0.035em;
      line-height: 1.22;
      margin-bottom: 0.75rem;
      color: var(--text);
    }
    .hero-header p {
      color: var(--text-muted);
      max-width: 780px;
      margin: 0 auto;
      font-size: 1.05rem;
    }

    /* Interactive Matrix Explorer Widget */
    .calc-box {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 2rem;
      box-shadow: var(--shadow-lg);
      margin-bottom: 3.5rem;
    }
    .chip-bar {
      display: flex;
      gap: 0.5rem;
      overflow-x: auto;
      padding: 0.5rem 0 1.25rem;
      scrollbar-width: none;
    }
    .chip-bar::-webkit-scrollbar { display: none; }
    .chip-btn {
      background: #f1f5f9;
      border: 1px solid var(--border);
      color: #475569;
      padding: 0.5rem 1.1rem;
      border-radius: 30px;
      font-size: 0.84rem;
      font-weight: 700;
      white-space: nowrap;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .chip-btn:hover { background: #e2e8f0; }
    .chip-btn.active {
      background: var(--primary);
      border-color: var(--primary);
      color: #ffffff;
      box-shadow: 0 2px 8px rgba(29, 78, 216, 0.3);
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 1.25rem;
      margin-bottom: 1.5rem;
    }
    .form-item {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
    .form-item label {
      font-size: 0.82rem;
      font-weight: 700;
      color: #334155;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }
    .form-item input, .form-item select {
      background: #ffffff;
      border: 1.5px solid #cbd5e1;
      color: var(--text);
      padding: 0.75rem 0.9rem;
      border-radius: var(--radius-sm);
      font-size: 0.96rem;
      font-weight: 600;
      outline: none;
      transition: all 0.2s;
    }
    .form-item input:focus, .form-item select:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
    }

    /* Live Summary Cards */
    .summary-cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      margin-bottom: 1.5rem;
    }
    .kpi-unit {
      background: #f8fafc;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 1.25rem;
      text-align: center;
      position: relative;
    }
    .kpi-unit.highlight {
      background: #eff6ff;
      border-color: #bfdbfe;
    }
    .kpi-unit.success {
      background: var(--accent-green-bg);
      border-color: #86efac;
    }
    .kpi-unit .kpi-label {
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
      margin-bottom: 0.35rem;
    }
    .kpi-unit .kpi-val {
      font-size: 1.45rem;
      font-weight: 800;
      color: var(--text);
    }
    .kpi-unit.highlight .kpi-val { color: var(--primary); }
    .kpi-unit.success .kpi-val { color: var(--accent-green); }

    /* Breakdown Box */
    .breakdown-box {
      background: #f8fafc;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 1.5rem;
      margin-top: 1.5rem;
    }
    .breakdown-title {
      font-weight: 800;
      font-size: 1rem;
      color: var(--text);
      margin-bottom: 0.85rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .breakdown-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.94rem;
    }
    .breakdown-table td {
      padding: 0.65rem 0.5rem;
      border-bottom: 1px dashed #cbd5e1;
    }
    .breakdown-table tr:last-child td { border-bottom: none; }
    .breakdown-table td.num {
      text-align: right;
      font-weight: 700;
    }

    /* Content Area */
    .article-wrap {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 2.75rem;
      box-shadow: var(--shadow-sm);
      margin-bottom: 3.5rem;
    }
    .article-wrap h2 {
      font-size: 1.6rem;
      font-weight: 800;
      color: var(--text);
      letter-spacing: -0.025em;
      margin: 2.5rem 0 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 2px solid #eff6ff;
    }
    .article-wrap h3 {
      font-size: 1.25rem;
      font-weight: 700;
      color: #1e293b;
      margin: 1.6rem 0 0.65rem;
    }
    .article-wrap p {
      margin-bottom: 1.25rem;
      color: #334155;
      font-size: 1.02rem;
    }
    .article-wrap ul, .article-wrap ol {
      margin-bottom: 1.5rem;
      padding-left: 1.5rem;
      color: #334155;
    }
    .article-wrap li { margin-bottom: 0.45rem; }

    .formula-banner {
      background: #eff6ff;
      border-left: 4px solid var(--primary);
      padding: 1.15rem 1.35rem;
      border-radius: 0 8px 8px 0;
      margin: 1.5rem 0;
      font-family: monospace;
      font-size: 0.96rem;
      color: #1e40af;
    }

    /* Tables */
    .table-responsive {
      overflow-x: auto;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      margin: 1.5rem 0;
    }
    table.data-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 0.91rem;
    }
    table.data-table th, table.data-table td {
      padding: 0.8rem 0.95rem;
      border-bottom: 1px solid var(--border);
    }
    table.data-table th {
      background: #f8fafc;
      color: #475569;
      font-weight: 700;
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      white-space: nowrap;
    }
    table.data-table tr:hover td { background: #f8fafc; }

    /* Level Badges Grid */
    .level-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
      gap: 0.65rem;
      margin: 1.25rem 0;
    }
    .level-pill {
      background: #ffffff;
      border: 1px solid var(--border);
      padding: 0.75rem 0.5rem;
      border-radius: var(--radius-sm);
      text-align: center;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .level-pill:hover {
      border-color: var(--primary);
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
      background: #eff6ff;
    }
    .level-pill strong { display: block; font-size: 0.95rem; color: var(--text); }
    .level-pill span { font-size: 0.78rem; color: var(--text-muted); }

    /* FAQ */
    .faq-unit {
      border-bottom: 1px solid var(--border);
      padding: 1.15rem 0;
    }
    .faq-quest {
      font-weight: 700;
      color: var(--text);
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 1.02rem;
    }
    .faq-ans {
      display: none;
      padding-top: 0.65rem;
      color: #475569;
      font-size: 0.96rem;
      line-height: 1.7;
    }
    .faq-unit.open .faq-ans { display: block; }
    .faq-unit.open .faq-arrow { transform: rotate(180deg); }
    .faq-arrow { transition: transform 0.2s ease; font-size: 0.75rem; color: var(--text-muted); }

    /* Mobile Sticky Bar */
    .mobile-sticky-bar {
      display: none;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: rgba(255, 255, 255, 0.96);
      border-top: 1px solid var(--border);
      backdrop-filter: blur(12px);
      padding: 0.75rem 1.25rem;
      z-index: 990;
      justify-content: space-between;
      align-items: center;
      box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.06);
    }
    .mobile-sticky-bar .lbl { font-size: 0.74rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700; }
    .mobile-sticky-bar .val { font-size: 1.2rem; font-weight: 800; color: var(--primary); }
    @media (max-width: 768px) {
      .mobile-sticky-bar { display: flex; }
      body { padding-bottom: 4.5rem; }
    }

    /* Disclaimer */
    .disclaimer-strip {
      max-width: 1160px;
      margin: 2rem auto 4rem;
      padding: 1.25rem;
      background: #f8fafc;
      border: 1px solid var(--border);
      border-left: 4px solid #94a3b8;
      border-radius: var(--radius-sm);
      font-size: 0.82rem;
      line-height: 1.6;
      color: #64748b;
    }
  </style>
</head>
<body>

  <main class="layout-wrap">

    <!-- HERO HEADER -->
    <header class="hero-header">
      <div class="badge-pill">Central Civil & Defence Services Grid (2026)</div>
      <h1>8th Pay Commission Pay Matrix Table</h1>
      <p>Complete comparative guide to Levels 1 to 18: starting baseline pay, 3% compound increment stages, promotional jumps, and compression ratios under expected fitment factors.</p>
    </header>

    <!-- INTERACTIVE MATRIX STAGE CALCULATOR WIDGET -->
    <section class="calc-box" aria-label="8th Pay Commission Matrix Stage Calculator">
      
      <!-- Multiplier Pills -->
      <div style="margin-bottom: 1.25rem;">
        <span style="font-size: 0.8rem; font-weight: 700; color: #64748b; text-transform: uppercase;">Expected Fitment Multiplier:</span>
        <div class="chip-bar" id="factorPills">
          <button class="chip-btn" data-f="1.92">1.92x (Conservative DA Merge)</button>
          <button class="chip-btn" data-f="2.25">2.25x (Baseline Model)</button>
          <button class="chip-btn" data-f="2.57">2.57x (7th CPC Parity)</button>
          <button class="chip-btn active" data-f="2.86">2.86x (Federation Target)</button>
        </div>
      </div>

      <!-- Controls Grid -->
      <div class="form-grid">
        <div class="form-item">
          <label for="matrixLevelSelect">Select Pay Matrix Level</label>
          <select id="matrixLevelSelect">
            {fullMatrixData.map((row) => (
              <option value={row.min7th} data-level={row.level} data-gp={row.gp} selected={row.level === "Level 6"}>
                {row.level} ({row.gp}) - Min 7th: ₹{row.min7th.toLocaleString('en-IN')}
              </option>
            ))}
          </select>
        </div>

        <div class="form-item">
          <label for="matrixStageInput">Current Service Stage (Index Cell)</label>
          <select id="matrixStageInput">
            <option value="1">Cell 1 (Entry Starting Pay)</option>
            <option value="2">Cell 2 (1 Year Completed - 1 Increment)</option>
            <option value="3">Cell 3 (2 Years Completed - 2 Increments)</option>
            <option value="5" selected>Cell 5 (4 Years Completed)</option>
            <option value="10">Cell 10 (9 Years Completed)</option>
            <option value="15">Cell 15 (14 Years Completed)</option>
            <option value="20">Cell 20 (19 Years Completed)</option>
            <option value="25">Cell 25 (24 Years Completed)</option>
            <option value="30">Cell 30 (29 Years Completed)</option>
          </select>
        </div>

        <div class="form-item">
          <label for="fitmentSelect">Fitment Multiplier</label>
          <select id="fitmentSelect">
            <option value="1.92">1.92x (Conservative Baseline)</option>
            <option value="2.10">2.10x (Moderate Growth)</option>
            <option value="2.25">2.25x (Consensus Model)</option>
            <option value="2.57">2.57x (7th CPC Equivalent)</option>
