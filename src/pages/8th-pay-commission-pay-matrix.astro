  <!-- CLIENT-SIDE COMPUTATION JAVASCRIPT -->
  <script is:inline>
    const matrixLevelSelect = document.getElementById('matrixLevelSelect');
    const matrixStageInput = document.getElementById('matrixStageInput');
    const fitmentSelect = document.getElementById('fitmentSelect');
    const citySelect = document.getElementById('citySelect');

    const disp7thStage = document.getElementById('disp7thStage');
    const disp8thStage = document.getElementById('disp8thStage');
    const dispStageGross = document.getElementById('dispStageGross');
    const stickyBasic = document.getElementById('stickyBasic');

    const slipCell1 = document.getElementById('slipCell1');
    const slipIncrementAdd = document.getElementById('slipIncrementAdd');
    const slipFinalBasic = document.getElementById('slipFinalBasic');
    const slipHra = document.getElementById('slipHra');
    const slipTa = document.getElementById('slipTa');
    const slipGross = document.getElementById('slipGross');
    const slipLevelLabel = document.getElementById('slipLevelLabel');

    function calculateMatrixStage() {
      const entry7th = parseFloat(matrixLevelSelect.value) || 18000;
      const stage = parseInt(matrixStageInput.value) || 1;
      const factor = parseFloat(fitmentSelect.value) || 2.86;
      const hraRate = parseFloat(citySelect.value) || 0.30;

      // 7th CPC Stage Calculation (3% compounding rounded to nearest 100)
      let current7thBasic = entry7th;
      for (let i = 1; i < stage; i++) {
        current7thBasic = Math.round((current7thBasic * 1.03) / 100) * 100;
      }

      // 8th CPC Entry Cell 1
      const entry8th = Math.round(entry7th * factor);

      // 8th CPC Stage Calculation (compounding from entry 8th cell)
      let stage8thBasic = entry8th;
      for (let i = 1; i < stage; i++) {
        stage8thBasic = Math.round((stage8thBasic * 1.03) / 100) * 100;
      }

      const incrementAddition = stage8thBasic - entry8th;
      const hra = Math.round(stage8thBasic * hraRate);
      const ta = entry7th >= 35400 ? 3600 : 1350;
      const gross = stage8thBasic + hra + ta;

      // Update Formats
      const fmt7thStage = '₹' + current7thBasic.toLocaleString('en-IN');
      const fmt8thStage = '₹' + stage8thBasic.toLocaleString('en-IN');
      const fmtGross = '₹' + gross.toLocaleString('en-IN');

      disp7thStage.textContent = fmt7thStage;
      disp8thStage.textContent = fmt8thStage;
      dispStageGross.textContent = fmtGross;
      if (stickyBasic) stickyBasic.textContent = fmt8thStage;

      // Breakdown Table
      slipCell1.textContent = '₹' + entry8th.toLocaleString('en-IN');
      slipIncrementAdd.textContent = '+₹' + incrementAddition.toLocaleString('en-IN');
      slipFinalBasic.textContent = fmt8thStage;
      slipHra.textContent = '₹' + hra.toLocaleString('en-IN');
      slipTa.textContent = '₹' + ta.toLocaleString('en-IN');
      slipGross.textContent = fmtGross;

      // Label Update
      const selectedOption = matrixLevelSelect.options[matrixLevelSelect.selectedIndex];
      if (selectedOption) {
        const lvlName = selectedOption.getAttribute('data-level') || 'Level 6';
        const gpName = selectedOption.getAttribute('data-gp') || 'GP 4200';
        slipLevelLabel.textContent = `${lvlName} (${gpName}) • Cell ${stage}`;
      }
    }

    // Input Listeners
    matrixLevelSelect.addEventListener('change', calculateMatrixStage);
    matrixStageInput.addEventListener('change', calculateMatrixStage);
    fitmentSelect.addEventListener('change', calculateMatrixStage);
    citySelect.addEventListener('change', calculateMatrixStage);

    // Multiplier Button Pills
    const pills = document.querySelectorAll('#factorPills .chip-btn');
    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        pills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        fitmentSelect.value = pill.getAttribute('data-f');
        calculateMatrixStage();
      });
    });

    // Quick Matrix Level Pills
    document.querySelectorAll('.level-pill').forEach(pill => {
      pill.addEventListener('click', () => {
        const val = pill.getAttribute('data-min7th');
        matrixLevelSelect.value = val;
        calculateMatrixStage();
        document.querySelector('.calc-box').scrollIntoView({ behavior: 'smooth' });
      });
    });

    // FAQ Accordion Toggle
    document.querySelectorAll('.faq-quest').forEach(q => {
      q.addEventListener('click', () => {
        q.parentElement.classList.toggle('open');
      });
    });

    // Initial Execution
    calculateMatrixStage();
  </script>

