---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = '8th Pay Commission Calculator', description = '8th Pay Commission salary and pay matrix tools.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <Navigation />
    <main class="page-content"><slot /></main>
    <Footer />
  </body>
</html>
<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { min-height: 100vh; margin: 0; display: flex; flex-direction: column; background: #f8fafc; color: #0f172a; font-family: system-ui, sans-serif; line-height: 1.6; }
  :global(a) { color: #1d4ed8; }
  .page-content { width: 100%; max-width: 1160px; flex: 1; margin: 0 auto; padding: 3rem 1.25rem; }
</style>
